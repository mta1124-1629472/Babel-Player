<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Inter (via WithInterFont) + sensible fallbacks. One sans family for the whole UI. -->
    <Styles.Resources>
        <FontFamily x:Key="UiFontFamily">Inter, system-ui, -apple-system, "Segoe UI", sans-serif</FontFamily>
        <FontFamily x:Key="UiMonoFontFamily">"Cascadia Mono", "Cascadia Code", Consolas, monospace</FontFamily>

        <x:Double x:Key="FontSizeDisplay">15</x:Double>
        <x:Double x:Key="FontSizeTitle">14</x:Double>
        <x:Double x:Key="FontSizeBody">13</x:Double>
        <x:Double x:Key="FontSizeSecondary">12</x:Double>
        <x:Double x:Key="FontSizeCaption">11</x:Double>
        <x:Double x:Key="FontSizeMicro">10</x:Double>
    </Styles.Resources>

    <!-- Default: calm body text (most copy should stay Regular). -->
    <Style Selector="Window">
        <Setter Property="FontFamily" Value="{DynamicResource UiFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}" />
    </Style>

    <Style Selector="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource UiFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}" />
        <Setter Property="FontWeight" Value="Normal" />
    </Style>

    <!-- Semantic text (prefer classes over ad-hoc FontWeight on every line). -->
    <Style Selector="TextBlock.text-display">
        <Setter Property="FontSize" Value="{DynamicResource FontSizeDisplay}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.text-title">
        <Setter Property="FontSize" Value="{DynamicResource FontSizeTitle}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.text-secondary">
        <Setter Property="FontSize" Value="{DynamicResource FontSizeSecondary}" />
        <Setter Property="FontWeight" Value="Normal" />
    </Style>
    <Style Selector="TextBlock.text-caption">
        <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}" />
        <Setter Property="FontWeight" Value="Normal" />
    </Style>
    <Style Selector="TextBlock.text-micro">
        <Setter Property="FontSize" Value="{DynamicResource FontSizeMicro}" />
        <Setter Property="FontWeight" Value="Normal" />
    </Style>
    <!-- Small labels / form field names: medium weight, not bold. -->
    <Style Selector="TextBlock.text-label">
        <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}" />
        <Setter Property="FontWeight" Value="Medium" />
    </Style>
    <!-- Body with slight emphasis (e.g. translated line in segment list). -->
    <Style Selector="TextBlock.text-emphasis">
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}" />
        <Setter Property="FontWeight" Value="Medium" />
    </Style>
    <Style Selector="TextBlock.text-mono">
        <Setter Property="FontFamily" Value="{DynamicResource UiMonoFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeSecondary}" />
        <Setter Property="FontWeight" Value="Normal" />
    </Style>
    <!-- All-caps / section rails (pipeline labels): small + medium, not heavy bold. -->
    <Style Selector="TextBlock.text-overline">
        <Setter Property="FontSize" Value="{DynamicResource FontSizeMicro}" />
        <Setter Property="FontWeight" Value="Medium" />
    </Style>

    <Style Selector="TextBox">
        <Setter Property="FontFamily" Value="{DynamicResource UiFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}" />
    </Style>
    <Style Selector="ComboBox">
        <Setter Property="FontFamily" Value="{DynamicResource UiFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}" />
    </Style>
    <Style Selector="CheckBox">
        <Setter Property="FontFamily" Value="{DynamicResource UiFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeSecondary}" />
    </Style>
    <Style Selector="RadioButton">
        <Setter Property="FontFamily" Value="{DynamicResource UiFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeSecondary}" />
    </Style>
    <Style Selector="Button">
        <Setter Property="FontFamily" Value="{DynamicResource UiFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeSecondary}" />
        <Setter Property="FontWeight" Value="Normal" />
    </Style>
    <!-- Toolbar / chrome pills keep compact secondary sizing; weight stays normal unless template sets it. -->
    <Style Selector="Button.control-pill">
        <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}" />
    </Style>
</Styles>
