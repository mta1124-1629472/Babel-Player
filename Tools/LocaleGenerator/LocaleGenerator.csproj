<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Configurations>Debug;Release;Dev</Configurations>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Babel.Player.Tools.LocaleGenerator</RootNamespace>
    <AssemblyName>BabelPlayer.LocaleGenerator</AssemblyName>
    <!-- Disambiguate against the referenced BabelPlayer.exe Program.Main. -->
    <StartupObject>Babel.Player.Tools.LocaleGenerator.Program</StartupObject>
    <!-- This is a developer-only tool; exclude it from solution-wide packaging. -->
    <IsPackable>false</IsPackable>
    <!-- Avoid re-running the main project's Avalonia AXAML / native deps when
         this tool is built standalone. -->
    <UseAvalonia>false</UseAvalonia>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\BabelPlayer.csproj" />
  </ItemGroup>
</Project>
