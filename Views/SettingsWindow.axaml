<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Babel.Player.ViewModels"
        xmlns:v="using:Babel.Player.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="720" d:DesignHeight="640"
        x:Class="Babel.Player.Views.SettingsWindow"
        x:DataType="vm:SettingsViewModel"
        Icon="/Assets/Icons/app.ico"
        Title="Babel Player - Settings"
        Width="740" Height="680"
        MinWidth="600" MinHeight="500">

    <Window.Styles>
        <Style Selector="RadioButton.sidebar-item">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource StatusTextBrush}"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Margin" Value="8,2"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>
        <Style Selector="RadioButton.sidebar-item:pointerover">
            <Setter Property="Background" Value="{DynamicResource PillHoverBackgroundBrush}"/>
        </Style>
        <Style Selector="RadioButton.sidebar-item:checked">
            <Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
        </Style>
        <Style Selector="Border.settings-card">
            <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
        <Style Selector="Border.settings-card:pointerover">
            <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}"/>
        </Style>
    </Window.Styles>

    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="180"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" 
                   Classes="text-display" Text="Settings" 
                   Margin="0,0,0,16"/>

        <!-- Sidebar -->
        <Border Grid.Row="1" Grid.Column="0" 
                Background="{DynamicResource SurfaceSubtleBrush}"
                CornerRadius="8"
                Padding="4"
                Margin="0,0,12,0">
            <StackPanel>
                <RadioButton Classes="sidebar-item" GroupName="SettingsNav" Content="General" IsChecked="{Binding IsGeneralSelected, Mode=TwoWay}" Tag="General"/>
                <RadioButton Classes="sidebar-item" GroupName="SettingsNav" Content="Hotkeys" IsChecked="{Binding IsHotkeysSelected, Mode=TwoWay}" Tag="Hotkeys"/>
                <RadioButton Classes="sidebar-item" GroupName="SettingsNav" Content="Video" IsChecked="{Binding IsVideoSelected, Mode=TwoWay}" Tag="Video"/>
                <RadioButton Classes="sidebar-item" GroupName="SettingsNav" Content="Models" IsChecked="{Binding IsModelsSelected, Mode=TwoWay}" Tag="Models"/>
                <RadioButton Classes="sidebar-item" GroupName="SettingsNav" Content="About" IsChecked="{Binding IsAboutSelected, Mode=TwoWay}" Tag="About"/>
                <RadioButton Classes="sidebar-item" GroupName="SettingsNav" Content="Diagnostics" IsChecked="{Binding IsDiagnosticsSelected, Mode=TwoWay}" Tag="Diagnostics"/>
            </StackPanel>
        </Border>

        <!-- Content Area -->
        <Border Grid.Row="1" Grid.Column="1" 
                Background="{DynamicResource PanelBackgroundBrush}"
                CornerRadius="8"
                Padding="20">
            <Grid>
                <!-- General Panel -->
                <ScrollViewer IsVisible="{Binding IsGeneralSelected}" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="16">
                        <!-- Session Settings Card -->
                        <Border Classes="settings-card">
                            <StackPanel Spacing="12">
                                <TextBlock Text="Session" Classes="text-title" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                                    <StackPanel Grid.Column="0" Grid.Row="0" Spacing="4">
                                        <TextBlock Text="Recent session history limit" Classes="text-secondary" Foreground="{DynamicResource StatusTextBrush}"/>
                                        <TextBlock Text="Maximum number of recent sessions kept in the file menu (1–20)." Classes="text-micro" Opacity="0.5" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <TextBox Grid.Column="1" Grid.Row="0" Text="{Binding MaxRecentSessions, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="60" VerticalAlignment="Center"/>
                                </Grid>
                                <CheckBox IsChecked="{Binding AutoSaveEnabled}" Content="Auto-save session on exit"/>
                            </StackPanel>
                        </Border>

                        <!-- GPU Backend Card -->
                        <Border Classes="settings-card">
                            <StackPanel Spacing="12">
                                <TextBlock Text="GPU Backend" Classes="text-title" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Preferred Local GPU Backend" Classes="text-secondary" Foreground="{DynamicResource StatusTextBrush}"/>
                                    <ComboBox ItemsSource="{Binding GpuBackendOptions}"
                                              SelectedItem="{Binding PreferredLocalGpuBackend, Mode=TwoWay}"
                                              Width="220"
                                              HorizontalAlignment="Left">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Converter={StaticResource GpuHostBackendDisplayConverter}}"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <TextBlock Text="Managed local GPU is the default low-friction path. Docker GPU host is available as an advanced backend." Classes="text-micro" Opacity="0.5" TextWrapping="Wrap"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Backend Status Card -->
                        <Border Classes="settings-card">
                            <StackPanel Spacing="12">
                                <TextBlock Text="Backend Status" Classes="text-title" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Top">
                                    <Ellipse Width="10" Height="10" Fill="{Binding BackendStatusBrush}" VerticalAlignment="Top" Margin="0,3,0,0"/>
                                    <TextBlock Text="{Binding BackendStatusText}" Classes="text-emphasis" TextWrapping="Wrap" MaxWidth="480"/>
                                    <Button Content="Restart" Command="{Binding RestartBackendCommand}" IsEnabled="{Binding CanRestartBackend}" Padding="12,6" VerticalAlignment="Top"/>
                                </StackPanel>
                                <TextBlock Text="{Binding BackendErrorDetail}" IsVisible="{Binding BackendErrorDetail, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" Classes="text-caption" Foreground="{DynamicResource SystemErrorForeground}" Opacity="0.8" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- Docker GPU Card -->
                        <Border Classes="settings-card">
                            <StackPanel Spacing="12">
                                <TextBlock Text="Docker GPU Service" Classes="text-title" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Advanced GPU Service URL" Classes="text-secondary" Foreground="{DynamicResource StatusTextBrush}"/>
                                    <TextBox Text="{Binding AdvancedGpuServiceUrl, Mode=TwoWay}" IsEnabled="{Binding IsDockerBackend}" Width="280" HorizontalAlignment="Left"/>
                                    <TextBlock Text="Only editable when the Docker GPU backend is selected." Classes="text-micro" Opacity="0.5" TextWrapping="Wrap"/>
                                </StackPanel>
                                <CheckBox IsChecked="{Binding AlwaysStartLocalGpuRuntimeAtAppStart}" Content="Always start local GPU runtime at app start"/>
                            </StackPanel>
                        </Border>

                        <Border Classes="settings-card">
                            <StackPanel Spacing="6">
                                <TextBlock Text="Pipeline audio &amp; dubbing" Classes="text-title" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                <TextBlock Text="Vocal separation and segment timing (dub) are configured in the main window → Pipeline panel, so they stay next to the run controls." Classes="text-caption" Opacity="0.65" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- Advanced CPU Expander -->
                        <Expander Header="Advanced: CPU Transcription" IsExpanded="False">
                            <StackPanel Spacing="12" Margin="0,12,0,0">
                                <TextBlock Text="These options tune CPU-only transcription. 0 threads means auto selection. Worker count can follow hardware (cores + RAM) or a manual value (clamped)." Classes="text-micro" Opacity="0.5" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding CpuAdvancedSettingsNotice}" Classes="text-caption" Foreground="{DynamicResource StatusTextBrush}" TextWrapping="Wrap"/>
                                <Grid ColumnDefinitions="140,*" RowDefinitions="Auto,Auto,Auto,Auto">
                                    <TextBlock Grid.Column="0" Grid.Row="0" Text="CPU Compute Type:" VerticalAlignment="Center" Classes="text-secondary"/>
                                    <ComboBox Grid.Column="1" Grid.Row="0" ItemsSource="{Binding TranscriptionCpuComputeTypeOptions}" SelectedItem="{Binding TranscriptionCpuComputeType, Mode=TwoWay}" Width="150"/>
                                    <TextBlock Grid.Column="0" Grid.Row="1" Text="CPU Threads (0=auto):" VerticalAlignment="Center" Classes="text-secondary" Margin="0,8,0,0"/>
                                    <TextBox Grid.Column="1" Grid.Row="1" Text="{Binding TranscriptionCpuThreads, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="80" Margin="0,8,0,0"/>
                                    <CheckBox Grid.Column="1" Grid.Row="2" Content="Automatic worker count (from CPU cores and RAM)" IsChecked="{Binding TranscriptionNumWorkersUseAuto, Mode=TwoWay}" Margin="0,8,0,0"/>
                                    <TextBlock Grid.Column="0" Grid.Row="3" Text="Workers (manual):" VerticalAlignment="Center" Classes="text-secondary" Margin="0,8,0,0"/>
                                    <TextBox Grid.Column="1" Grid.Row="3" Text="{Binding TranscriptionNumWorkers, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="80" Margin="0,8,0,0" IsEnabled="{Binding TranscriptionNumWorkersManualEnabled}"/>
                                </Grid>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>

                <!-- Hotkeys Panel -->
                <ScrollViewer IsVisible="{Binding IsHotkeysSelected}" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="16">
                        <Border Classes="settings-card">
                            <StackPanel Spacing="12">
                                <TextBlock Text="Keyboard Shortcuts" Classes="text-title" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                <TextBlock Text="Hotkey customisation is not yet available. Shown values are the current defaults." Classes="text-caption" Opacity="0.5" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                <Grid ColumnDefinitions="160,*" RowDefinitions="Auto,Auto,Auto,Auto">
                                    <TextBlock Grid.Column="0" Grid.Row="0" Text="Play/Pause:" VerticalAlignment="Center" Classes="text-secondary"/>
                                    <TextBox Grid.Column="1" Grid.Row="0" Text="{Binding PlayPauseHotkey}" IsReadOnly="True" Width="120"/>
                                    <TextBlock Grid.Column="0" Grid.Row="1" Text="Toggle Segment Panel:" VerticalAlignment="Center" Classes="text-secondary" Margin="0,8,0,0"/>
                                    <TextBox Grid.Column="1" Grid.Row="1" Text="{Binding ToggleSegmentPanelHotkey}" IsReadOnly="True" Width="120" Margin="0,8,0,0"/>
                                    <TextBlock Grid.Column="0" Grid.Row="2" Text="Toggle Dub Mode:" VerticalAlignment="Center" Classes="text-secondary" Margin="0,8,0,0"/>
                                    <TextBox Grid.Column="1" Grid.Row="2" Text="{Binding ToggleDubModeHotkey}" IsReadOnly="True" Width="120" Margin="0,8,0,0"/>
                                    <TextBlock Grid.Column="0" Grid.Row="3" Text="Toggle Fullscreen:" VerticalAlignment="Center" Classes="text-secondary" Margin="0,8,0,0"/>
                                    <TextBox Grid.Column="1" Grid.Row="3" Text="{Binding ToggleFullscreenHotkey}" IsReadOnly="True" Width="120" Margin="0,8,0,0"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- Video Panel -->
                <ScrollViewer IsVisible="{Binding IsVideoSelected}" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="16">
                        <!-- Playback / captions -->
                        <Border Classes="settings-card">
                            <StackPanel Spacing="12">
                                <TextBlock Text="Embedded playback" Classes="text-title" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                <CheckBox IsChecked="{Binding BilingualSubtitlesEnabled, Mode=TwoWay}"
                                          Content="Bilingual subtitles (source + translation in exports and embedded preview)"/>
                                <TextBlock Text="When enabled, subtitle export and the in-player CC track include both languages when segments are available." Classes="text-micro" Opacity="0.5" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- Hardware Decode Card -->
                        <Border Classes="settings-card">
                            <StackPanel Spacing="12">
                                <TextBlock Text="Hardware Decode" Classes="text-title" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                <Grid ColumnDefinitions="140,*" RowDefinitions="Auto,Auto,Auto">
                                    <TextBlock Grid.Column="0" Grid.Row="0" Text="Hardware Decoder:" VerticalAlignment="Center"/>
                                    <ComboBox Grid.Column="1" Grid.Row="0" ItemsSource="{Binding HwdecOptions}" SelectedItem="{Binding VideoHwdec, Mode=TwoWay}" Width="200"/>
                                    <TextBlock Grid.Column="0" Grid.Row="1" Text="GPU Rendering API:" VerticalAlignment="Center" Margin="0,8,0,0"/>
                                    <ComboBox Grid.Column="1" Grid.Row="1" ItemsSource="{Binding GpuApiOptions}" SelectedItem="{Binding VideoGpuApi, Mode=TwoWay}" Width="200" Margin="0,8,0,0"/>
                                    <TextBlock Grid.Column="0" Grid.Row="2" Text="Export Encoder:" VerticalAlignment="Center" Margin="0,8,0,0"/>
                                    <ComboBox Grid.Column="1" Grid.Row="2" ItemsSource="{Binding ExportEncoderOptions}" SelectedItem="{Binding VideoExportEncoder, Mode=TwoWay}" Width="200" Margin="0,8,0,0"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- GPU-Next Card -->
                        <Border Classes="settings-card">
                            <StackPanel Spacing="12">
                                <TextBlock Text="GPU-Next Backend" Classes="text-title" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                <CheckBox IsChecked="{Binding VideoUseGpuNext, Mode=TwoWay}" Content="Use gpu-next video output (required for RTX enhancements)"/>
                                <TextBlock Text="gpu-next is the newer mpv renderer. Enable this before turning on RTX Video Super Resolution or HDR modes." Classes="text-micro" Opacity="0.5" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- RTX Video Card -->
                        <Border Classes="settings-card">
                            <StackPanel Spacing="12">
                                <TextBlock Text="RTX Video Enhancement" Classes="text-title" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                <CheckBox IsChecked="{Binding VideoVsrEnabled, Mode=TwoWay}" IsEnabled="{Binding VsrSettingsAvailable}" Content="RTX Video Super Resolution (VSR)"/>
                                <TextBlock Text="AI upscaling via NVIDIA d3d11vpp. Requires a detected GeForce RTX GPU, driver ≥ 551.23, gpu-next, and 'RTX Video Enhancement' in NVIDIA Control Panel." Classes="text-micro" Opacity="0.5" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding RtxVideoHardwareGateHint}" IsVisible="{Binding HasRtxVideoHardwareGateHint}" Classes="text-micro" Opacity="0.5" TextWrapping="Wrap"/>
                                
                                <Border Background="{DynamicResource SurfaceRaisedBrush}" CornerRadius="6" Padding="12" Margin="0,8,0,0">
                                    <Grid ColumnDefinitions="100,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="4">
                                        <TextBlock Grid.Column="0" Grid.Row="0" Text="Support:" Classes="text-label"/>
                                        <TextBlock Grid.Column="1" Grid.Row="0" Text="{Binding VsrSupportHintText}" Classes="text-caption" TextWrapping="Wrap"/>
                                        <TextBlock Grid.Column="0" Grid.Row="1" Text="Requested:" Classes="text-label"/>
                                        <TextBlock Grid.Column="1" Grid.Row="1" Text="{Binding VsrRequestedStateText}" Classes="text-caption" TextWrapping="Wrap"/>
                                        <TextBlock Grid.Column="0" Grid.Row="2" Text="Resolved:" Classes="text-label"/>
                                        <TextBlock Grid.Column="1" Grid.Row="2" Text="{Binding VsrResolvedStateText}" Classes="text-caption" TextWrapping="Wrap"/>
                                        <TextBlock Grid.Column="0" Grid.Row="3" Text="Last reason:" Classes="text-label"/>
                                        <TextBlock Grid.Column="1" Grid.Row="3" Text="{Binding VsrReasonText}" Classes="text-caption" TextWrapping="Wrap"/>
                                        <TextBlock Grid.Column="0" Grid.Row="4" Text="Last filter:" Classes="text-label"/>
                                        <TextBlock Grid.Column="1" Grid.Row="4" Text="{Binding VsrFilterText}" Classes="text-caption" TextWrapping="Wrap"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- HDR Card -->
                        <Border Classes="settings-card">
                            <StackPanel Spacing="12">
                                <TextBlock Text="HDR Playback" Classes="text-title" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                <TextBlock Text="Choose one mode. RTX HDR follows NVIDIA Control Panel. HDR passthrough configures mpv. Requires gpu-next and Windows HDR." Classes="text-micro" Opacity="0.5" TextWrapping="Wrap"/>
                                
                                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                                    <RadioButton GroupName="VideoHdrPlaybackMode" Content="Off" IsChecked="{Binding IsHdrModeOff, Mode=TwoWay}" IsEnabled="{Binding VideoUseGpuNext}" Padding="12,8"/>
                                    <RadioButton GroupName="VideoHdrPlaybackMode" Content="RTX HDR" IsChecked="{Binding IsHdrModeNvidia, Mode=TwoWay}" IsEnabled="{Binding RtxHdrDriverModeAvailable}" Padding="12,8"/>
                                    <RadioButton GroupName="VideoHdrPlaybackMode" Content="HDR passthrough" IsChecked="{Binding IsHdrModeMpv, Mode=TwoWay}" IsEnabled="{Binding HdrSettingsAvailable}" Padding="12,8"/>
                                </StackPanel>
                                
                                <StackPanel IsVisible="{Binding IsMpvHdrPassthroughDetailsVisible}" Spacing="8" Margin="0,8,0,0">
                                    <TextBlock Text="mpv passthrough options" Classes="text-label"/>
                                    <Grid ColumnDefinitions="120,*" RowDefinitions="Auto,Auto,Auto">
                                        <TextBlock Grid.Column="0" Grid.Row="0" Text="Tone mapping:" VerticalAlignment="Center"/>
                                        <ComboBox Grid.Column="1" Grid.Row="0" ItemsSource="{Binding HdrToneMappingOptions}" SelectedItem="{Binding VideoToneMapping, Mode=TwoWay}" Width="200" HorizontalAlignment="Left"/>
                                        <TextBlock Grid.Column="0" Grid.Row="1" Text="Target peak:" VerticalAlignment="Center" Margin="0,8,0,0"/>
                                        <TextBox Grid.Column="1" Grid.Row="1" Text="{Binding VideoTargetPeak, Mode=TwoWay}" Width="200" HorizontalAlignment="Left" PlaceholderText="auto or nits" Margin="0,8,0,0"/>
                                        <TextBlock Grid.Column="0" Grid.Row="2" Text="HDR compute peak:" VerticalAlignment="Center" Margin="0,8,0,0"/>
                                        <CheckBox Grid.Column="1" Grid.Row="2" IsChecked="{Binding VideoHdrComputePeak, Mode=TwoWay}" Content="Dynamic per-frame peak (mpv)" Margin="0,8,0,0"/>
                                    </Grid>
                                </StackPanel>
                                
                                <TextBlock Text="{Binding HdrAvailabilityHintText}" IsVisible="{Binding HasHdrAvailabilityHint}" Classes="text-micro" Opacity="0.5" TextWrapping="Wrap"/>
                                <TextBlock Text="{x:Static vm:SettingsViewModel.HdrDriverFeatureHintText}" Classes="text-micro" Opacity="0.4" TextWrapping="Wrap"/>
                                <TextBlock Text="All video settings take effect after restarting the app." Classes="text-micro" Opacity="0.4" TextWrapping="Wrap" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- Models Panel -->
                <Grid IsVisible="{Binding IsModelsSelected}" RowDefinitions="Auto,*">
                    <StackPanel Grid.Row="0" Margin="0,0,0,12">
                        <TextBlock Text="Models" Classes="text-title" Foreground="{DynamicResource PrimaryTextBrush}"/>
                        <TextBlock Text="Manage locally-hosted models. Cloud providers do not require downloads." Classes="text-caption" Opacity="0.5" TextWrapping="Wrap"/>
                    </StackPanel>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding ModelsTab.Models}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:ModelDownloadEntry">
                                    <Border Margin="0,0,0,8" Padding="12" Background="{DynamicResource ControlBackgroundBrush}" CornerRadius="8">
                                        <Grid ColumnDefinitions="160,*,Auto">
                                            <StackPanel Grid.Column="0" Spacing="2">
                                                <TextBlock Text="{Binding ProviderLabel}" Classes="text-micro" Opacity="0.5"/>
                                                <TextBlock Text="{Binding ModelId}" Classes="text-emphasis"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4" Margin="12,0">
                                                <TextBlock Text="{Binding StatusLabel}" Classes="text-caption"/>
                                                <ProgressBar Value="{Binding DownloadProgress}" Minimum="0" Maximum="1" Height="4" IsVisible="{Binding IsProgressVisible}" AutomationProperties.Name="Model download progress"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                <Button Content="Download" IsVisible="{Binding CanDownload}" Command="{Binding DownloadCommand}" Padding="10,6"/>
                                                <Button Content="Cancel" IsVisible="{Binding CanCancel}" Command="{Binding CancelCommand}" Padding="10,6"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>

                <!-- About Panel -->
                <ScrollViewer IsVisible="{Binding IsAboutSelected}" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="16" HorizontalAlignment="Center">
                        <StackPanel HorizontalAlignment="Center" Spacing="8">
                            <TextBlock Text="Babel Player" Classes="text-display" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding AppVersion}" HorizontalAlignment="Center" Opacity="0.7"/>
                            <TextBlock Text="{Binding AppBuildDate}" Classes="text-caption" HorizontalAlignment="Center" Opacity="0.5"/>
                            <TextBlock Text="AGPL-3.0 License" Classes="text-micro" HorizontalAlignment="Center" Opacity="0.5"/>
                        </StackPanel>
                        
                        <StackPanel Spacing="12" Margin="0,20,0,0">
                            <TextBlock Text="Support the project:" Classes="text-secondary" HorizontalAlignment="Center" Opacity="0.7"/>
                            <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
                                <Button Command="{Binding OpenKofiCommand}" Padding="16,10" Background="{DynamicResource ButtonBackgroundBrush}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="☕" FontSize="16"/>
                                        <TextBlock Text="Ko-fi" Classes="text-emphasis"/>
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding OpenGitHubSponsorsCommand}" Padding="16,10" Background="{DynamicResource ButtonBackgroundBrush}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="❤" FontSize="16" Foreground="#BF3989"/>
                                        <TextBlock Text="GitHub Sponsors" Classes="text-emphasis"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- Diagnostics Panel -->
                <ScrollViewer IsVisible="{Binding IsDiagnosticsSelected}" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="16">
                        <Border Classes="settings-card">
                            <StackPanel Spacing="12">
                                <TextBlock Text="Hardware Snapshot" Classes="text-title" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                <Grid ColumnDefinitions="120,*" RowDefinitions="Auto,Auto,Auto">
                                    <TextBlock Grid.Column="0" Grid.Row="0" Text="CPU:" Opacity="0.65"/>
                                    <TextBlock Grid.Column="1" Grid.Row="0" Text="{Binding CpuInfo}" TextWrapping="Wrap"/>
                                    <TextBlock Grid.Column="0" Grid.Row="1" Text="GPU:" Opacity="0.65" Margin="0,4,0,0"/>
                                    <TextBlock Grid.Column="1" Grid.Row="1" Text="{Binding GpuInfo}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                    <TextBlock Grid.Column="0" Grid.Row="2" Text="System RAM:" Opacity="0.65" Margin="0,4,0,0"/>
                                    <TextBlock Grid.Column="1" Grid.Row="2" Text="{Binding RamInfo}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                        
                        <Border Classes="settings-card">
                            <StackPanel Spacing="12">
                                <TextBlock Text="Runtime Routing" Classes="text-title" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                <Grid ColumnDefinitions="120,*" RowDefinitions="Auto,Auto,Auto,Auto">
                                    <TextBlock Grid.Column="0" Grid.Row="0" Text="Inference Host:" Opacity="0.65"/>
                                    <TextBlock Grid.Column="1" Grid.Row="0" Text="{Binding InferenceModeInfo}" TextWrapping="Wrap"/>
                                    <TextBlock Grid.Column="0" Grid.Row="1" Text="Warmup Status:" Opacity="0.65" Margin="0,4,0,0"/>
                                    <TextBlock Grid.Column="1" Grid.Row="1" Text="{Binding RuntimeWarmupInfo}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                    <TextBlock Grid.Column="0" Grid.Row="2" Text="NMT Fallback:" Opacity="0.65" Margin="0,4,0,0"/>
                                    <TextBlock Grid.Column="1" Grid.Row="2" Text="{Binding TranslationFallbackInfo}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                    <TextBlock Grid.Column="0" Grid.Row="3" Text="GPU probe streak:" Opacity="0.65" Margin="0,4,0,0"/>
                                    <TextBlock Grid.Column="1" Grid.Row="3" Text="{Binding GpuHostProbeDiagnostics}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                        
                        <Border Classes="settings-card">
                            <StackPanel Spacing="12">
                                <TextBlock Text="Environment" Classes="text-title" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                <Grid ColumnDefinitions="120,*" RowDefinitions="Auto,Auto">
                                    <TextBlock Grid.Column="0" Grid.Row="0" Text="Python Path:" Opacity="0.65"/>
                                    <TextBlock Grid.Column="1" Grid.Row="0" Text="{Binding PythonInfo}" TextWrapping="Wrap" Classes="text-caption"/>
                                    <TextBlock Grid.Column="0" Grid.Row="1" Text="ffmpeg Path:" Opacity="0.65" Margin="0,4,0,0"/>
                                    <TextBlock Grid.Column="1" Grid.Row="1" Text="{Binding FfmpegInfo}" TextWrapping="Wrap" Classes="text-caption" Margin="0,4,0,0"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                        
                        <Button Content="Refresh Diagnostics" Command="{Binding RefreshDiagnosticsCommand}" HorizontalAlignment="Left" Padding="12,8"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Footer -->
        <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" 
                    Orientation="Horizontal" HorizontalAlignment="Right" 
                    Spacing="10" Margin="0,16,0,0">
            <Button Content="Cancel" Click="OnCancelClick" Padding="16,8"/>
            <Button Content="Save &amp; Close" Click="OnOKClick" Padding="16,8"/>
        </StackPanel>
    </Grid>
</Window>
