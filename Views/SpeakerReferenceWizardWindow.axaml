<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Babel.Player.ViewModels"
        xmlns:model="using:Babel.Player.Models"
        xmlns:v="using:Babel.Player.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        x:Class="Babel.Player.Views.SpeakerReferenceWizardWindow"
        x:Name="WizardRoot"
        x:DataType="vm:SpeakerReferenceWizardViewModel"
        Title="Speaker Reference Wizard"
        Width="1100"
        Height="800"
        MinWidth="900"
        MinHeight="650"
        CanResize="True"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource PanelBackgroundBrush}">

    <Window.Styles>
        <Style Selector="Border.card">
            <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14"/>
        </Style>
        <Style Selector="Border.card:pointerover">
            <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}"/>
        </Style>
        <Style Selector="Button.action-btn">
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>
        <Style Selector="Button.primary-action">
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
        </Style>
        <Style Selector="TextBlock.section-header">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
        </Style>
        <Style Selector="TextBlock.help-text">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Opacity" Value="0.55"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </Window.Styles>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,16">
            <TextBlock Text="Speaker Reference Wizard" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
            <TextBlock Text="Assign voices to speakers and set reference audio clips. Use the preview to find good clips, then click 'Use Playhead' to grab the current moment." FontSize="12" Opacity="0.6" TextWrapping="Wrap"/>
        </StackPanel>

        <!-- Progress & Quick Actions -->
        <Border Grid.Row="1" Classes="card" Margin="0,0,0,14">
            <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto">
                <!-- Status Badges -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                    <Border Background="{DynamicResource PositiveBrush}" CornerRadius="6" Padding="12,6" ToolTip.Tip="Speakers with good reference clips">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="✓" FontSize="12" Foreground="{DynamicResource PositiveFgBrush}"/>
                            <TextBlock Text="{Binding GoodCount, StringFormat='Good ({0})'}" FontSize="12" Foreground="{DynamicResource PositiveFgBrush}" FontWeight="Medium"/>
                        </StackPanel>
                    </Border>
                    <Border Background="{DynamicResource InfoBrush}" CornerRadius="6" Padding="12,6" ToolTip.Tip="Speakers that need review">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="!" FontSize="12" Foreground="{DynamicResource InfoFgBrush}"/>
                            <TextBlock Text="{Binding ReviewCount, StringFormat='Review ({0})'}" FontSize="12" Foreground="{DynamicResource InfoFgBrush}" FontWeight="Medium"/>
                        </StackPanel>
                    </Border>
                    <Border Background="{DynamicResource DestructiveBrush}" CornerRadius="6" Padding="12,6" ToolTip.Tip="Speakers with poor or missing reference">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="✗" FontSize="12" Foreground="{DynamicResource DestructiveFgBrush}"/>
                            <TextBlock Text="{Binding PoorCount, StringFormat='Poor ({0})'}" FontSize="12" Foreground="{DynamicResource DestructiveFgBrush}" FontWeight="Medium"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <CheckBox Grid.Column="1"
                          IsChecked="{Binding ShowLowConfidenceOnly, Mode=TwoWay}"
                          Content="Show needs attention"
                          VerticalAlignment="Center"
                          Margin="16,0,0,0"
                          FontSize="12"
                          ToolTip.Tip="Only show speakers that need review or have poor reference"/>

                <Button Grid.Column="2"
                        Command="{Binding ResetAllCommand}"
                        Content="Reset All"
                        Padding="10,6"
                        Margin="12,0,0,0"
                        FontSize="11"
                        ToolTip.Tip="Clear all draft changes and start fresh"/>

                <TextBlock Grid.Column="4"
                           Text="{Binding StatusText}"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Right"
                           FontSize="11"
                           Opacity="0.6"/>
            </Grid>
        </Border>

        <!-- Main Content: Split View -->
        <Grid Grid.Row="2" ColumnDefinitions="340,*">
            <!-- Left: Video Preview -->
            <Border Grid.Column="0" 
                    BorderBrush="{DynamicResource BorderBrush}" 
                    BorderThickness="1" 
                    CornerRadius="8"
                    Margin="0,0,12,0">
                <Grid RowDefinitions="Auto,*,Auto,Auto,Auto">
                    <!-- Header with instructions -->
                    <StackPanel Grid.Row="0" Margin="12,12,12,8">
                        <TextBlock Text="Preview" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                        <TextBlock Text="Scrub through the video to find good audio clips. Click 'Use Playhead' on a speaker to grab the current moment as their reference." FontSize="10" Opacity="0.5" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    </StackPanel>

                    <!-- Video Surface (Windows) -->
                    <Border Grid.Row="1" 
                            Background="#080810" 
                            CornerRadius="6"
                            Margin="8,0"
                            IsVisible="{Binding MiniPreview.ShowVideoSurface}"
                            ClipToBounds="True">
                        <v:MpvVideoView x:Name="WizardVideoView"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Stretch"/>
                    </Border>

                    <!-- Non-Windows Hint -->
                    <Border Grid.Row="1" 
                            Background="{DynamicResource SurfaceSubtleBrush}" 
                            CornerRadius="6"
                            Padding="16"
                            Margin="8,0"
                            IsVisible="{Binding MiniPreview.ShowNonWindowsHint}">
                        <StackPanel Spacing="8" VerticalAlignment="Center">
                            <TextBlock Text="Preview not available on this platform" FontSize="12" FontWeight="Medium" HorizontalAlignment="Center"/>
                            <TextBlock Text="On Linux/macOS, use the main window to scrub through video. When you find a good moment, come back here and click 'Use Playhead' for that speaker." FontSize="10" Opacity="0.6" TextWrapping="Wrap" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Playback Controls -->
                    <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8" Margin="12,8" IsVisible="{Binding MiniPreview.ShowVideoSurface}" VerticalAlignment="Center">
                        <TextBlock Grid.Column="0"
                                   Text="{Binding MiniPreview.PositionFormatted}"
                                   FontSize="11"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource VideoOverlaySubtextBrush}"
                                   MinWidth="50"/>
                        <Slider Grid.Column="1"
                                Minimum="0"
                                Maximum="{Binding MiniPreview.DurationMs}"
                                Value="{Binding MiniPreview.PositionMs, Mode=TwoWay}"
                                IsEnabled="{Binding MiniPreview.HasLoadedMedia}"
                                VerticalAlignment="Center"
                                ToolTip.Tip="Drag to seek through the video"/>
                        <TextBlock Grid.Column="2"
                                   Text="{Binding MiniPreview.DurationFormatted}"
                                   FontSize="11"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource VideoOverlaySubtextBrush}"
                                   MinWidth="50"
                                   TextAlignment="Right"/>
                        <Button Grid.Column="3"
                                Command="{Binding MiniPreview.ToggleMiniPlaybackCommand}"
                                Content="{Binding MiniPreview.MiniPlayPauseLabel}"
                                Padding="12,6"
                                FontSize="11"
                                FontWeight="Medium"
                                ToolTip.Tip="Play or pause the preview"/>
                    </Grid>

                    <!-- Status Hint -->
                    <TextBlock Grid.Row="4"
                               Text="{Binding MiniPreview.StatusHint}"
                               FontSize="10"
                               Foreground="{DynamicResource DestructiveFgBrush}"
                               TextWrapping="Wrap"
                               Margin="12,4,12,12"
                               IsVisible="{Binding MiniPreview.HasStatusHint}"/>

                    <!-- Playhead Clip Settings -->
                    <Border Grid.Row="3" Classes="card" Margin="8,8,8,12" IsVisible="{Binding MiniPreview.ShowVideoSurface}">
                        <StackPanel Spacing="6">
                            <TextBlock Text="Playhead Clip Duration" FontSize="11" FontWeight="Medium" ToolTip.Tip="How much audio to grab before and after the playhead position"/>
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                <Slider Grid.Column="0"
                                        Width="100"
                                        Minimum="3"
                                        Maximum="15"
                                        TickFrequency="1"
                                        IsSnapToTickEnabled="True"
                                        Value="{Binding PlayheadClipWindowSeconds, Mode=TwoWay}"
                                        VerticalAlignment="Center"
                                        ToolTip.Tip="Length of audio clip in seconds (3-15 seconds)"/>
                                <TextBlock Grid.Column="1" Text="{Binding PlayheadClipWindowSeconds, StringFormat='{}{0:F0} seconds'}" VerticalAlignment="Center" FontSize="11" Opacity="0.7"/>
                                <Button Grid.Column="2" Command="{Binding StopReferencePreviewCommand}" Content="⏹ Stop" Padding="8,4" FontSize="10" ToolTip.Tip="Stop any currently playing reference audio"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Right: Speaker Cards -->
            <Border Grid.Column="1" 
                    BorderBrush="{DynamicResource BorderBrush}" 
                    BorderThickness="1" 
                    CornerRadius="8">
                <Grid RowDefinitions="Auto,*">
                    <!-- Header -->
                    <StackPanel Grid.Row="0" Margin="14,14,14,8">
                        <TextBlock Text="Speakers" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                        <TextBlock Text="Select a voice for each speaker. For Qwen, also set a reference audio clip from the video." FontSize="10" Opacity="0.5" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    </StackPanel>

                    <!-- Speaker List -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding VisibleDraftItems}" Margin="4">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="model:SpeakerReferenceDraftItem">
                                    <Border Margin="4" Padding="14" Background="{DynamicResource ControlBackgroundBrush}" CornerRadius="8">
                                        <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" ColumnDefinitions="Auto,*,Auto">
                                            <!-- Speaker Header -->
                                            <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="10" Margin="0,0,0,10">
                                                <TextBlock Text="{Binding SpeakerId}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                                                <Border Background="{DynamicResource InfoBrush}" CornerRadius="4" Padding="8,3" VerticalAlignment="Center"
                                                        ToolTip.Tip="Quality of the reference clip for this speaker">
                                                    <TextBlock Text="{Binding ConfidenceTier}" FontSize="10" FontWeight="Medium" Foreground="{DynamicResource InfoFgBrush}"/>
                                                </Border>
                                                <TextBlock Text="{Binding LastActionLabel}" FontSize="11" Opacity="0.5" VerticalAlignment="Center"
                                                           ToolTip.Tip="Last action taken on this speaker"/>
                                            </StackPanel>

                                            <!-- Voice Assignment -->
                                            <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Spacing="8" Margin="0,0,0,10">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <TextBlock Text="Voice" FontSize="11" FontWeight="Medium" Opacity="0.7"/>
                                                    <TextBlock Text="(for TTS generation)" FontSize="10" Opacity="0.4" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="6">
                                                    <TextBlock Grid.Column="0" Text="{Binding EffectiveAssignedVoice, TargetNullValue='None'}" FontSize="12" VerticalAlignment="Center"/>
                                                    <Button Grid.Column="1" Classes="action-btn" Tag="{Binding}" Click="OnKeepAutoClick" Content="Auto"
                                                            ToolTip.Tip="Use automatically detected voice for this speaker"/>
                                                    <Button Grid.Column="2" Classes="action-btn" Tag="{Binding}" Click="OnUseActiveTtsVoiceClick" Content="Use Active"
                                                            ToolTip.Tip="Use the currently active TTS voice setting"/>
                                                    <Button Grid.Column="3" Classes="action-btn" Tag="{Binding}" Click="OnClearVoiceClick" Content="Clear"
                                                            ToolTip.Tip="Clear the voice assignment, will use auto-detect"/>
                                                </Grid>
                                                <ComboBox IsVisible="{Binding ShowPiperVoiceRow}"
                                                          IsEditable="True"
                                                          ItemsSource="{Binding $parent[Window].DataContext.PiperVoices}"
                                                          SelectedItem="{Binding DraftAssignedVoice, Mode=TwoWay}"
                                                          MinWidth="200"
                                                          FontSize="11"
                                                          PlaceholderText="Or select a downloaded Piper voice..."
                                                          ToolTip.Tip="Choose from downloaded Piper voices, or type a custom voice ID"/>
                                            </StackPanel>

                                            <!-- Reference Clip (Qwen) -->
                                            <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Spacing="6" Margin="0,0,0,8" IsVisible="{Binding ReferenceActionsEnabled}">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <TextBlock Text="Reference Clip" FontSize="11" FontWeight="Medium" Opacity="0.7"/>
                                                    <TextBlock Text="(for voice cloning - Qwen only)" FontSize="10" Opacity="0.4" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding EffectiveReferencePath, TargetNullValue='No clip selected - Qwen voice cloning will use default'}" 
                                                           TextWrapping="Wrap" FontSize="10" Opacity="0.6" FontFamily="Consolas,monospace"
                                                           ToolTip.Tip="Audio clip used as reference for Qwen voice cloning"/>

                                                <!-- Reference Actions -->
                                                <WrapPanel Orientation="Horizontal">
                                                    <Button Classes="action-btn" Tag="{Binding}" Click="OnPlayReferenceClick" Content="▶ Play" Margin="0,0,4,4"
                                                            ToolTip.Tip="Play the reference clip to preview the voice"/>
                                                    <Button Classes="action-btn" Tag="{Binding}" Click="OnRevealReferenceClick" Content="📁 Show" Margin="0,0,4,4"
                                                            ToolTip.Tip="Open the file location in explorer"/>
                                                    <Button Classes="action-btn" Tag="{Binding}" Click="OnBrowseFileClick" Content="Browse..." Margin="0,0,4,4"
                                                            ToolTip.Tip="Choose a custom audio file as reference"/>
                                                    <Button Classes="action-btn" Tag="{Binding}" Click="OnUseSelectedSegmentClick" Content="Use Segment" Margin="0,0,4,4"
                                                            ToolTip.Tip="Use the selected segment as reference (click a timestamp below first)"/>
                                                    <Button Classes="action-btn" Tag="{Binding}" Click="OnUsePlayheadClipClick" Content="Use Playhead" Margin="0,0,4,4"
                                                            ToolTip.Tip="Grab the current playhead position from the preview - easiest way to set reference!"/>
                                                    <Button Classes="action-btn" Tag="{Binding}" Click="OnAutoPickAnotherClick" Content="Auto-Pick" Margin="0,0,4,4"
                                                            ToolTip.Tip="Automatically find a good clip from this speaker's segments"/>
                                                </WrapPanel>
                                            </StackPanel>

                                            <!-- Segments -->
                                            <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3" Spacing="4" Margin="0,0,0,4">
                                                <TextBlock Text="Jump to speaker's segments" FontSize="10" Opacity="0.6"
                                                          ToolTip.Tip="Click a timestamp to jump to that point in the video, then use 'Use Playhead'"/>
                                                <WrapPanel Orientation="Horizontal">
                                                    <ItemsControl ItemsSource="{Binding SourceSegments}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <WrapPanel Orientation="Horizontal"/>
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="model:WorkflowSegmentState">
                                                                <Button Padding="6,3" FontSize="10" Margin="0,0,4,4" Click="OnJumpToSegmentClick" Tag="{Binding}" 
                                                                        ToolTip.Tip="{Binding SourceText, StringFormat='Click to jump to {0}'}">
                                                                    <TextBlock Text="{Binding StartSeconds, StringFormat='→ {0:F1}s'}"/>
                                                                </Button>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </WrapPanel>
                                            </StackPanel>

                                            <!-- Reason -->
                                            <TextBlock Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3"
                                                       Text="{Binding ConfidenceReasonSummary}"
                                                       TextWrapping="Wrap"
                                                       FontSize="10"
                                                       Opacity="0.5"
                                                       IsVisible="{Binding ReferenceActionsEnabled}"
                                                       Margin="0,0,0,4"
                                                       ToolTip.Tip="Why this clip was rated as good/poor"/>

                                            <!-- Error -->
                                            <TextBlock Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="3"
                                                       Text="{Binding InlineError}"
                                                       Foreground="{DynamicResource DestructiveFgBrush}"
                                                       FontSize="10"
                                                       TextWrapping="Wrap"
                                                       IsVisible="{Binding HasInlineError}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- Footer -->
        <Grid Grid.Row="3" ColumnDefinitions="Auto,*,Auto,Auto" Margin="0,14,0,0" ColumnSpacing="12">
            <Expander Grid.Column="0" Header="Advanced">
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="8,0,0,0">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Merge speakers" FontSize="10" Opacity="0.6"/>
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <ComboBox ItemsSource="{Binding SpeakerIdOptions}" SelectedItem="{Binding MergeSourceSpeakerId, Mode=TwoWay}" Width="100" FontSize="11"
                                      ToolTip.Tip="Select source speaker to merge"/>
                            <TextBlock Text="→" VerticalAlignment="Center" FontSize="12" Opacity="0.5"/>
                            <ComboBox ItemsSource="{Binding SpeakerIdOptions}" SelectedItem="{Binding MergeTargetSpeakerId, Mode=TwoWay}" Width="100" FontSize="11"
                                      ToolTip.Tip="Select target speaker (will receive the merged segments)"/>
                            <Button Command="{Binding MergeSpeakersCommand}" Content="Merge" Padding="10,6" FontSize="11"
                                    ToolTip.Tip="Merge source into target - this updates the transcript permanently"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Expander>
            
            <TextBlock Grid.Column="1"
                       Text="Finish saves voice and reference changes. Cancel discards all edits."
                       VerticalAlignment="Center"
                       FontSize="11"
                       Opacity="0.5"
                       TextWrapping="Wrap"
                       Margin="12,0"/>
            
            <Button Grid.Column="2"
                    Click="OnCancelClick"
                    Content="Cancel"
                    Padding="16,8"
                    FontSize="12"
                    ToolTip.Tip="Discard all changes and close"/>
            
            <Button Grid.Column="3"
                    Click="OnFinishClick"
                    Content="Finish"
                    Padding="16,8"
                    FontSize="12"
                    FontWeight="SemiBold"
                    ToolTip.Tip="Apply voice and reference changes to the session"/>
        </Grid>
    </Grid>
</Window>
