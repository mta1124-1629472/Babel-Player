<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Babel.Player.ViewModels"
        xmlns:model="using:Babel.Player.Models"
        xmlns:v="using:Babel.Player.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        x:Class="Babel.Player.Views.SpeakerReferenceWizardWindow"
        x:Name="WizardRoot"
        x:DataType="vm:SpeakerReferenceWizardViewModel"
        Title="Speaker Reference Wizard"
        Width="1100"
        Height="800"
        MinWidth="900"
        MinHeight="650"
        CanResize="True"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource PanelBackgroundBrush}">

    <Window.Styles>
        <Style Selector="Border.card">
            <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14"/>
        </Style>
        <Style Selector="Border.card:pointerover">
            <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}"/>
        </Style>
        <Style Selector="Button.action-btn">
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>
        <Style Selector="Button.primary-action">
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
        </Style>
        <Style Selector="TextBlock.section-header">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
        </Style>
    </Window.Styles>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,16">
            <TextBlock Text="Speaker Reference Wizard" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
            <TextBlock Text="Assign voices to speakers. Use the preview to find good audio clips for reference (Qwen only)." FontSize="12" Opacity="0.6" TextWrapping="Wrap"/>
        </StackPanel>

        <!-- Progress & Quick Actions -->
        <Border Grid.Row="1" Classes="card" Margin="0,0,0,14">
            <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,*,Auto">
                <!-- Status Badges -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                    <Border Background="{DynamicResource PositiveBrush}" CornerRadius="6" Padding="12,6">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="✓" FontSize="12" Foreground="{DynamicResource PositiveFgBrush}"/>
                            <TextBlock Text="{Binding GoodCount, StringFormat='Good ({0})'}" FontSize="12" Foreground="{DynamicResource PositiveFgBrush}" FontWeight="Medium"/>
                        </StackPanel>
                    </Border>
                    <Border Background="{DynamicResource InfoBrush}" CornerRadius="6" Padding="12,6">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="!" FontSize="12" Foreground="{DynamicResource InfoFgBrush}"/>
                            <TextBlock Text="{Binding ReviewCount, StringFormat='Review ({0})'}" FontSize="12" Foreground="{DynamicResource InfoFgBrush}" FontWeight="Medium"/>
                        </StackPanel>
                    </Border>
                    <Border Background="{DynamicResource DestructiveBrush}" CornerRadius="6" Padding="12,6">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="✗" FontSize="12" Foreground="{DynamicResource DestructiveFgBrush}"/>
                            <TextBlock Text="{Binding PoorCount, StringFormat='Poor ({0})'}" FontSize="12" Foreground="{DynamicResource DestructiveFgBrush}" FontWeight="Medium"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <CheckBox Grid.Column="1"
                          IsChecked="{Binding ShowLowConfidenceOnly, Mode=TwoWay}"
                          Content="Show needs attention"
                          VerticalAlignment="Center"
                          Margin="16,0,0,0"
                          FontSize="12"/>

                <Button Grid.Column="2"
                        Command="{Binding ResetAllCommand}"
                        Content="Reset All"
                        Padding="10,6"
                        Margin="12,0,0,0"
                        FontSize="11"/>

                <!-- Playhead Control -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="16,0,0,0">
                    <TextBlock Text="Clip:" VerticalAlignment="Center" FontSize="11" Opacity="0.6"/>
                    <Slider Width="100"
                            Minimum="3"
                            Maximum="15"
                            TickFrequency="1"
                            IsSnapToTickEnabled="True"
                            Value="{Binding PlayheadClipWindowSeconds, Mode=TwoWay}"
                            VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding PlayheadClipWindowSeconds, StringFormat='{}{0:F0}s'}" VerticalAlignment="Center" FontSize="11" MinWidth="28"/>
                    <Button Command="{Binding StopReferencePreviewCommand}" Content="⏹" Padding="8,4" ToolTip.Tip="Stop preview"/>
                </StackPanel>

                <TextBlock Grid.Column="5"
                           Text="{Binding StatusText}"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Right"
                           FontSize="11"
                           Opacity="0.6"/>
            </Grid>
        </Border>

        <!-- Main Content: Split View -->
        <Grid Grid.Row="2" ColumnDefinitions="340,*">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Left: Video Preview -->
            <Border Grid.Column="0" 
                    BorderBrush="{DynamicResource BorderBrush}" 
                    BorderThickness="1" 
                    CornerRadius="8"
                    Margin="0,0,12,0">
                <Grid RowDefinitions="Auto,*,Auto,Auto" RowSpacing="8">
                    <!-- Video Surface (Windows) -->
                    <Border Grid.Row="0" 
                            Background="#080810" 
                            CornerRadius="6,6,0,0"
                            IsVisible="{Binding MiniPreview.ShowVideoSurface}"
                            Height="200"
                            ClipToBounds="True">
                        <v:MpvVideoView x:Name="WizardVideoView"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Stretch"/>
                    </Border>

                    <!-- Non-Windows Hint -->
                    <Border Grid.Row="0" 
                            Background="{DynamicResource SurfaceSubtleBrush}" 
                            CornerRadius="6"
                            Padding="16"
                            IsVisible="{Binding MiniPreview.ShowNonWindowsHint}">
                        <StackPanel Spacing="8" VerticalAlignment="Center">
                            <TextBlock Text="Preview not available" FontSize="13" FontWeight="Medium" HorizontalAlignment="Center"/>
                            <TextBlock Text="Use the main window to scrub and select playhead clips on this platform." FontSize="11" Opacity="0.6" TextWrapping="Wrap" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Playback Controls -->
                    <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8" Margin="8,0" IsVisible="{Binding MiniPreview.ShowVideoSurface}" VerticalAlignment="Center">
                        <TextBlock Grid.Column="0"
                                   Text="{Binding MiniPreview.PositionFormatted}"
                                   FontSize="11"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource VideoOverlaySubtextBrush}"
                                   MinWidth="50"/>
                        <Slider Grid.Column="1"
                                Minimum="0"
                                Maximum="{Binding MiniPreview.DurationMs}"
                                Value="{Binding MiniPreview.PositionMs, Mode=TwoWay}"
                                IsEnabled="{Binding MiniPreview.HasLoadedMedia}"
                                VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2"
                                   Text="{Binding MiniPreview.DurationFormatted}"
                                   FontSize="11"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource VideoOverlaySubtextBrush}"
                                   MinWidth="50"
                                   TextAlignment="Right"/>
                        <Button Grid.Column="3"
                                Command="{Binding MiniPreview.ToggleMiniPlaybackCommand}"
                                Content="{Binding MiniPreview.MiniPlayPauseLabel}"
                                Padding="12,6"
                                FontSize="11"
                                FontWeight="Medium"/>
                    </Grid>

                    <!-- Status Hint -->
                    <TextBlock Grid.Row="2"
                               Text="{Binding MiniPreview.StatusHint}"
                               FontSize="10"
                               Foreground="{DynamicResource DestructiveFgBrush}"
                               TextWrapping="Wrap"
                               Margin="8,4"
                               IsVisible="{Binding MiniPreview.HasStatusHint}"/>

                    <!-- Piper Voices (Collapsible) -->
                    <Expander Grid.Row="3" Header="Download Piper Voices" IsExpanded="False" Margin="8,8,8,8" IsVisible="{Binding ShowPiperVoicePicker}">
                        <ScrollViewer MaxHeight="120" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding PiperVoiceCatalogRows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:PiperVoiceCatalogRowViewModel">
                                        <Border Margin="0,0,0,4" Padding="8,6" Background="{DynamicResource SurfaceSubtleBrush}" CornerRadius="4">
                                            <Grid ColumnDefinitions="*,Auto,Auto">
                                                <TextBlock Grid.Column="0" Text="{Binding Title}" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" Margin="8,0">
                                                    <TextBlock Text="{Binding StatusLabel}" FontSize="10" Opacity="0.6"/>
                                                    <ProgressBar Value="{Binding DownloadProgress}" Minimum="0" Maximum="1" Width="40" Height="2" IsVisible="{Binding IsProgressVisible}"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
                                                    <Button Content="⬇" IsVisible="{Binding CanDownload}" Command="{Binding DownloadCommand}" Padding="6,3" FontSize="10"/>
                                                    <Button Content="✕" IsVisible="{Binding CanCancel}" Command="{Binding CancelCommand}" Padding="6,3" FontSize="10"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Expander>
                </Grid>
            </Border>

            <!-- Right: Speaker Cards -->
            <Border Grid.Column="1" 
                    BorderBrush="{DynamicResource BorderBrush}" 
                    BorderThickness="1" 
                    CornerRadius="8">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding VisibleDraftItems}" Margin="4">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="model:SpeakerReferenceDraftItem">
                                <Border Margin="4" Padding="14" Background="{DynamicResource ControlBackgroundBrush}" CornerRadius="8">
                                    <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" ColumnDefinitions="Auto,*,Auto">
                                        <!-- Speaker Header -->
                                        <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="10" Margin="0,0,0,8">
                                            <TextBlock Text="{Binding SpeakerId}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                                            <Border Background="{Binding ConfidenceTier, Converter={x:Static converters:SpeakerConfidenceTierConverter.Instance}}" CornerRadius="4" Padding="8,3" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding ConfidenceTier}" FontSize="10" FontWeight="Medium"/>
                                            </Border>
                                            <TextBlock Text="{Binding LastActionLabel}" FontSize="11" Opacity="0.5" VerticalAlignment="Center"/>
                                        </StackPanel>

                                        <!-- Voice Assignment -->
                                        <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Spacing="8" Margin="0,0,0,10">
                                            <TextBlock Text="Voice" FontSize="11" FontWeight="Medium" Opacity="0.7"/>
                                            <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="6">
                                                <TextBlock Grid.Column="0" Text="{Binding EffectiveAssignedVoice, TargetNullValue='None'}" FontSize="12" VerticalAlignment="Center"/>
                                                <Button Grid.Column="1" Classes="action-btn" Tag="{Binding}" Click="OnKeepAutoClick" Content="Auto"/>
                                                <Button Grid.Column="2" Classes="action-btn" Tag="{Binding}" Click="OnUseActiveTtsVoiceClick" Content="Use Active"/>
                                                <Button Grid.Column="3" Classes="action-btn" Tag="{Binding}" Click="OnClearVoiceClick" Content="Clear"/>
                                            </Grid>
                                            <ComboBox IsVisible="{Binding ShowPiperVoiceRow}"
                                                      IsEditable="True"
                                                      ItemsSource="{Binding $parent[Window].DataContext.PiperVoices}"
                                                      SelectedItem="{Binding DraftAssignedVoice, Mode=TwoWay}"
                                                      MinWidth="200"
                                                      FontSize="11"
                                                      PlaceholderText="Or select a Piper voice..."/>
                                        </StackPanel>

                                        <!-- Reference Clip (Qwen) -->
                                        <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Spacing="6" Margin="0,0,0,8" IsVisible="{Binding ReferenceActionsEnabled}">
                                            <TextBlock Text="Reference Clip" FontSize="11" FontWeight="Medium" Opacity="0.7"/>
                                            <TextBlock Text="{Binding EffectiveReferencePath, TargetNullValue='No clip selected'}" TextWrapping="Wrap" FontSize="10" Opacity="0.6" FontFamily="Consolas,monospace"/>
                                            
                                            <!-- Reference Actions -->
                                            <WrapPanel Orientation="Horizontal">
                                                <Button Classes="action-btn" Tag="{Binding}" Click="OnPlayReferenceClick" Content="▶ Play" Margin="0,0,4,4"/>
                                                <Button Classes="action-btn" Tag="{Binding}" Click="OnRevealReferenceClick" Content="📁 Show" Margin="0,0,4,4"/>
                                                <Button Classes="action-btn" Tag="{Binding}" Click="OnBrowseFileClick" Content="Browse..." Margin="0,0,4,4"/>
                                                <Button Classes="action-btn" Tag="{Binding}" Click="OnUseSelectedSegmentClick" Content="Use Segment" Margin="0,0,4,4"/>
                                                <Button Classes="action-btn" Tag="{Binding}" Click="OnUsePlayheadClipClick" Content="Use Playhead" Margin="0,0,4,4"/>
                                                <Button Classes="action-btn" Tag="{Binding}" Click="OnAutoPickAnotherClick" Content="Auto-Pick" Margin="0,0,4,4"/>
                                            </WrapPanel>
                                        </StackPanel>

                                        <!-- Segments -->
                                        <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3" Spacing="4" Margin="0,0,0,4">
                                            <TextBlock Text="Jump to segment" FontSize="10" Opacity="0.6"/>
                                            <WrapPanel Orientation="Horizontal">
                                                <ItemsControl ItemsSource="{Binding SourceSegments}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <WrapPanel Orientation="Horizontal"/>
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="model:WorkflowSegmentState">
                                                            <Button Padding="6,3" FontSize="10" Margin="0,0,4,4" Click="OnJumpToSegmentClick" Tag="{Binding}" ToolTip.Tip="{Binding SourceText}">
                                                                <TextBlock Text="{Binding StartSeconds, StringFormat='→ {0:F1}s'}"/>
                                                            </Button>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </WrapPanel>
                                        </StackPanel>

                                        <!-- Reason -->
                                        <TextBlock Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3"
                                                   Text="{Binding ConfidenceReasonSummary}"
                                                   TextWrapping="Wrap"
                                                   FontSize="10"
                                                   Opacity="0.5"
                                                   IsVisible="{Binding ReferenceActionsEnabled}"
                                                   Margin="0,0,0,4"/>

                                        <!-- Error -->
                                        <TextBlock Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="3"
                                                   Text="{Binding InlineError}"
                                                   Foreground="{DynamicResource DestructiveFgBrush}"
                                                   FontSize="10"
                                                   TextWrapping="Wrap"
                                                   IsVisible="{Binding HasInlineError}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Footer -->
        <Grid Grid.Row="3" ColumnDefinitions="Auto,*,Auto,Auto" Margin="0,14,0,0" ColumnSpacing="12">
            <Expander Grid.Column="0" Header="Advanced">
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="8,0,0,0">
                    <ComboBox ItemsSource="{Binding SpeakerIdOptions}" SelectedItem="{Binding MergeSourceSpeakerId, Mode=TwoWay}" Width="120" FontSize="11"/>
                    <TextBlock Text="→" VerticalAlignment="Center" FontSize="12" Opacity="0.5"/>
                    <ComboBox ItemsSource="{Binding SpeakerIdOptions}" SelectedItem="{Binding MergeTargetSpeakerId, Mode=TwoWay}" Width="120" FontSize="11"/>
                    <Button Command="{Binding MergeSpeakersCommand}" Content="Merge Speakers" Padding="10,6" FontSize="11"/>
                </StackPanel>
            </Expander>
            
            <TextBlock Grid.Column="1"
                       Text="Finish saves voice and reference changes. Cancel discards all edits."
                       VerticalAlignment="Center"
                       FontSize="11"
                       Opacity="0.5"
                       TextWrapping="Wrap"
                       Margin="12,0"/>
            
            <Button Grid.Column="2"
                    Click="OnCancelClick"
                    Content="Cancel"
                    Padding="16,8"
                    FontSize="12"/>
            
            <Button Grid.Column="3"
                    Click="OnFinishClick"
                    Content="Finish"
                    Padding="16,8"
                    FontSize="12"
                    FontWeight="SemiBold"/>
        </Grid>
    </Grid>
</Window>
