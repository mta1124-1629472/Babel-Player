<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Babel.Player.ViewModels"
        xmlns:model="using:Babel.Player.Models"
        xmlns:v="using:Babel.Player.Views"
        xmlns:chrome="using:Avalonia.Controls.Chrome"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        x:Class="Babel.Player.Views.SpeakerReferenceWizardWindow"
        x:Name="WizardRoot"
        x:DataType="vm:SpeakerReferenceWizardViewModel"
        Title="{local:Localize Window_Title_Wizard}"
        Width="1100"
        Height="800"
        MinWidth="900"
        MinHeight="650"
        CanResize="True"
        WindowDecorations="None"
        ExtendClientAreaToDecorationsHint="True"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource PanelBackgroundBrush}"
        xmlns:local="using:Babel.Player.Converters">

    <Window.Styles>
        <Style Selector="Border.top-chrome">
            <Setter Property="Height" Value="32" />
            <Setter Property="ClipToBounds" Value="True" />
        </Style>
        <Style Selector="Border.card">
            <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14"/>
        </Style>
        <Style Selector="Border.card:pointerover">
            <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}"/>
        </Style>
        <Style Selector="Button.action-btn">
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}"/>
        </Style>
        <Style Selector="Button.primary-action">
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="FontSize" Value="{DynamicResource FontSizeTitle}"/>
            <Setter Property="FontWeight" Value="Medium"/>
        </Style>
        <Style Selector="TextBlock.section-header">
            <Setter Property="FontSize" Value="{DynamicResource FontSizeTitle}"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
        </Style>
        <Style Selector="TextBlock.help-text">
            <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}"/>
            <Setter Property="Opacity" Value="0.55"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="6,*,6" ColumnDefinitions="6,*,6">
        <Panel Grid.Row="0" Grid.Column="0" Width="6" Height="6" Background="Transparent"
               chrome:WindowDecorationProperties.ElementRole="ResizeNW" />
        <Panel Grid.Row="0" Grid.Column="1" Height="6" Background="Transparent"
               chrome:WindowDecorationProperties.ElementRole="ResizeN" />
        <Panel Grid.Row="0" Grid.Column="2" Width="6" Height="6" Background="Transparent"
               chrome:WindowDecorationProperties.ElementRole="ResizeNE" />
        <Panel Grid.Row="1" Grid.Column="0" Width="6" Background="Transparent"
               chrome:WindowDecorationProperties.ElementRole="ResizeW" />
        <Panel Grid.Row="1" Grid.Column="2" Width="6" Background="Transparent"
               chrome:WindowDecorationProperties.ElementRole="ResizeE" />
        <Panel Grid.Row="2" Grid.Column="0" Width="6" Height="6" Background="Transparent"
               chrome:WindowDecorationProperties.ElementRole="ResizeSW" />
        <Panel Grid.Row="2" Grid.Column="1" Height="6" Background="Transparent"
               chrome:WindowDecorationProperties.ElementRole="ResizeS" />
        <Panel Grid.Row="2" Grid.Column="2" Width="6" Height="6" Background="Transparent"
               chrome:WindowDecorationProperties.ElementRole="ResizeSE" />

        <Grid Grid.Row="1" Grid.Column="1" RowDefinitions="Auto,*">
            <!-- Title bar: match MainWindow chrome (drag, minimize, maximize, close) -->
            <Border Grid.Row="0"
                    Classes="top-chrome"
                    Background="{DynamicResource SurfaceSubtleBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="10,0,0,0"
                    PointerPressed="OnTitleBarPointerPressed"
                    chrome:WindowDecorationProperties.ElementRole="TitleBar">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                    <TextBlock Grid.Column="0"
                               Classes="text-title"
                               Text="{local:Localize Window_Title_Wizard}"
                               Foreground="{DynamicResource PrimaryTextBrush}"
                               VerticalAlignment="Center" />
                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal"
                                Spacing="0"
                                VerticalAlignment="Stretch"
                                HorizontalAlignment="Right"
                                UseLayoutRounding="True">
                        <Button Classes="chrome-button"
                                Width="32"
                                Height="32"
                                Background="{DynamicResource ButtonBackgroundBrush}"
                                Foreground="{DynamicResource PrimaryTextBrush}"
                                Click="OnMinimizeWindowClick"
                                AutomationProperties.Name="{local:Localize Chrome_Minimize}">
                            <Viewbox Width="14" Height="14">
                                <Canvas Width="24" Height="24">
                                    <Border Canvas.Left="4"
                                            Canvas.Top="11"
                                            Width="16"
                                            Height="2.5"
                                            Background="{DynamicResource PrimaryTextBrush}"
                                            CornerRadius="1" />
                                </Canvas>
                            </Viewbox>
                        </Button>
                        <Button Classes="chrome-button"
                                Width="32"
                                Height="32"
                                Background="{DynamicResource ButtonBackgroundBrush}"
                                Foreground="{DynamicResource PrimaryTextBrush}"
                                Click="OnToggleMaximizeWindowClick"
                                AutomationProperties.Name="{local:Localize Chrome_MaximizeRestore}">
                            <Grid Width="24" Height="24">
                                <Viewbox x:Name="ChromeMaximizeIcon"
                                         Width="14"
                                         Height="14"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center">
                                    <Canvas Width="24" Height="24">
                                        <Rectangle Canvas.Left="5.5"
                                                   Canvas.Top="5.5"
                                                   Width="13"
                                                   Height="13"
                                                   Stroke="{DynamicResource PrimaryTextBrush}"
                                                   StrokeThickness="1.75"
                                                   Fill="Transparent" />
                                    </Canvas>
                                </Viewbox>
                                <Viewbox x:Name="ChromeRestoreIcon"
                                         Width="14"
                                         Height="14"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center"
                                         IsVisible="False">
                                    <Canvas Width="24" Height="24">
                                        <Rectangle Canvas.Left="9"
                                                   Canvas.Top="5"
                                                   Width="9"
                                                   Height="9"
                                                   Stroke="{DynamicResource PrimaryTextBrush}"
                                                   StrokeThickness="1.75"
                                                   Fill="Transparent" />
                                        <Rectangle Canvas.Left="5"
                                                   Canvas.Top="9"
                                                   Width="9"
                                                   Height="9"
                                                   Stroke="{DynamicResource PrimaryTextBrush}"
                                                   StrokeThickness="1.75"
                                                   Fill="Transparent" />
                                    </Canvas>
                                </Viewbox>
                            </Grid>
                        </Button>
                        <Button Classes="chrome-button chrome-close"
                                Width="32"
                                Height="32"
                                Background="{DynamicResource DestructiveBrush}"
                                Foreground="{DynamicResource PrimaryTextBrush}"
                                Click="OnCancelClick"
                                ToolTip.Tip="{local:Localize Wizard_Tooltip_CloseDiscard}"
                                AutomationProperties.Name="{local:Localize Wizard_Tooltip_Close}">
                            <Viewbox Width="14" Height="14">
                                <Canvas Width="24" Height="24">
                                    <Path Stroke="{DynamicResource PrimaryTextBrush}"
                                          StrokeThickness="1.75"
                                          StrokeLineCap="Round"
                                          Stretch="None"
                                          Data="M 6.5,6.5 L 17.5,17.5 M 17.5,6.5 L 6.5,17.5" />
                                </Canvas>
                            </Viewbox>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

    <Grid Grid.Row="1" Margin="18,14,18,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Intro -->
        <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,16">
            <TextBlock Text="{local:Localize Wizard_Hint_TopBanner}" Classes="text-secondary" Opacity="0.6" TextWrapping="Wrap"/>
        </StackPanel>

        <!-- Progress & Quick Actions -->
        <Border Grid.Row="1" Classes="card" Margin="0,0,0,14">
            <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto">
                <!-- Status Badges -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                    <Border Background="{DynamicResource PositiveBrush}" CornerRadius="6" Padding="12,6">
                        <TextBlock Text="{Binding GoodCount, StringFormat='Good ({0})'}" Classes="text-secondary" Foreground="{DynamicResource PositiveFgBrush}" FontWeight="Medium"/>
                    </Border>
                    <Border Background="{DynamicResource InfoBrush}" CornerRadius="6" Padding="12,6">
                        <TextBlock Text="{Binding ReviewCount, StringFormat='Review ({0})'}" Classes="text-secondary" Foreground="{DynamicResource InfoFgBrush}" FontWeight="Medium"/>
                    </Border>
                    <Border Background="{DynamicResource DestructiveBrush}" CornerRadius="6" Padding="12,6">
                        <TextBlock Text="{Binding PoorCount, StringFormat='Poor ({0})'}" Classes="text-secondary" Foreground="{DynamicResource DestructiveFgBrush}" FontWeight="Medium"/>
                    </Border>
                </StackPanel>

                <CheckBox Grid.Column="1"
                          IsChecked="{Binding ShowLowConfidenceOnly, Mode=TwoWay}"
                          Content="{local:Localize Wizard_Toggle_NeedsAttention}"
                          VerticalAlignment="Center"
                          Margin="16,0,0,0"
                          ToolTip.Tip="{local:Localize Wizard_Tooltip_NeedsAttention}"/>

                <Button Grid.Column="2"
                        Command="{Binding ResetAllCommand}"
                        Content="{local:Localize Wizard_Button_ResetAll}"
                        Padding="10,6"
                        Margin="12,0,0,0"
                        ToolTip.Tip="{local:Localize Wizard_Tooltip_ResetAll}"/>

                <TextBlock Grid.Column="4"
                           Text="{Binding StatusText}"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Right"
                           Classes="text-caption"
                           Opacity="0.6"/>
            </Grid>
        </Border>

        <!-- Main Content: Split View -->
        <Grid Grid.Row="2" ColumnDefinitions="340,*">
            <!-- Left: Video Preview -->
            <Border Grid.Column="0" 
                    BorderBrush="{DynamicResource BorderBrush}" 
                    BorderThickness="1" 
                    CornerRadius="8"
                    Margin="0,0,12,0">
                <Grid RowDefinitions="Auto,*,Auto,Auto,Auto">
                    <!-- Header with instructions -->
                    <StackPanel Grid.Row="0" Margin="12,12,12,8">
                        <TextBlock Text="{local:Localize Wizard_Preview_Header}" Classes="text-title" Foreground="{DynamicResource PrimaryTextBrush}"/>
                        <TextBlock Text="{local:Localize Wizard_Hint_ScrubPreview}" Classes="text-micro" Opacity="0.5" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    </StackPanel>

                    <!-- Video Surface (Windows) -->
                    <Border Grid.Row="1" 
                            Background="#080810" 
                            CornerRadius="6"
                            Margin="8,0"
                            IsVisible="{Binding MiniPreview.ShowVideoSurface}"
                            ClipToBounds="True">
                        <v:MpvVideoView x:Name="WizardVideoView"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Stretch"/>
                    </Border>

                    <!-- Non-Windows Hint -->
                    <Border Grid.Row="1" 
                            Background="{DynamicResource SurfaceSubtleBrush}" 
                            CornerRadius="6"
                            Padding="16"
                            Margin="8,0"
                            IsVisible="{Binding MiniPreview.ShowNonWindowsHint}">
                        <StackPanel Spacing="8" VerticalAlignment="Center">
                            <TextBlock Text="{local:Localize Wizard_Preview_Unavailable}" Classes="text-emphasis" HorizontalAlignment="Center"/>
                            <TextBlock Text="{local:Localize Wizard_Hint_LinuxMacFallback}" Classes="text-micro" Opacity="0.6" TextWrapping="Wrap" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Playback Controls -->
                    <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8" Margin="12,8" IsVisible="{Binding MiniPreview.ShowVideoSurface}" VerticalAlignment="Center">
                        <TextBlock Grid.Column="0"
                                   Text="{Binding MiniPreview.PositionFormatted}"
                                   Classes="text-caption"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource VideoOverlaySubtextBrush}"
                                   MinWidth="50"/>
                        <Slider Grid.Column="1"
                                Minimum="0"
                                Maximum="{Binding MiniPreview.DurationMs}"
                                Value="{Binding MiniPreview.PositionMs, Mode=TwoWay}"
                                IsEnabled="{Binding MiniPreview.HasLoadedMedia}"
                                VerticalAlignment="Center"
                                ToolTip.Tip="{local:Localize Wizard_Tooltip_SeekSlider}"/>
                        <TextBlock Grid.Column="2"
                                   Text="{Binding MiniPreview.DurationFormatted}"
                                   Classes="text-caption"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource VideoOverlaySubtextBrush}"
                                   MinWidth="50"
                                   TextAlignment="Right"/>
                        <Button Grid.Column="3"
                                Command="{Binding MiniPreview.ToggleMiniPlaybackCommand}"
                                Content="{Binding MiniPreview.MiniPlayPauseLabel}"
                                Padding="12,6"
                                FontWeight="Medium"
                                ToolTip.Tip="{local:Localize Wizard_Tooltip_PlayPause}"/>
                    </Grid>

                    <!-- Status Hint -->
                    <TextBlock Grid.Row="4"
                               Text="{Binding MiniPreview.StatusHint}"
                               Classes="text-micro"
                               Foreground="{DynamicResource DestructiveFgBrush}"
                               TextWrapping="Wrap"
                               Margin="12,4,12,12"
                               IsVisible="{Binding MiniPreview.HasStatusHint}"/>

                    <!-- Playhead Clip Settings -->
                    <Border Grid.Row="3" Classes="card" Margin="8,8,8,12" IsVisible="{Binding MiniPreview.ShowVideoSurface}">
                        <StackPanel Spacing="6">
                            <TextBlock Text="{local:Localize Wizard_Label_ClipDuration}" Classes="text-label" ToolTip.Tip="{local:Localize Wizard_Tooltip_ClipDuration}"/>
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                <Slider Grid.Column="0"
                                        Width="100"
                                        Minimum="3"
                                        Maximum="15"
                                        TickFrequency="1"
                                        IsSnapToTickEnabled="True"
                                        Value="{Binding PlayheadClipWindowSeconds, Mode=TwoWay}"
                                        VerticalAlignment="Center"
                                        ToolTip.Tip="{local:Localize Wizard_Playhead_Clip_Tooltip}"/>
                                <TextBlock Grid.Column="1" Text="{Binding PlayheadClipWindowSeconds, StringFormat='{}{0:F0} seconds'}" VerticalAlignment="Center" Classes="text-caption" Opacity="0.7"/>
                                <Button Grid.Column="2" Command="{Binding StopReferencePreviewCommand}" Content="{local:Localize Wizard_Button_Stop}" Padding="8,4" Classes="control-pill"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Right: Speaker Cards -->
            <Border Grid.Column="1" 
                    BorderBrush="{DynamicResource BorderBrush}" 
                    BorderThickness="1" 
                    CornerRadius="8">
                <Grid RowDefinitions="Auto,*">
                    <!-- Header -->
                    <StackPanel Grid.Row="0" Margin="14,14,14,8">
                        <TextBlock Text="{local:Localize Wizard_Assign_Header}" Classes="text-title" Foreground="{DynamicResource PrimaryTextBrush}"/>
                        <TextBlock Text="{local:Localize Wizard_Assign_Hint}" Classes="text-micro" Opacity="0.5" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    </StackPanel>

                    <!-- Speaker List -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding VisibleDraftItems}" Margin="4">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="model:SpeakerReferenceDraftItem">
                                    <Border Margin="4" Padding="14" Background="{DynamicResource ControlBackgroundBrush}" CornerRadius="8">
                                        <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" ColumnDefinitions="Auto,*,Auto">
                                            <!-- Speaker Header -->
                                            <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="10" Margin="0,0,0,10">
                                                <TextBlock Text="{Binding SpeakerId}" Classes="text-display" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                                                <Border Background="{DynamicResource InfoBrush}" CornerRadius="4" Padding="8,3" VerticalAlignment="Center"
                                                        ToolTip.Tip="{local:Localize Wizard_Tooltip_ConfidenceTier}">
                                                    <TextBlock Text="{Binding ConfidenceTier}" Classes="text-micro" FontWeight="Medium" Foreground="{DynamicResource InfoFgBrush}"/>
                                                </Border>
                                                <TextBlock Text="{Binding LastActionLabel}" Classes="text-caption" Opacity="0.5" VerticalAlignment="Center"
                                                           ToolTip.Tip="{local:Localize Wizard_Tooltip_LastAction}"/>
                                            </StackPanel>

                                            <!-- Voice Assignment -->
                                            <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Spacing="8" Margin="0,0,0,10">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <TextBlock Text="{local:Localize Wizard_Label_Voice}" Classes="text-label" Opacity="0.7"/>
                                                    <TextBlock Text="{local:Localize Wizard_Label_VoiceHelp}" Classes="text-micro" Opacity="0.4" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="6">
                                                    <TextBlock Grid.Column="0" Text="{Binding EffectiveAssignedVoice, TargetNullValue='None'}" Classes="text-secondary" VerticalAlignment="Center"/>
                                                    <Button Grid.Column="1" Classes="action-btn" Tag="{Binding}" Click="OnKeepAutoClick" Content="{local:Localize Wizard_Button_Auto}"
                                                            ToolTip.Tip="{local:Localize Wizard_Tooltip_Auto}"/>
                                                    <Button Grid.Column="2" Classes="action-btn" Tag="{Binding}" Click="OnUseActiveTtsVoiceClick" Content="{local:Localize Wizard_Button_UseActive}"
                                                            ToolTip.Tip="{local:Localize Wizard_Tooltip_UseActive}"/>
                                                    <Button Grid.Column="3" Classes="action-btn" Tag="{Binding}" Click="OnClearVoiceClick" Content="{local:Localize Common_Clear}"
                                                            ToolTip.Tip="{local:Localize Wizard_Tooltip_ClearVoice}"/>
                                                </Grid>
                                                <ComboBox IsVisible="{Binding ShowPiperVoiceRow}"
                                                          IsEditable="True"
                                                          ItemsSource="{Binding $parent[Window].DataContext.PiperVoices}"
                                                          SelectedItem="{Binding DraftAssignedVoice, Mode=TwoWay}"
                                                          MinWidth="200"
                                                          PlaceholderText="{local:Localize Wizard_Placeholder_PiperVoice}"
                                                          ToolTip.Tip="{local:Localize Wizard_Tooltip_PiperVoice}"/>
                                            </StackPanel>

                                            <!-- Reference Clip (Qwen) -->
                                            <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Spacing="6" Margin="0,0,0,8" IsVisible="{Binding ReferenceActionsEnabled}">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <TextBlock Text="{local:Localize Wizard_Label_ReferenceClip}" Classes="text-label" Opacity="0.7"/>
                                                    <TextBlock Text="{local:Localize Wizard_Label_ReferenceClipHelp}" Classes="text-micro" Opacity="0.4" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding EffectiveReferencePath, TargetNullValue='No clip selected - Qwen voice cloning will use default'}" 
                                                           TextWrapping="Wrap" Classes="text-micro" Opacity="0.6" FontFamily="{DynamicResource UiMonoFontFamily}"
                                                           ToolTip.Tip="{local:Localize Wizard_Tooltip_RefPath}"/>

                                                <!-- Reference Actions -->
                                                <WrapPanel Orientation="Horizontal">
                                                    <Button Classes="action-btn" Tag="{Binding}" Click="OnPlayReferenceClick" Content="{local:Localize Wizard_Button_Play}" Margin="0,0,4,4"/>
                                                    <Button Classes="action-btn" Tag="{Binding}" Click="OnRevealReferenceClick" Content="{local:Localize Wizard_Button_Show}" Margin="0,0,4,4"/>
                                                    <Button Classes="action-btn" Tag="{Binding}" Click="OnBrowseFileClick" Content="{local:Localize Common_Browse}" Margin="0,0,4,4"/>
                                                    <Button Classes="action-btn" Tag="{Binding}" Click="OnUseSelectedSegmentClick" Content="{local:Localize Wizard_Button_UseSegment}" Margin="0,0,4,4"
                                                            ToolTip.Tip="{local:Localize Wizard_Tooltip_UseSegment}"/>
                                                    <Button Classes="action-btn" Tag="{Binding}" Click="OnUsePlayheadClipClick" Content="{local:Localize Wizard_Button_UsePlayhead}" Margin="0,0,4,4"
                                                            ToolTip.Tip="{local:Localize Wizard_Tooltip_UsePlayhead}"/>
                                                    <Button Classes="action-btn" Tag="{Binding}" Click="OnAutoPickAnotherClick" Content="{local:Localize Wizard_Button_AutoPick}" Margin="0,0,4,4"
                                                            ToolTip.Tip="{local:Localize Wizard_Tooltip_AutoPick}"/>
                                                </WrapPanel>
                                            </StackPanel>

                                            <!-- Segments -->
                                            <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3" Spacing="4" Margin="0,0,0,4">
                                                <TextBlock Text="{local:Localize Wizard_Hint_JumpToSegments}" Classes="text-micro" Opacity="0.6"
                                                          ToolTip.Tip="{local:Localize Wizard_Tooltip_JumpToSegments}"/>
                                                <WrapPanel Orientation="Horizontal">
                                                    <ItemsControl ItemsSource="{Binding SourceSegments}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <WrapPanel Orientation="Horizontal"/>
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="model:WorkflowSegmentState">
                                                                <Button Padding="6,3" Classes="control-pill" Margin="0,0,4,4" Click="OnJumpToSegmentClick" Tag="{Binding}" 
                                                                        ToolTip.Tip="{Binding SourceText, StringFormat='Click to jump to {0}'}">
                                                                    <TextBlock Text="{Binding StartSeconds, StringFormat='→ {0:F1}s'}"/>
                                                                </Button>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </WrapPanel>
                                            </StackPanel>

                                            <!-- Reason -->
                                            <TextBlock Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3"
                                                       Text="{Binding ConfidenceReasonSummary}"
                                                       TextWrapping="Wrap"
                                                       Classes="text-micro"
                                                       Opacity="0.5"
                                                       IsVisible="{Binding ReferenceActionsEnabled}"
                                                       Margin="0,0,0,4"
                                                       ToolTip.Tip="{local:Localize Wizard_Tooltip_ConfidenceReason}"/>

                                            <!-- Error -->
                                            <TextBlock Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="3"
                                                       Text="{Binding InlineError}"
                                                       Foreground="{DynamicResource DestructiveFgBrush}"
                                                       Classes="text-micro"
                                                       TextWrapping="Wrap"
                                                       IsVisible="{Binding HasInlineError}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- Footer -->
        <Grid Grid.Row="3" ColumnDefinitions="Auto,*,Auto,Auto" Margin="0,14,0,0" ColumnSpacing="12">
            <Expander Grid.Column="0" Header="{local:Localize Wizard_Expander_Advanced}">
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="8,0,0,0">
                    <StackPanel Spacing="4">
                        <TextBlock Text="{local:Localize Wizard_Label_MergeSpeakers}" Classes="text-micro" Opacity="0.6"/>
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <ComboBox ItemsSource="{Binding SpeakerIdOptions}" SelectedItem="{Binding MergeSourceSpeakerId, Mode=TwoWay}" Width="100"
                                      ToolTip.Tip="{local:Localize Wizard_Tooltip_MergeSource}"/>
                            <TextBlock Text="→" VerticalAlignment="Center" Classes="text-secondary" Opacity="0.5"/>
                            <ComboBox ItemsSource="{Binding SpeakerIdOptions}" SelectedItem="{Binding MergeTargetSpeakerId, Mode=TwoWay}" Width="100"
                                      ToolTip.Tip="{local:Localize Wizard_Tooltip_MergeTarget}"/>
                            <Button Command="{Binding MergeSpeakersCommand}" Content="{local:Localize Wizard_Button_Merge}" Padding="10,6"
                                    ToolTip.Tip="{local:Localize Wizard_Tooltip_Merge}"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Expander>
            
            <TextBlock Grid.Column="1"
                       Text="{local:Localize Wizard_Footer_Hint}"
                       VerticalAlignment="Center"
                       Classes="text-caption"
                       Opacity="0.5"
                       TextWrapping="Wrap"
                       Margin="12,0"/>
            
            <Button Grid.Column="2"
                    Click="OnCancelClick"
                    Content="{local:Localize Common_Cancel}"
                    Padding="16,8"
                    ToolTip.Tip="{local:Localize Wizard_Tooltip_Cancel}"/>
            
            <Button Grid.Column="3"
                    Click="OnFinishClick"
                    Content="{local:Localize Wizard_Button_Finish}"
                    Padding="16,8"
                    FontWeight="Medium"
                    ToolTip.Tip="{local:Localize Wizard_Tooltip_Finish}"/>
        </Grid>
    </Grid>
        </Grid>
    </Grid>
</Window>
