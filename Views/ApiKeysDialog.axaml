<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Babel.Player.ViewModels"
        xmlns:chrome="using:Avalonia.Controls.Chrome"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="480" d:DesignHeight="360"
        x:Class="Babel.Player.Views.ApiKeysDialog"
        x:DataType="vm:ApiKeysViewModel"
        Title="{local:Localize Window_Title_ApiKeys}"
        Width="480" SizeToContent="Height"
        MinWidth="420"
        MinHeight="320"
        Background="{DynamicResource PanelBackgroundBrush}"
        CanResize="True"
        WindowDecorations="None"
        ExtendClientAreaToDecorationsHint="True"
        WindowStartupLocation="CenterOwner"
        xmlns:local="using:Babel.Player.Converters">

    <Window.Styles>
        <Style Selector="Border.top-chrome">
            <Setter Property="Height" Value="32" />
            <Setter Property="ClipToBounds" Value="True" />
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,*">
        <!-- Title bar: match MainWindow chrome -->
        <Border Grid.Row="0"
                Classes="top-chrome"
                Background="{DynamicResource SurfaceSubtleBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="10,0,0,0"
                PointerPressed="OnTitleBarPointerPressed"
                chrome:WindowDecorationProperties.ElementRole="TitleBar">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                <TextBlock Grid.Column="0"
                           Classes="text-title"
                           Text="{local:Localize Window_Title_ApiKeys}"
                           Foreground="{DynamicResource PrimaryTextBrush}"
                           VerticalAlignment="Center" />
                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            Spacing="0"
                            VerticalAlignment="Stretch"
                            HorizontalAlignment="Right"
                            UseLayoutRounding="True">
                    <Button Classes="chrome-button"
                            Width="32"
                            Height="32"
                            Background="{DynamicResource ButtonBackgroundBrush}"
                            Foreground="{DynamicResource PrimaryTextBrush}"
                            Click="OnMinimizeWindowClick"
                            AutomationProperties.Name="{local:Localize Chrome_Minimize}">
                        <Viewbox Width="14" Height="14">
                            <Canvas Width="24" Height="24">
                                <Border Canvas.Left="4"
                                        Canvas.Top="11"
                                        Width="16"
                                        Height="2.5"
                                        Background="{DynamicResource PrimaryTextBrush}"
                                        CornerRadius="1" />
                            </Canvas>
                        </Viewbox>
                    </Button>
                    <Button Classes="chrome-button"
                            Width="32"
                            Height="32"
                            Background="{DynamicResource ButtonBackgroundBrush}"
                            Foreground="{DynamicResource PrimaryTextBrush}"
                            Click="OnToggleMaximizeWindowClick"
                            AutomationProperties.Name="{local:Localize Chrome_MaximizeRestore}">
                        <Grid Width="24" Height="24">
                            <Viewbox x:Name="ChromeMaximizeIcon"
                                     Width="14"
                                     Height="14"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center">
                                <Canvas Width="24" Height="24">
                                    <Rectangle Canvas.Left="5.5"
                                               Canvas.Top="5.5"
                                               Width="13"
                                               Height="13"
                                               Stroke="{DynamicResource PrimaryTextBrush}"
                                               StrokeThickness="1.75"
                                               Fill="Transparent" />
                                </Canvas>
                            </Viewbox>
                            <Viewbox x:Name="ChromeRestoreIcon"
                                     Width="14"
                                     Height="14"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"
                                     IsVisible="False">
                                <Canvas Width="24" Height="24">
                                    <Rectangle Canvas.Left="9"
                                               Canvas.Top="5"
                                               Width="9"
                                               Height="9"
                                               Stroke="{DynamicResource PrimaryTextBrush}"
                                               StrokeThickness="1.75"
                                               Fill="Transparent" />
                                    <Rectangle Canvas.Left="5"
                                               Canvas.Top="9"
                                               Width="9"
                                               Height="9"
                                               Stroke="{DynamicResource PrimaryTextBrush}"
                                               StrokeThickness="1.75"
                                               Fill="Transparent" />
                                </Canvas>
                            </Viewbox>
                        </Grid>
                    </Button>
                    <Button Classes="chrome-button chrome-close"
                            Width="32"
                            Height="32"
                            Background="{DynamicResource DestructiveBrush}"
                            Foreground="{DynamicResource PrimaryTextBrush}"
                            Click="OnCloseClick"
                            AutomationProperties.Name="{local:Localize Chrome_Close}">
                        <Viewbox Width="14" Height="14">
                            <Canvas Width="24" Height="24">
                                <Path Stroke="{DynamicResource PrimaryTextBrush}"
                                      StrokeThickness="1.75"
                                      StrokeLineCap="Round"
                                      Stretch="None"
                                      Data="M 6.5,6.5 L 17.5,17.5 M 17.5,6.5 L 6.5,17.5" />
                            </Canvas>
                        </Viewbox>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

    <Grid Grid.Row="1" RowDefinitions="*,Auto">

        <!-- Key entry list -->
        <ScrollViewer Grid.Row="0"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="20,18,20,4" Spacing="12">

                <ItemsControl ItemsSource="{Binding Entries}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ApiKeyEntryViewModel">
                            <Border Background="{DynamicResource ControlBackgroundBrush}" CornerRadius="8"
                                    Padding="14,12" Margin="0,0,0,2"
                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                <StackPanel Spacing="8">

                                    <!-- Provider name + status -->
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding ProviderDisplayName}"
                                                   Classes="text-secondary"
                                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                                   VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                    Spacing="5" VerticalAlignment="Center">
                                            <Ellipse Width="8" Height="8"
                                                     Fill="{Binding StatusDotColor}"
                                                     VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding StatusText}"
                                                       Foreground="{Binding StatusTextColor}"
                                                       Classes="text-caption" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Grid>

                                    <!-- Key input row -->
                                    <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto">
                                        <TextBox Grid.Column="0"
                                                 Text="{Binding KeyValue, Mode=TwoWay}"
                                                 PasswordChar="{Binding MaskChar}"
                                                 PlaceholderText="{Binding PlaceholderText}"
                                                 FontFamily="{DynamicResource UiMonoFontFamily}"
                                                 Background="{DynamicResource WindowBackgroundBrush}"
                                                 BorderBrush="{DynamicResource BorderBrush}"
                                                 Foreground="{DynamicResource PrimaryTextBrush}"
                                                 CornerRadius="4"
                                                 Padding="8,6" />

                                        <Button Grid.Column="1"
                                                Command="{Binding ToggleRevealCommand}"
                                                Content="{Binding RevealIcon}"
                                                Padding="8,6" Margin="6,0,0,0"
                                                Background="{DynamicResource ButtonBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"
                                                CornerRadius="4"
                                                ToolTip.Tip="{local:Localize Api_Tooltip_ToggleReveal}" />

                                        <Button Grid.Column="2"
                                                Command="{Binding SaveKeyCommand}"
                                                Content="{local:Localize Common_Save}"
                                                Padding="10,6" Margin="4,0,0,0"
                                                Background="{DynamicResource PositiveBrush}" Foreground="{DynamicResource PositiveFgBrush}"
                                                CornerRadius="4" />

                                        <Button Grid.Column="3"
                                                Command="{Binding ValidateKeyCommand}"
                                                Content="{Binding ValidateButtonText}"
                                                IsEnabled="{Binding CanValidateLive}"
                                                Padding="10,6" Margin="4,0,0,0"
                                                Background="{DynamicResource InfoBrush}" Foreground="{DynamicResource InfoFgBrush}"
                                                CornerRadius="4" />

                                        <Button Grid.Column="4"
                                                Command="{Binding ClearKeyCommand}"
                                                Content="{local:Localize Common_Clear}"
                                                Padding="10,6" Margin="4,0,0,0"
                                                Background="{DynamicResource DestructiveBrush}" Foreground="{DynamicResource DestructiveFgBrush}"
                                                CornerRadius="4" />
                                    </Grid>

                                    <TextBlock Text="{Binding ValidationText}"
                                               Foreground="{Binding ValidationTextColor}"
                                               Classes="text-caption"
                                               IsVisible="{Binding HasValidationText}"
                                               TextWrapping="Wrap" />

                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Future providers placeholder -->
                <Border Background="{DynamicResource PanelBackgroundBrush}" CornerRadius="8"
                        Padding="14,10" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                    <TextBlock Text="{local:Localize Api_Footer_MoreProviders}"
                               Classes="text-caption" Foreground="#4A4A62"
                               HorizontalAlignment="Center" />
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="1" Padding="20,12"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0"
                Background="{DynamicResource WindowBackgroundBrush}">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="{local:Localize Api_Footer_StorageSecurity}"
                               Classes="text-label" Foreground="#545470" />
                    <TextBlock Text="{Binding SecurityStatusDetail}"
                               Classes="text-caption" Foreground="#686885"
                               TextWrapping="Wrap" />
                </StackPanel>
                <Button Grid.Column="1"
                        Click="OnCloseClick"
                        Content="{local:Localize Common_Close}"
                        Padding="16,7" Margin="12,0,0,0"
                        Background="{DynamicResource ButtonBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"
                        CornerRadius="4" />
            </Grid>
        </Border>

    </Grid>
    </Grid>

</Window>
