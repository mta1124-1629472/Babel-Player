<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Babel.Player.ViewModels"
        xmlns:v="using:Babel.Player.Views"
        xmlns:bp="using:Babel.Player"
        xmlns:models="using:Babel.Player.Models"
        xmlns:chrome="using:Avalonia.Controls.Chrome"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="700"
        x:Class="Babel.Player.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/Icons/app.ico"
        Width="1280" Height="700"
        MinWidth="960" MinHeight="520"
        CanResize="True"
        WindowDecorations="None"
        ExtendClientAreaToDecorationsHint="True"
        Background="{DynamicResource IndustrialBackgroundBrush}">
    <Window.Styles>
        <Style Selector="Border.left-pane">
            <Setter Property="Width" Value="260" />
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="Border.left-pane.collapsed">
            <Setter Property="Width" Value="0" />
            <Setter Property="Opacity" Value="0" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <Style Selector="Border.right-pane">
            <Setter Property="Width" Value="280" />
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="Border.right-pane.collapsed">
            <Setter Property="Width" Value="0" />
            <Setter Property="Opacity" Value="0" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <Style Selector="Border.top-chrome">
            <Setter Property="Height" Value="32" />
            <Setter Property="Opacity" Value="1" />
            <Setter Property="ClipToBounds" Value="True" />
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <TranslateTransform Y="0" />
                </Setter.Value>
            </Setter>
        </Style>
        <Style Selector="Border.top-chrome.fullscreen-hidden">
            <Setter Property="Height" Value="0" />
            <Setter Property="Opacity" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="TranslateTransform.Y" Value="-8" />
        </Style>
    </Window.Styles>

    <!-- Borderless window: OS resize hit-targets at edges/corners (client content reflows via inner * grid columns). -->
    <Grid RowDefinitions="6,*,6" ColumnDefinitions="6,*,6" PointerMoved="OnWindowSurfacePointerMoved">
        <Panel Grid.Row="0" Grid.Column="0"
               Width="6" Height="6"
               Background="Transparent"
               chrome:WindowDecorationProperties.ElementRole="ResizeNW" />
        <Panel Grid.Row="0" Grid.Column="1"
               Height="6"
               Background="Transparent"
               chrome:WindowDecorationProperties.ElementRole="ResizeN" />
        <Panel Grid.Row="0" Grid.Column="2"
               Width="6" Height="6"
               Background="Transparent"
               chrome:WindowDecorationProperties.ElementRole="ResizeNE" />

        <Panel Grid.Row="1" Grid.Column="0"
               Width="6"
               Background="Transparent"
               chrome:WindowDecorationProperties.ElementRole="ResizeW" />
        <Panel Grid.Row="1" Grid.Column="2"
               Width="6"
               Background="Transparent"
               chrome:WindowDecorationProperties.ElementRole="ResizeE" />

        <Panel Grid.Row="2" Grid.Column="0"
               Width="6" Height="6"
               Background="Transparent"
               chrome:WindowDecorationProperties.ElementRole="ResizeSW" />
        <Panel Grid.Row="2" Grid.Column="1"
               Height="6"
               Background="Transparent"
               chrome:WindowDecorationProperties.ElementRole="ResizeS" />
        <Panel Grid.Row="2" Grid.Column="2"
               Width="6" Height="6"
               Background="Transparent"
               chrome:WindowDecorationProperties.ElementRole="ResizeSE" />

    <Grid Grid.Row="1" Grid.Column="1" RowDefinitions="Auto,*" ColumnDefinitions="Auto,*">
        <Border Grid.Row="0"
                Classes="top-chrome"
                Classes.fullscreen-hidden="{Binding Playback.Preview.IsFullscreen}"
                Grid.ColumnSpan="2"
                Background="{DynamicResource SurfaceSubtleBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="10,0,0,0"
                PointerPressed="OnTitleBarPointerPressed">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                <TextBlock Grid.Column="0"
                           Classes="text-title"
                           Text="Babel Player"
                           Foreground="{DynamicResource PrimaryTextBrush}"
                           VerticalAlignment="Center" />
                <!-- Win11-style: zero gap, square targets, flush to the right window edge (no right padding on chrome Border). -->
                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            Spacing="0"
                            VerticalAlignment="Stretch"
                            HorizontalAlignment="Right"
                            UseLayoutRounding="True">
                    <Button Classes="chrome-button"
                            Width="32"
                            Height="32"
                            Background="{DynamicResource ButtonBackgroundBrush}"
                            Foreground="{DynamicResource PrimaryTextBrush}"
                            Click="OnMinimizeWindowClick"
                            AutomationProperties.Name="Minimize window">
                        <Viewbox Width="14" Height="14">
                            <Canvas Width="24" Height="24">
                                <Border Canvas.Left="4"
                                        Canvas.Top="11"
                                        Width="16"
                                        Height="2.5"
                                        Background="{DynamicResource PrimaryTextBrush}"
                                        CornerRadius="1" />
                            </Canvas>
                        </Viewbox>
                    </Button>
                    <Button Classes="chrome-button"
                            Width="32"
                            Height="32"
                            Background="{DynamicResource ButtonBackgroundBrush}"
                            Foreground="{DynamicResource PrimaryTextBrush}"
                            Click="OnToggleMaximizeWindowClick"
                            AutomationProperties.Name="Maximize or restore window">
                        <Grid Width="24" Height="24">
                            <Viewbox x:Name="ChromeMaximizeIcon"
                                     Width="14"
                                     Height="14"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center">
                                <Canvas Width="24" Height="24">
                                    <Rectangle Canvas.Left="5.5"
                                               Canvas.Top="5.5"
                                               Width="13"
                                               Height="13"
                                               Stroke="{DynamicResource PrimaryTextBrush}"
                                               StrokeThickness="1.75"
                                               Fill="Transparent" />
                                </Canvas>
                            </Viewbox>
                            <Viewbox x:Name="ChromeRestoreIcon"
                                     Width="14"
                                     Height="14"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"
                                     IsVisible="False">
                                <Canvas Width="24" Height="24">
                                    <Rectangle Canvas.Left="9"
                                               Canvas.Top="5"
                                               Width="9"
                                               Height="9"
                                               Stroke="{DynamicResource PrimaryTextBrush}"
                                               StrokeThickness="1.75"
                                               Fill="Transparent" />
                                    <Rectangle Canvas.Left="5"
                                               Canvas.Top="9"
                                               Width="9"
                                               Height="9"
                                               Stroke="{DynamicResource PrimaryTextBrush}"
                                               StrokeThickness="1.75"
                                               Fill="Transparent" />
                                </Canvas>
                            </Viewbox>
                        </Grid>
                    </Button>
                    <Button Classes="chrome-button chrome-close"
                            Width="32"
                            Height="32"
                            Background="{DynamicResource DestructiveBrush}"
                            Foreground="{DynamicResource PrimaryTextBrush}"
                            Click="OnCloseWindowClick"
                            AutomationProperties.Name="Close window">
                        <Viewbox Width="14" Height="14">
                            <Canvas Width="24" Height="24">
                                <Path Stroke="{DynamicResource PrimaryTextBrush}"
                                      StrokeThickness="1.75"
                                      StrokeLineCap="Round"
                                      Stretch="None"
                                      Data="M 6.5,6.5 L 17.5,17.5 M 17.5,6.5 L 6.5,17.5" />
                            </Canvas>
                        </Viewbox>
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Close"
                                          Click="OnCloseWindowClick" />
                                <MenuItem Header="Force Close"
                                          Click="OnForceCloseWindowClick" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══════════════════════════════════════════════════
             LEFT PANEL: Pipeline
             ═══════════════════════════════════════════════════ -->
<Border Grid.Row="1" Grid.Column="0"
        Classes="left-pane glass-rack"
        Classes.collapsed="{Binding !Playback.Preview.IsSegmentPaneVisible}"
        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0"
        Margin="8,0,0,8"
        >
    <Border.Resources>
        <!-- Shadow the Application ThemeDictionary for all panel descendants.
             These values apply in both Light and Dark mode — the panel is always dark. -->
        <SolidColorBrush x:Key="PrimaryTextBrush"        Color="#E0DEFF" />
        <SolidColorBrush x:Key="StatusTextBrush"         Color="#8A88A8" />
        <SolidColorBrush x:Key="ControlBackgroundBrush"  Color="#1E1E2E" />
        <SolidColorBrush x:Key="ButtonBackgroundBrush"   Color="#2A2A3A" />
        <SolidColorBrush x:Key="BorderBrush"        Color="#2E2E44" />
        <SolidColorBrush x:Key="ProgressBackgroundBrush" Color="#2A2A3A" />
    </Border.Resources>
            <Grid RowDefinitions="Auto,*,Auto">

                <!-- Header -->
<Border Grid.Row="0" Padding="16,14,16,12"
        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
        <TextBlock Grid.Column="0" Text="Pipeline" Classes="text-display"
                    Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center" />
        <Button Grid.Column="2"
                Classes="console-button"
                Command="{Binding Playback.Pipeline.ClearPipelineCommand}"
                ToolTip.Tip="Clear pipeline and start fresh">
            <TextBlock Text="Clear"/>
        </Button>
    </Grid>
</Border>

                <!-- Scrollable body with sticky footer overlay -->
                <Grid Grid.Row="1">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="16,16,16,0" Spacing="20">

                        <!-- TARGET LANGUAGE -->
                        <StackPanel Spacing="10">
                            <TextBlock Text="TARGET LANGUAGE" Classes="text-overline"
                                       Foreground="{DynamicResource PrimaryTextBrush}" />
                            <StackPanel Spacing="5">
                                <TextBlock Text="Output (dub / subs)" Classes="text-secondary" Foreground="{DynamicResource PrimaryTextBrush}" />
                                <ComboBox ItemsSource="{Binding Playback.TargetLanguageOptions}"
                                          SelectedItem="{Binding Playback.SelectedTargetLanguageOption, Mode=TwoWay}"
                                          HorizontalAlignment="Stretch"
                                          Background="{DynamicResource ControlBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"
                                          BorderBrush="{DynamicResource BorderBrush}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding DisplayName}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>
                        </StackPanel>

                        <!-- AUDIO + DUB (session pipeline) -->
                        <StackPanel Spacing="10">
                            <TextBlock Text="AUDIO &amp; DUB" Classes="text-overline"
                                       Foreground="{DynamicResource PrimaryTextBrush}" />
                            <CheckBox IsChecked="{Binding Playback.VocalSeparationEnabled, Mode=TwoWay}"
                                      IsEnabled="{Binding Playback.VocalSeparationAvailable}"
                                      Content="Separate vocals before transcription" />
                            <TextBlock Text="{Binding Playback.VocalSeparationAvailabilityHint}"
                                       IsVisible="{Binding Playback.HasVocalSeparationAvailabilityHint}"
                                       FontSize="10" Foreground="{DynamicResource StatusTextBrush}" TextWrapping="Wrap" />
                        </StackPanel>

                        <!-- TRANSCRIPTION -->
                        <StackPanel Spacing="10">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                <TextBlock Grid.Column="0" Text="TRANSCRIPTION" Classes="text-overline"
                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                           VerticalAlignment="Center" />
                                <Button Grid.Column="1"
                                        Command="{Binding Playback.Pipeline.RefreshTranscriptionCommand}"
                                        IsEnabled="{Binding Playback.Pipeline.CanRefreshTranscription}"
                                        Background="Transparent" Padding="6,2"
                                        Foreground="{DynamicResource StatusTextBrush}"
                                        ToolTip.Tip="Re-run transcription (choose this stage only or include downstream)">
                                    <TextBlock Text="↻" FontSize="16" />
                                    <Button.Styles>
                                        <Style Selector="Button:pointerover /template/ ContentPresenter">
                                            <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}" />
                                            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
                                        </Style>
                                    </Button.Styles>
                                </Button>
                            </Grid>

                             <StackPanel Spacing="5">
                                 <TextBlock Text="Compute" Classes="text-secondary" Foreground="{DynamicResource PrimaryTextBrush}" />
<ComboBox ItemsSource="{Binding Playback.InferenceRuntimeOptions}"
                                           SelectedItem="{Binding Playback.TranscriptionRuntime, Mode=TwoWay}"
                                            HorizontalAlignment="Stretch"
                                           Background="{DynamicResource ControlBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"
                                           BorderBrush="{DynamicResource BorderBrush}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Converter={StaticResource ComputeProfileDisplayConverter}}"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>

                             <StackPanel Spacing="5">
                                 <TextBlock Text="Provider" Classes="text-secondary" Foreground="{DynamicResource PrimaryTextBrush}" />
                                 <ComboBox ItemsSource="{Binding Playback.TranscriptionProviders}"
                                           SelectedItem="{Binding Playback.TranscriptionProvider, Mode=TwoWay}"
                                           HorizontalAlignment="Stretch"
                                           Background="{DynamicResource ControlBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"
                                           BorderBrush="{DynamicResource BorderBrush}" />
                            </StackPanel>

<StackPanel Spacing="5">
                                 <TextBlock Text="Model" Classes="text-secondary" Foreground="{DynamicResource PrimaryTextBrush}" />
<ComboBox ItemsSource="{Binding Playback.AvailableTranscriptionModels}"
                                            SelectedItem="{Binding Playback.SelectedTranscriptionModel, Mode=TwoWay}"
                                           HorizontalAlignment="Stretch"
                                           Background="{DynamicResource ControlBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"
                                           BorderBrush="{DynamicResource BorderBrush}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <TextBlock Text="{Binding ModelId}"/>
                                                 <TextBlock Text="⬇ Needs Download" Foreground="{DynamicResource StatusTextBrush}" IsVisible="{Binding IsDownloadVisible, FallbackValue=False}" FontSize="10" VerticalAlignment="Center"/>
                                                 <TextBlock Text="✓ Ready" Foreground="{DynamicResource StatusTextBrush}" IsVisible="{Binding IsReadyVisible, FallbackValue=False}" FontSize="10" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Spacing="5">
                                <TextBlock Text="Spoken language (ASR hint)" Classes="text-secondary" Foreground="{DynamicResource PrimaryTextBrush}" />
                                <ComboBox ItemsSource="{Binding Playback.SpokenLanguageOptions}"
                                          SelectedItem="{Binding Playback.SelectedSpokenLanguageOption, Mode=TwoWay}"
                                          HorizontalAlignment="Stretch"
                                          Background="{DynamicResource ControlBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"
                                          BorderBrush="{DynamicResource BorderBrush}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding DisplayName}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>

                            <TextBlock Text="{Binding Playback.TranscriptionKeyStatus}"
                                        Classes="text-caption" Foreground="{DynamicResource StatusTextBrush}"
                                        IsVisible="{Binding Playback.TranscriptionKeyStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                        TextWrapping="Wrap" />
                        </StackPanel>

                        <!-- DIARIZATION / SPEAKERS -->
                        <StackPanel Spacing="10">
                            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,10,0,0">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                    <TextBlock Grid.Column="0" Text="DIARIZATION / SPEAKERS" Classes="text-overline"
                                               Foreground="{DynamicResource PrimaryTextBrush}"
                                               VerticalAlignment="Center" />
                                    <Button Grid.Column="1"
                                            Command="{Binding Playback.Pipeline.RefreshDiarizationCommand}"
                                            IsEnabled="{Binding Playback.Pipeline.CanRefreshDiarization}"
                                            Background="Transparent" Padding="6,2"
                                            Foreground="{DynamicResource StatusTextBrush}"
                                            ToolTip.Tip="Re-run speaker mapping (choose this stage only or include downstream)">
                                        <TextBlock Text="↻" FontSize="16" />
                                        <Button.Styles>
                                            <Style Selector="Button:pointerover /template/ ContentPresenter">
                                                <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}" />
                                                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
                                            </Style>
                                        </Button.Styles>
                                    </Button>
                                </Grid>
                            </Border>

                            <StackPanel Spacing="6">
                                <TextBlock Text="Multi-speaker audio" Classes="text-secondary"
                                           Foreground="{DynamicResource PrimaryTextBrush}" />
                                <TextBlock FontSize="11"
                                           Foreground="{DynamicResource StatusTextBrush}"
                                           TextWrapping="Wrap"
                                           Text="Turn this on when the recording has more than one distinct speaker so lines can be labeled and dubbed separately. For a single narrator or one speaker, leave it off to avoid extra processing." />
                                <CheckBox Content="Detect and label separate speakers"
                                          FontSize="12"
                                          Foreground="{DynamicResource PrimaryTextBrush}"
                                          IsChecked="{Binding Playback.SpeakerRouting.DetectMultipleSpeakers, Mode=TwoWay}" />
                            </StackPanel>

                            <!-- Status -->
                            <TextBlock Text="{Binding Playback.SpeakerRouting.AutoSpeakerDetectionStatus}"
                                       FontSize="11"
                                       Foreground="{DynamicResource StatusTextBrush}"
                                       IsVisible="{Binding Playback.SpeakerRouting.HasAutoSpeakerDetectionStatus}"
                                       TextWrapping="Wrap" />

                            <!-- Per-speaker voice / reference clip assignment -->
                            <StackPanel Spacing="5">

                                <!-- Hint shown when no speaker IDs have been detected yet -->
                                <TextBlock Text="Enable multi-speaker detection above, then transcribe, to assign speaker IDs."
                                           Classes="text-caption" Foreground="{DynamicResource StatusTextBrush}" TextWrapping="Wrap"
                                           IsVisible="{Binding Playback.SpeakerRouting.IsMultiSpeakerNoSpeakersYet}" />

                                <TextBlock Text="Speaker assignments are managed in the speaker setup wizard."
                                           FontSize="11"
                                           Foreground="{DynamicResource StatusTextBrush}"
                                           TextWrapping="Wrap" />

                               <Button IsEnabled="{Binding Playback.SpeakerRouting.CanOpenSpeakerSetupWizard}"
                                       HorizontalAlignment="Stretch"
                                       Classes="console-button"
                                       Click="OnReviewSpeakerReferencesClick"
                                       ToolTip.Tip="Opens the speaker setup wizard: per-speaker voice and (for Qwen) reference clips. Finish in the wizard saves changes."
                                       Content="Speaker setup wizard…" />

                           </StackPanel>

                       </StackPanel>

                        <!-- TRANSLATION -->
                        <StackPanel Spacing="10">
                            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,10,0,0">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                    <TextBlock Grid.Column="0" Text="TRANSLATION" Classes="text-overline"
                                               Foreground="{DynamicResource PrimaryTextBrush}"
                                               VerticalAlignment="Center" />
                                    <Button Grid.Column="1"
                                            Command="{Binding Playback.Pipeline.RefreshTranslationCommand}"
                                            IsEnabled="{Binding Playback.Pipeline.CanRefreshTranslation}"
                                            Background="Transparent" Padding="6,2"
                                            Foreground="{DynamicResource StatusTextBrush}"
                                            ToolTip.Tip="Re-run translation (choose this stage only or include dub)">
                                        <TextBlock Text="↻" FontSize="16" />
                                        <Button.Styles>
                                            <Style Selector="Button:pointerover /template/ ContentPresenter">
                                                <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}" />
                                                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
                                            </Style>
                                        </Button.Styles>
                                    </Button>
                                </Grid>
                            </Border>

                            <StackPanel Spacing="5">
                                <TextBlock Text="Compute" Classes="text-secondary" Foreground="{DynamicResource PrimaryTextBrush}" />
                                <ComboBox ItemsSource="{Binding Playback.InferenceRuntimeOptions}"
                                          SelectedItem="{Binding Playback.TranslationRuntime, Mode=TwoWay}"
                                          HorizontalAlignment="Stretch"
                                          Background="{DynamicResource ControlBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"
                                          BorderBrush="{DynamicResource BorderBrush}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Converter={StaticResource ComputeProfileDisplayConverter}}"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Spacing="5">
                                <TextBlock Text="Provider" Classes="text-secondary" Foreground="{DynamicResource PrimaryTextBrush}" />
                                <ComboBox ItemsSource="{Binding Playback.TranslationProviders}"
                                          SelectedItem="{Binding Playback.TranslationProvider, Mode=TwoWay}"
                                          HorizontalAlignment="Stretch"
                                          Background="{DynamicResource ControlBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"
                                          BorderBrush="{DynamicResource BorderBrush}" />
                            </StackPanel>

                            <StackPanel Spacing="5">
                                <TextBlock Text="Model" Classes="text-secondary" Foreground="{DynamicResource PrimaryTextBrush}" />
                                <ComboBox ItemsSource="{Binding Playback.AvailableTranslationModels}"
                                          SelectedItem="{Binding Playback.SelectedTranslationModel, Mode=TwoWay}"
                                          HorizontalAlignment="Stretch"
                                          Background="{DynamicResource ControlBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"
                                          BorderBrush="{DynamicResource BorderBrush}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <TextBlock Text="{Binding ModelId}"/>
                                                <TextBlock Text="⬇ Needs Download" Foreground="{DynamicResource StatusTextBrush}" IsVisible="{Binding IsDownloadVisible, FallbackValue=False}" FontSize="10" VerticalAlignment="Center"/>
                                                <TextBlock Text="✓ Ready" Foreground="{DynamicResource StatusTextBrush}" IsVisible="{Binding IsReadyVisible, FallbackValue=False}" FontSize="10" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>
                        </StackPanel>

                        <!-- DUB -->
                        <StackPanel Spacing="10">
                            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,10,0,0">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                    <TextBlock Grid.Column="0" Text="DUB" Classes="text-overline"
                                               Foreground="{DynamicResource PrimaryTextBrush}"
                                               VerticalAlignment="Center" />
                                    <Button Grid.Column="1"
                                            Command="{Binding Playback.Pipeline.RefreshDubCommand}"
                                            IsEnabled="{Binding Playback.Pipeline.CanRefreshDub}"
                                            Background="Transparent" Padding="6,2"
                                            Foreground="{DynamicResource StatusTextBrush}"
                                            ToolTip.Tip="Re-generate dub audio from the current translation">
                                        <TextBlock Text="↻" FontSize="16" />
                                        <Button.Styles>
                                            <Style Selector="Button:pointerover /template/ ContentPresenter">
                                                <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}" />
                                                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
                                            </Style>
                                        </Button.Styles>
                                    </Button>
                                </Grid>
                            </Border>

                            <StackPanel Spacing="5">
                                <TextBlock Text="Compute" Classes="text-secondary" Foreground="{DynamicResource PrimaryTextBrush}" />
                                <ComboBox ItemsSource="{Binding Playback.InferenceRuntimeOptions}"
                                          SelectedItem="{Binding Playback.TtsRuntime, Mode=TwoWay}"
                                          HorizontalAlignment="Stretch"
                                          Background="{DynamicResource ControlBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"
                                          BorderBrush="{DynamicResource BorderBrush}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Converter={StaticResource ComputeProfileDisplayConverter}}"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Spacing="5">
                                <TextBlock Text="Provider" Classes="text-secondary" Foreground="{DynamicResource PrimaryTextBrush}" />
                                <ComboBox ItemsSource="{Binding Playback.TtsProviders}"
                                          SelectedItem="{Binding Playback.TtsProvider, Mode=TwoWay}"
                                          HorizontalAlignment="Stretch"
                                          Background="{DynamicResource ControlBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"
                                          BorderBrush="{DynamicResource BorderBrush}" />
                            </StackPanel>

                            <StackPanel Spacing="6" IsVisible="{Binding Playback.ShowTtsAssignmentModeSwitch}">
                                <TextBlock Text="Voice assignment" Classes="text-secondary" Foreground="{DynamicResource PrimaryTextBrush}" />
                                <CheckBox Content="Assign per speaker in Speaker Reference Wizard (fallback voice below)"
                                          IsChecked="{Binding Playback.TtsVoiceUsePerSpeakerWizard, Mode=TwoWay}"
                                          FontSize="12" />
                                <TextBlock Text="Use one voice for every speaker, or turn on the option above and set a fallback plus per-speaker voices in the wizard."
                                           FontSize="11" Opacity="0.75" TextWrapping="Wrap"
                                           IsVisible="{Binding Playback.ShowPerSpeakerVoiceHint}" />
                            </StackPanel>

                            <StackPanel Spacing="5">
                                <TextBlock FontSize="12" Foreground="{DynamicResource PrimaryTextBrush}"
                                           Text="{Binding Playback.TtsVoiceComboHeaderText}" />
                                <ComboBox ItemsSource="{Binding Playback.AvailableTtsOptions}"
                                          SelectedItem="{Binding Playback.SelectedTtsOption, Mode=TwoWay}"
                                          HorizontalAlignment="Stretch"
                                          Background="{DynamicResource ControlBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"
                                          BorderBrush="{DynamicResource BorderBrush}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <TextBlock Text="{Binding ModelId}"/>
                                                <TextBlock Text="⬇ Needs Download" Foreground="{DynamicResource StatusTextBrush}" IsVisible="{Binding IsDownloadVisible, FallbackValue=False}" FontSize="10" VerticalAlignment="Center"/>
                                                <TextBlock Text="✓ Ready" Foreground="{DynamicResource StatusTextBrush}" IsVisible="{Binding IsReadyVisible, FallbackValue=False}" FontSize="10" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>

                            <TextBlock Text="{Binding Playback.TtsKeyStatus}"
                                       Classes="text-caption" Foreground="{DynamicResource StatusTextBrush}"
                                       IsVisible="{Binding Playback.TtsKeyStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                       TextWrapping="Wrap" />
                        </StackPanel>

                         <!-- API KEYS -->
                         <StackPanel Spacing="8">
                             <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,10,0,0">
                                 <TextBlock Text="API KEYS" Classes="text-overline"
                                            Foreground="{DynamicResource PrimaryTextBrush}" />
                             </Border>

                             <TextBlock Text="Configure credentials for the providers selected above."
                                        FontSize="11"
                                        Foreground="{DynamicResource PrimaryTextBrush}"
                                        TextWrapping="Wrap" />

                              <Button HorizontalAlignment="Stretch"
                                      HorizontalContentAlignment="Center"
                                      Padding="12,10"
                                      FontSize="12"
                                      Background="{DynamicResource ControlBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"
                                      BorderBrush="{DynamicResource BorderBrush}"
                                      CornerRadius="6"
                                      Click="OnApiKeysClick">
                                  <StackPanel Orientation="Horizontal" Spacing="8">
                                      <TextBlock Text="API Keys" VerticalAlignment="Center" FontWeight="Medium"/>
                                  </StackPanel>
                              </Button>
                        </StackPanel>

                         <!-- LANGUAGE ROUTING -->
                         <StackPanel Spacing="10">
                             <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,10,0,0">
                                 <TextBlock Text="LANGUAGE ROUTING" Classes="text-overline"
                                            Foreground="{DynamicResource PrimaryTextBrush}" />
                             </Border>

                             <Grid ColumnDefinitions="*,Auto">
                                 <TextBlock Grid.Column="0" Text="Source Audio" Classes="text-secondary"
                                            Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center" />
                                 <Border Grid.Column="1" Background="{DynamicResource ControlBackgroundBrush}" CornerRadius="4"
                                         Padding="8,4">
                                     <TextBlock Text="{Binding Coordinator.CurrentSession.SourceLanguage, TargetNullValue='—'}"
                                                Classes="text-secondary" Foreground="{DynamicResource PrimaryTextBrush}" />
                                 </Border>
                             </Grid>

                             <Grid ColumnDefinitions="*,Auto">
                                 <TextBlock Grid.Column="0" Text="Target Sub/Dub" Classes="text-secondary"
                                            Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center" />
                                 <Border Grid.Column="1" Background="{DynamicResource ControlBackgroundBrush}" CornerRadius="4"
                                         Padding="8,4">
                                     <TextBlock Text="{Binding Coordinator.CurrentSession.TargetLanguage, TargetNullValue='—'}"
                                                Classes="text-secondary" Foreground="{DynamicResource PrimaryTextBrush}" />
                                 </Border>
                             </Grid>
                        </StackPanel>

                        <!-- ACTIVE CONFIGURATION -->
                        <StackPanel Spacing="8">
                            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,10,0,0">
                                <TextBlock Text="ACTIVE CONFIG" Classes="text-overline"
                                            Foreground="{DynamicResource PrimaryTextBrush}" />
                            </Border>

                            <Grid ColumnDefinitions="56,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="4">
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="ASR"
                                           Classes="text-caption" Foreground="{DynamicResource PrimaryTextBrush}" />
                                <TextBlock Grid.Row="0" Grid.Column="1"
                                           Text="{Binding Playback.ActiveTranscriptionConfigLine}"
                                           Classes="text-caption" Foreground="{DynamicResource PrimaryTextBrush}" TextWrapping="Wrap" />

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="CPU"
                                           Classes="text-caption" Foreground="{DynamicResource PrimaryTextBrush}" />
                                <TextBlock Grid.Row="1" Grid.Column="1"
                                           Text="{Binding Playback.ActiveCpuTuningLine}"
                                           Classes="text-caption" Foreground="{DynamicResource PrimaryTextBrush}" TextWrapping="Wrap" />

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="GPU"
                                           Classes="text-caption" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Top" />
                                <TextBlock Grid.Row="2" Grid.Column="1"
                                           Text="{Binding Playback.HwGpuLine}"
                                           Classes="text-caption" Foreground="{DynamicResource StatusTextBrush}" TextWrapping="Wrap" />

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="NMT"
                                           Classes="text-caption" Foreground="{DynamicResource PrimaryTextBrush}" />
                                <TextBlock Grid.Row="3" Grid.Column="1"
                                           Text="{Binding Playback.ActiveTranslationConfigLine}"
                                           Classes="text-caption" Foreground="{DynamicResource PrimaryTextBrush}" TextWrapping="Wrap" />

                                <TextBlock Grid.Row="4" Grid.Column="0" Text="TTS"
                                           Classes="text-caption" Foreground="{DynamicResource PrimaryTextBrush}" />
                                <TextBlock Grid.Row="4" Grid.Column="1"
                                           Text="{Binding Playback.HwNpuLine}"
                                           Classes="text-caption" Foreground="{DynamicResource StatusTextBrush}" TextWrapping="Wrap" />

                                <TextBlock Grid.Row="5" Grid.Column="0" Text="RAM"
                                           Classes="text-caption" Foreground="{DynamicResource PrimaryTextBrush}" />
                                <TextBlock Grid.Row="5" Grid.Column="1"
                                           Text="{Binding Playback.HwRamLine}"
                                           Classes="text-caption" Foreground="{DynamicResource StatusTextBrush}" TextWrapping="Wrap" />
                            </Grid>
                        </StackPanel>

                        <!-- PROVIDER DIAGNOSTICS -->
                        <StackPanel Spacing="8">
                            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,10,0,0">
                                <TextBlock Text="PROVIDER DIAGNOSTICS" Classes="text-overline"
                                            Foreground="{DynamicResource PrimaryTextBrush}" />
                            </Border>

                            <ItemsControl ItemsSource="{Binding Playback.ProviderHealthSnapshots}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ProviderHealthSnapshot">
                                        <Border Padding="10,8"
                                                Background="{DynamicResource ControlBackgroundBrush}"
                                                BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="6"
                                                Margin="0,0,0,6">
                                            <StackPanel Spacing="4">
                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                    <TextBlock Grid.Column="0"
                                                               Text="{Binding Section}"
                                                               Classes="text-secondary"
                                                               Foreground="{DynamicResource PrimaryTextBrush}" />
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding StatusLine}"
                                                               Classes="text-caption"
                                                               Foreground="{DynamicResource StatusTextBrush}"
                                                               HorizontalAlignment="Right" />
                                                </Grid>

                                                <TextBlock Text="{Binding SelectionLabel}"
                                                           Classes="text-caption"
                                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                                           TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding Detail}"
                                                           Classes="text-caption"
                                                           Foreground="{DynamicResource StatusTextBrush}"
                                                           TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding HostState}"
                                                           Classes="text-caption"
                                                           Foreground="{DynamicResource StatusTextBrush}"
                                                           TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding MetricsText}"
                                                           Classes="text-micro"
                                                           Foreground="{DynamicResource StatusTextBrush}"
                                                           TextWrapping="Wrap"
                                                           IsVisible="{Binding MetricsText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <TextBlock Text="{Binding CheckedAtText}"
                                                               Classes="text-micro"
                                                               Foreground="{DynamicResource StatusTextBrush}" />
                                                    <TextBlock Text="stale"
                                                               Classes="text-micro"
                                                               Foreground="{DynamicResource StatusTextBrush}"
                                                               IsVisible="{Binding IsStale}" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <Border Height="260"
                                Background="Transparent"
                                IsHitTestVisible="False" />
                        </StackPanel>
                    </ScrollViewer>

                    <Border VerticalAlignment="Bottom"
                            Background="{DynamicResource PanelBackgroundBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="0,1,0,0"
                            Padding="16,14,16,16">
                        <StackPanel Spacing="10">
                            <StackPanel Spacing="6"
                                       IsVisible="{Binding Playback.Pipeline.ShowPipelineStatusChrome}">
                                <TextBlock Text="{Binding Playback.Pipeline.PipelineStageDetail}"
                                           Classes="text-caption"
                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="{Binding Playback.Pipeline.PipelineProgressStatusLine}"
                                           Classes="text-micro"
                                           Foreground="{DynamicResource StatusTextBrush}"
                                           TextWrapping="Wrap" />
                                <ProgressBar Value="{Binding Playback.Pipeline.PipelineProgressPercent}"
                                             Minimum="0"
                                             Maximum="1"
                                             Classes="neon-pulse"
                                             IsIndeterminate="{Binding Playback.Pipeline.IsPipelineProgressIndeterminate}"
                                             AutomationProperties.Name="Pipeline progress" />
                            </StackPanel>

                            <Grid>
                                <Button HorizontalAlignment="Stretch"
                                        Classes="glow-button"
                                        Command="{Binding Playback.Pipeline.RunPipelineCommand}"
                                        IsEnabled="{Binding Playback.Pipeline.CanRunPipeline}"
                                        IsVisible="{Binding !Playback.IsBusy}">
                                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                        <TextBlock Text="▶" VerticalAlignment="Center" />
                                        <TextBlock Text="Run Pipeline" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>

                                <Button HorizontalAlignment="Stretch"
                                        Classes="destructive-glow"
                                        Command="{Binding Playback.Pipeline.CancelPipelineCommand}"
                                        IsVisible="{Binding Playback.IsBusy}">
                                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                        <Border Width="12" Height="12" Background="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" CornerRadius="2" VerticalAlignment="Center"/>
                                        <TextBlock Text="Cancel Pipeline" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <TextBlock Grid.Column="0"
                                           Text="{Binding Playback.StatusText}"
                                           FontSize="11"
                                           Foreground="{DynamicResource StatusTextBrush}"
                                           HorizontalAlignment="Center"
                                           TextWrapping="Wrap"
                                           MaxHeight="52" />

                                <Button Grid.Column="1"
                                        Command="{Binding Playback.ShowStatusErrorDetailsCommand}"
                                        IsVisible="{Binding Playback.HasErrorDetails}"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Bottom"
                                        Padding="6,2"
                                        MinWidth="24"
                                        FontSize="12"
                                        Background="{DynamicResource ButtonBackgroundBrush}"
                                        Foreground="{DynamicResource PrimaryTextBrush}"
                                        CornerRadius="4"
                                        ToolTip.Tip="Expand error details">
                                    <TextBlock Text="↗" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>

            </Grid>
        </Border>

        <!-- ═══════════════════════════════════════════════════
             VIDEO + SEGMENTS + chrome (merged former center/right columns)
             ═══════════════════════════════════════════════════ -->
        <Grid Grid.Row="1" Grid.Column="1"
              x:Name="VideoSegmentsChromeHost"
              ColumnDefinitions="*,Auto"
              RowDefinitions="Auto,*,Auto,Auto"
              Background="{DynamicResource WindowBackgroundBrush}">

            <Grid x:Name="PlayerChromeWidthHost"
                  Grid.Row="0"
                  Grid.RowSpan="4"
                  Grid.Column="0"
                  Background="Transparent"
                  IsHitTestVisible="False" />

            <!-- Diagnostics warning bar (hidden when all deps available) -->
            <Border Grid.Row="0" Grid.Column="0" Background="{DynamicResource WarningBackgroundBrush}" Padding="10,5"
                    BorderBrush="{DynamicResource WarningBorderBrush}" BorderThickness="0,0,0,1"
                    IsVisible="{Binding Playback.ShowDiagnosticsWarningBanner}">
                <TextBlock Text="{Binding Playback.DiagnosticsWarningText}"
                                Classes="text-caption" Foreground="{DynamicResource StatusTextBrush}" />
            </Border>

            <!-- Video surface -->
            <Grid Grid.Row="1" Grid.Column="0">
                <Border Background="Black" Margin="0">
                    <v:MpvVideoView x:Name="VideoView" />
                </Border>
                <Border HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="12"
                        Padding="10,6"
                        Background="{DynamicResource SurfaceRaisedBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        IsVisible="{Binding Playback.HasVsrPlaybackStatus}">
                    <TextBlock Text="{Binding Playback.VsrPlaybackStatusText}"
                               FontSize="11"
                               Foreground="{DynamicResource VideoOverlayTextBrush}"
                               TextWrapping="Wrap" />
                </Border>
                <Panel x:Name="VideoOverlayPanel" Background="Transparent" />

            </Grid>

            <!-- Scrub bar -->
            <Border Grid.Row="2" Grid.Column="0" Padding="12,5"
                    IsVisible="{Binding Playback.Preview.IsControlsVisible}">
                <Grid ColumnDefinitions="40,*,40">
                     <TextBlock Grid.Column="0"
                                Text="{Binding Playback.Preview.SourcePositionFormatted}"
                                FontSize="11" Foreground="{DynamicResource VideoOverlaySubtextBrush}"
                                VerticalAlignment="Center" />
                    <Slider Grid.Column="1"
                            Minimum="0"
                            Maximum="{Binding Playback.Preview.SourceDurationMs}"
                            Value="{Binding Playback.Preview.SourcePositionMs, Mode=TwoWay}"
                            IsEnabled="{Binding Playback.Preview.IsSourceMediaLoaded}"
                            VerticalAlignment="Center" />
                     <TextBlock Grid.Column="2"
                                Text="{Binding Playback.Preview.SourceDurationFormatted}"
                                FontSize="11" Foreground="{DynamicResource VideoOverlaySubtextBrush}"
                                VerticalAlignment="Center" TextAlignment="Right" />
                </Grid>
            </Border>

            <Border Grid.Row="0" Grid.Column="1" Grid.RowSpan="4"
                    Classes="right-pane glass-rack"
                    Classes.collapsed="{Binding !Playback.Preview.IsSegmentPaneVisible}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,0,0"
                    Margin="0,0,8,8"
                    ZIndex="0"
                    >
                <Grid RowDefinitions="Auto,*,Auto">

                    <!-- Header -->
                    <Border Grid.Row="0" Padding="14,12"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="Segments" Classes="text-title" Foreground="#F0F0F8"
                                           VerticalAlignment="Center" />
                                <Border Background="{DynamicResource ControlBackgroundBrush}" CornerRadius="4" Padding="8,2"
                                        VerticalAlignment="Center">
                                    <TextBlock FontSize="11" Foreground="#8888A0" VerticalAlignment="Center"
                                               Text="{Binding Playback.Preview.Segments.Count, StringFormat='{}{0} items'}" />
                                </Border>
                            </StackPanel>

                            <Button Grid.Column="1"
                                    Click="OnExportMenuButtonClick"
                                    Classes="console-button"
                                    ToolTip.Tip="Export captions (.srt), dubbed audio only (.mp3), or video with dub + soft subs (.mp4) — audio matches current timings and mix.">
                                <TextBlock Text="Export" />
                                <Button.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="to .srt"
                                                  Click="OnExportToSrtClick" />
                                        <MenuItem Header="to .mp3"
                                                  Click="OnExportToMp3Click" />
                                        <MenuItem Header="to .mp4"
                                                  Click="OnExportToMp4Click" />
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>

                            <Button Grid.Column="2"
                                    Command="{Binding Playback.Preview.RefreshSegmentsCommand}"
                                    Classes="console-button"
                                    ToolTip.Tip="Refresh segments">
                                <TextBlock Text="↻" FontSize="14" />
                            </Button>

                        </Grid>
                    </Border>

                    <Panel Grid.Row="1">
                    <!-- Segment list -->
                    <ListBox Grid.Row="1" x:Name="SegmentList"
                             Margin="0,0,0,54"
                             ItemsSource="{Binding Playback.Preview.Segments}"
                             SelectedItem="{Binding Playback.Preview.SelectedSegment}"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.Styles>
                            <Style Selector="ListBoxItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Background" Value="Transparent" />
                            </Style>
                            <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                                <Setter Property="Background" Value="{DynamicResource SegmentSelectedBrush}" />
                            </Style>
                            <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
                                <Setter Property="Background" Value="{DynamicResource SegmentPointerOverBrush}" />
                            </Style>
                        </ListBox.Styles>
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="models:WorkflowSegmentState">
                                <Border Padding="14,10" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                                    <Grid ColumnDefinitions="*,12">

                                        <StackPanel Grid.Column="0" Spacing="3">
                                            <!-- Time range -->
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <Border Background="{Binding SpeakerId, Converter={StaticResource SpeakerIdToColorConverter}}"
                                                        CornerRadius="999"
                                                        Padding="7,2"
                                                        VerticalAlignment="Center"
                                                        IsVisible="{Binding SpeakerId, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                                    <TextBlock Text="{Binding SpeakerId, Converter={StaticResource SpeakerIdToShortLabelConverter}}"
                                                               Classes="text-micro"
                                                               FontWeight="Medium"
                                                               Foreground="White"
                                                               VerticalAlignment="Center" />
                                                </Border>
                                                <TextBlock Classes="text-caption"
                                                           Foreground="{DynamicResource StatusTextBrush}"
                                                           VerticalAlignment="Center">
                                                    <TextBlock.Text>
                                                        <MultiBinding StringFormat="{}{0:F1}s  —  {1:F1}s">
                                                            <Binding Path="StartSeconds" />
                                                            <Binding Path="EndSeconds" />
                                                        </MultiBinding>
                                                    </TextBlock.Text>
                                                </TextBlock>
                                            </StackPanel>
                                            <!-- Original text -->
                                            <TextBlock Text="{Binding SourceText}"
                                                       Classes="text-secondary" Foreground="{DynamicResource StatusTextBrush}"
                                                       TextWrapping="Wrap" />
                                            <!-- Translated text -->
                                            <TextBlock Text="{Binding TranslatedText}"
                                                       Classes="text-emphasis" Foreground="{DynamicResource PrimaryTextBrush}"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>

                                        <!-- Status indicator column -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Top"
                                                    Margin="0,4,0,0" Spacing="4">
                                            <!-- Green dot: TTS audio ready -->
                                            <Ellipse Width="8" Height="8"
                                                     Fill="#22C55E"
                                                     IsVisible="{Binding HasTtsAudio}"
                                                     HorizontalAlignment="Center" />
                                            <!-- Orange bar: translation present, no TTS yet -->
                                            <Rectangle Width="4" Height="16"
                                                       Fill="#F59E0B"
                                                       RadiusX="2" RadiusY="2"
                                                       IsVisible="{Binding HasTranslation}"
                                                       HorizontalAlignment="Center" />
                                        </StackPanel>

                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel IsVisible="{Binding !Playback.Preview.HasSegments}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Spacing="4">
                        <TextBlock Text="No segments yet" Classes="text-title" HorizontalAlignment="Center" />
                        <TextBlock Text="Open media and run the pipeline to generate segments."
                                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                    </Panel>

                    <!-- Segment inspection / timing panel (row 2) -->
                    <Border Grid.Row="2"
                            IsVisible="{Binding Playback.Preview.HasSegments}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0"
                            Padding="14,10">
                        <StackPanel Spacing="6">

                            <TextBlock Text="Render timing" Classes="text-label"
                                       Foreground="{DynamicResource StatusTextBrush}"/>

                            <ComboBox ItemsSource="{Binding Playback.DubTimingModeOptions}"
                                      SelectedItem="{Binding Playback.DubTimingMode, Mode=TwoWay}"
                                      HorizontalAlignment="Stretch"
                                      Background="{DynamicResource ControlBackgroundBrush}"
                                      Foreground="{DynamicResource PrimaryTextBrush}"
                                      BorderBrush="{DynamicResource BorderBrush}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Converter={StaticResource SegmentTimingModeDisplayConverter}}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <TextBlock Text="Applies to generated dub audio and export. Pause is preview-only."
                                       Classes="text-caption" Foreground="{DynamicResource StatusTextBrush}"/>

                            <StackPanel IsVisible="{Binding Inspection.IsVisible}"
                                        Spacing="6">
                                <StackPanel.Styles>
                                    <!-- Shared at this scope so the timing chips AND the
                                         "Preview With Pause" button below render identically. -->
                                    <Style Selector="Button.segmentTimingButton">
                                        <Setter Property="Padding" Value="8,3"/>
                                        <Setter Property="FontSize" Value="11"/>
                                        <Setter Property="CornerRadius" Value="4"/>
                                        <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}"/>
                                        <Setter Property="Foreground" Value="{DynamicResource StatusTextBrush}"/>
                                    </Style>
                                </StackPanel.Styles>
                                <TextBlock Text="Selected segment" Classes="text-label"
                                           Foreground="{DynamicResource StatusTextBrush}"/>

                                <TextBlock Text="{Binding Inspection.TimingLabel}"
                                           Classes="text-caption" Foreground="{DynamicResource StatusTextBrush}"/>

                                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,2,0,0">
                                    <Button Classes="segmentTimingButton"
                                            Content="Inherit"
                                            Command="{Binding Inspection.SetTimingOverrideCommand}"
                                            CommandParameter="{x:Null}"
                                            ToolTip.Tip="Use the session render timing for this segment"/>
                                    <Button Classes="segmentTimingButton"
                                            Content="Off"
                                            Command="{Binding Inspection.SetTimingOverrideCommand}"
                                            CommandParameter="{x:Static models:SegmentTimingMode.Off}"
                                            ToolTip.Tip="Play TTS as-is for this segment in rendered dub/export"/>
                                    <Button Classes="segmentTimingButton"
                                            Content="Stretch"
                                            Command="{Binding Inspection.SetTimingOverrideCommand}"
                                            CommandParameter="{x:Static models:SegmentTimingMode.Stretch}"
                                            ToolTip.Tip="Time-stretch TTS to fit this segment window in rendered dub/export"/>
                                </StackPanel>

                                <TextBlock Text="{Binding Inspection.TimingOverrideLabel}"
                                           FontSize="10" Foreground="{DynamicResource StatusTextBrush}"
                                           Opacity="0.7"/>

                                <TextBlock Text="Preview pause" Classes="text-label"
                                           Foreground="{DynamicResource StatusTextBrush}"/>

                                <TextBlock Text="Pauses source playback while previewing the selected segment, then resumes at the segment end."
                                           Classes="text-caption" Foreground="{DynamicResource StatusTextBrush}"/>

                                <Button Classes="segmentTimingButton"
                                        Content="Preview With Pause"
                                        Command="{Binding Inspection.PreviewPauseCommand}"
                                        IsEnabled="{Binding Inspection.HasTtsAudio}"
                                        ToolTip.Tip="Preview this segment using pause behavior without changing rendered dub timing"/>
                            </StackPanel>

                        </StackPanel>
                    </Border>

                </Grid>
            </Border>

            <!-- Controls bar: bottom overlay spanning video + segments -->
            <Border x:Name="ControlsBarContainer"
                    Grid.Row="3" Grid.Column="0"
                    Padding="12,7"
                    ZIndex="2"
                    IsVisible="{Binding Playback.Preview.IsControlsVisible}">
                <Border.Styles>
                    <!-- Dev toolbar pill style: amber tint so it's visually distinct -->
                    <Style Selector="Button.dev-pill">
                        <Setter Property="Foreground" Value="#D4A017" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="BorderBrush" Value="#3A3010" />
                        <Setter Property="BorderThickness" Value="1" />
                        <Setter Property="CornerRadius" Value="6" />
                    </Style>
                    <Style Selector="Button.dev-pill /template/ ContentPresenter">
                        <Setter Property="Background" Value="Transparent" />
                    </Style>
                    <Style Selector="Button.dev-pill:pointerover /template/ ContentPresenter">
                        <Setter Property="Background" Value="#2A2010" />
                    </Style>
                    <Style Selector="Button.dev-pill:pressed /template/ ContentPresenter">
                        <Setter Property="Background" Value="#38280A" />
                    </Style>
                </Border.Styles>

                <Grid>
                    <!-- Wide: left | transport | right; Bi-lang moved to Settings -->
                    <ScrollViewer x:Name="ControlsBarScrollViewer"
                                  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Disabled"
                                  HorizontalAlignment="Stretch"
                                  IsVisible="{Binding Playback.Preview.IsWideVideoChrome}">
                        <!-- Keep star spacer columns finite inside ScrollViewer so left/center/right groups stay distributed. -->
                        <Grid ColumnDefinitions="Auto,*,Auto,*,Auto"
                              MinWidth="{Binding Viewport.Width, ElementName=ControlsBarScrollViewer}">

                            <!-- Left: open media + CC + dub mode toggle -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4"
                                        VerticalAlignment="Center">
                                <Button Classes="control-pill"
                                        Padding="10,8"
                                        FontSize="14"
                                        Background="Transparent"
                                        Click="OnOpenMediaClick"
                                        ToolTip.Tip="Open media file"
                                        AutomationProperties.Name="Open media">
                                    <TextBlock Text="📁" FontSize="14"/>
                                </Button>
                                <Button Content="{Binding Playback.Preview.SubtitleToggleLabel}"
                                        Classes="control-pill"
                                        Command="{Binding Playback.Preview.ToggleSubtitlesCommand}"
                                        IsEnabled="{Binding Playback.Preview.HasSegments}"
                                        Padding="8,6" FontSize="11"
                                        Background="Transparent"
                                        ToolTip.Tip="Toggle subtitles (C)"
                                        AutomationProperties.Name="Toggle subtitles" />
                                <Button Content="{Binding Playback.Preview.DubModeLabel}"
                                        Classes="control-pill"
                                        Classes.active="{Binding Playback.Preview.IsDubModeOn}"
                                        Command="{Binding Playback.Preview.ToggleDubModeCommand}"
                                        IsEnabled="{Binding Playback.Preview.HasSegments}"
                                        Padding="8,6" FontSize="11"
                                        Background="Transparent"
                                        ToolTip.Tip="Toggle Dub Mode (D)"
                                        AutomationProperties.Name="Toggle Dub Mode" />

                                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" Margin="6,0,0,0"
                                            IsVisible="{Binding Playback.Preview.IsDubModeOn}">
                                    <TextBlock Text="{Binding Playback.Preview.DubMixControlLabel}" FontSize="10" Foreground="#8A88A8" VerticalAlignment="Center" />
                                    <Slider Width="60"
                                            Orientation="Horizontal"
                                            Minimum="-30"
                                            Maximum="0"
                                            Value="{Binding Playback.Preview.DubMixControlDb, Mode=TwoWay}"
                                            IsEnabled="{Binding Playback.Preview.IsSourceMediaLoaded}"
                                            VerticalAlignment="Center"
                                            ToolTip.Tip="{Binding Playback.Preview.DubMixControlTooltip}" />
                                    <TextBlock Text="{Binding Playback.Preview.DubMixControlValueLabel}"
                                               FontSize="10"
                                               Foreground="#8A88A8"
                                               VerticalAlignment="Center"
                                               Width="30" />
                                </StackPanel>
                            </StackPanel>

                            <!-- Center: playback buttons in a unified transport capsule -->
                            <Border Grid.Column="2" Classes="glass-rack" Padding="6,4"
                                    VerticalAlignment="Center" HorizontalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <Button Classes="control-pill"
                                            Command="{Binding Playback.Preview.SkipBackwardCommand}"
                                            IsEnabled="{Binding Playback.Preview.HasSegments}"
                                            Padding="10,6" FontSize="12"
                                            ToolTip.Tip="Skip to previous segment"
                                            AutomationProperties.Name="Skip to previous segment">
                                        <TextBlock Text="|◀" FontSize="12"/>
                                    </Button>
                                    <Button Classes="control-pill"
                                            Command="{Binding Playback.Preview.RewindCommand}"
                                            IsEnabled="{Binding Playback.Preview.IsSourceMediaLoaded}"
                                            Padding="10,6" FontSize="12"
                                            ToolTip.Tip="Rewind 10 seconds"
                                            AutomationProperties.Name="Rewind 10 seconds">
                                        <TextBlock Text="◀◀" FontSize="12"/>
                                    </Button>
                                    <Button Command="{Binding Playback.Preview.PlayPauseSourceCommand}"
                                            IsEnabled="{Binding Playback.Preview.IsSourceMediaLoaded}"
                                            Width="46" Height="46" Padding="0" Margin="4,0"
                                            CornerRadius="23" Background="{DynamicResource AccentBrush}"
                                            ToolTip.Tip="Play / Pause (Space)"
                                            AutomationProperties.Name="Play or pause">
                                        <Button.Styles>
                                            <Style Selector="Button:pointerover /template/ ContentPresenter">
                                                <Setter Property="Background" Value="{DynamicResource AccentSecondaryBrush}" />
                                            </Style>
                                        </Button.Styles>
                                        <TextBlock Text="{Binding Playback.Preview.PlayPauseSourceLabel}"
                                                   FontSize="{DynamicResource FontSizeTitle}"
                                                   FontWeight="Medium"
                                                   Foreground="White"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Button>
                                    <Button Classes="control-pill"
                                            Command="{Binding Playback.Preview.FastForwardCommand}"
                                            IsEnabled="{Binding Playback.Preview.IsSourceMediaLoaded}"
                                            Padding="10,6" FontSize="12"
                                            ToolTip.Tip="Fast forward 10 seconds"
                                            AutomationProperties.Name="Fast forward 10 seconds">
                                        <TextBlock Text="▶▶" FontSize="12"/>
                                    </Button>
                                    <Button Classes="control-pill"
                                            Command="{Binding Playback.Preview.SkipForwardCommand}"
                                            IsEnabled="{Binding Playback.Preview.HasSegments}"
                                            Padding="10,6" FontSize="12"
                                            ToolTip.Tip="Skip to next segment"
                                            AutomationProperties.Name="Skip to next segment">
                                        <TextBlock Text="▶|" FontSize="12"/>
                                    </Button>
                                </StackPanel>
                            </Border>

                            <!-- Right: volume + fullscreen + settings [+ dev toolbar] -->
                            <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="4"
                                        VerticalAlignment="Center" HorizontalAlignment="Right">
                                <Button Classes="control-pill"
                                        Command="{Binding Playback.Preview.ToggleMuteCommand}"
                                        IsEnabled="{Binding Playback.Preview.IsSourceMediaLoaded}"
                                        Padding="8,6" FontSize="11"
                                        ToolTip.Tip="Toggle mute"
                                        AutomationProperties.Name="Toggle Mute">
                                    <TextBlock Text="🔊" FontSize="12"/>
                                </Button>
                                <Slider Width="70"
                                        Orientation="Horizontal"
                                        Minimum="0"
                                        Maximum="1"
                                        Value="{Binding Playback.Preview.SourceVolume, Mode=TwoWay}"
                                        IsEnabled="{Binding Playback.Preview.IsSourceMediaLoaded}"
                                        VerticalAlignment="Center"
                                        Margin="2,0,6,0"
                                        ToolTip.Tip="Volume" />

                                <Button Classes="control-pill"
                                        Command="{Binding Playback.Preview.ToggleSegmentPaneCommand}"
                                        Padding="8,6" FontSize="11"
                                        ToolTip.Tip="Toggle side panels (S)"
                                        AutomationProperties.Name="Toggle side panes">
                                    <TextBlock Text="☰" FontSize="14"/>
                                </Button>

                                <Button Classes="control-pill"
                                        Command="{Binding Playback.Preview.ToggleFullscreenCommand}"
                                        IsEnabled="{Binding Playback.Preview.IsSourceMediaLoaded}"
                                        Padding="8,6" FontSize="11"
                                        ToolTip.Tip="Toggle fullscreen (F11)"
                                        AutomationProperties.Name="Toggle fullscreen">
                                    <TextBlock Text="⛶" FontSize="12"/>
                                </Button>

                                <Button Classes="control-pill"
                                        Click="OnSettingsClick"
                                        Padding="8,6" FontSize="11"
                                        ToolTip.Tip="Open settings"
                                        AutomationProperties.Name="Settings">
                                    <TextBlock Text="⚙" FontSize="14"/>
                                </Button>

                                <Border Margin="6,0,0,0"
                                        BorderBrush="#3A3010"
                                        BorderThickness="1,0,0,0"
                                        Padding="6,0,0,0"
                                        IsVisible="{x:Static bp:BuildInfo.IsDevBuild}">
                                    <StackPanel Orientation="Horizontal" Spacing="2">
                                        <Button Classes="dev-pill"
                                                x:Name="DevLogButton"
                                                Content="📋 Dev Log"
                                                Padding="6,5" FontSize="12"
                                                ToolTip.Tip="Open in-app dev log viewer" />
                                        <Button Classes="dev-pill"
                                                x:Name="FreshStartButton"
                                                Content="🔄 Fresh Start"
                                                Padding="6,5" FontSize="12"
                                                ToolTip.Tip="Cancel pipeline, wipe session temp files, reset UI" />
                                    </StackPanel>
                                </Border>

                            </StackPanel>

                        </Grid>
                    </ScrollViewer>

                    <!-- Compact: merged media + system controls on the left; transport centered -->
                    <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Disabled"
                                  HorizontalAlignment="Stretch"
                                  IsVisible="{Binding Playback.Preview.IsCompactVideoChrome}">
                        <Grid ColumnDefinitions="Auto,*">
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                <Button Classes="control-pill"
                                        Padding="10,8"
                                        FontSize="14"
                                        Background="Transparent"
                                        Click="OnOpenMediaClick"
                                        ToolTip.Tip="Open media file"
                                        AutomationProperties.Name="Open media">
                                    <TextBlock Text="📁" FontSize="14"/>
                                </Button>
                                <Button Content="{Binding Playback.Preview.SubtitleToggleLabel}"
                                        Classes="control-pill"
                                        Command="{Binding Playback.Preview.ToggleSubtitlesCommand}"
                                        IsEnabled="{Binding Playback.Preview.HasSegments}"
                                        Padding="8,6" FontSize="11"
                                        Background="Transparent"
                                        ToolTip.Tip="Toggle subtitles (C)"
                                        AutomationProperties.Name="Toggle subtitles" />
                                <Button Content="{Binding Playback.Preview.DubModeLabel}"
                                        Classes="control-pill"
                                        Classes.active="{Binding Playback.Preview.IsDubModeOn}"
                                        Command="{Binding Playback.Preview.ToggleDubModeCommand}"
                                        IsEnabled="{Binding Playback.Preview.HasSegments}"
                                        Padding="8,6" FontSize="11"
                                        Background="Transparent"
                                        ToolTip.Tip="Toggle Dub Mode (D)"
                                        AutomationProperties.Name="Toggle Dub Mode" />

                                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" Margin="6,0,0,0"
                                            IsVisible="{Binding Playback.Preview.IsDubModeOn}">
                                    <TextBlock Text="{Binding Playback.Preview.DubMixControlLabel}" FontSize="10" Foreground="#8A88A8" VerticalAlignment="Center" />
                                    <Slider Width="60"
                                            Orientation="Horizontal"
                                            Minimum="-30"
                                            Maximum="0"
                                            Value="{Binding Playback.Preview.DubMixControlDb, Mode=TwoWay}"
                                            IsEnabled="{Binding Playback.Preview.IsSourceMediaLoaded}"
                                            VerticalAlignment="Center"
                                            ToolTip.Tip="{Binding Playback.Preview.DubMixControlTooltip}" />
                                    <TextBlock Text="{Binding Playback.Preview.DubMixControlValueLabel}"
                                               FontSize="10"
                                               Foreground="#8A88A8"
                                               VerticalAlignment="Center"
                                               Width="30" />
                                </StackPanel>

                                <Border Width="1" Height="22" Margin="4,0,4,0" Background="{DynamicResource BorderBrush}" Opacity="0.5" VerticalAlignment="Center" />

                                <Button Classes="control-pill"
                                        Command="{Binding Playback.Preview.ToggleMuteCommand}"
                                        IsEnabled="{Binding Playback.Preview.IsSourceMediaLoaded}"
                                        Padding="8,6" FontSize="11"
                                        ToolTip.Tip="Toggle mute"
                                        AutomationProperties.Name="Toggle Mute">
                                    <TextBlock Text="🔊" FontSize="12"/>
                                </Button>
                                <Slider Width="70"
                                        Orientation="Horizontal"
                                        Minimum="0"
                                        Maximum="1"
                                        Value="{Binding Playback.Preview.SourceVolume, Mode=TwoWay}"
                                        IsEnabled="{Binding Playback.Preview.IsSourceMediaLoaded}"
                                        VerticalAlignment="Center"
                                        Margin="2,0,6,0"
                                        ToolTip.Tip="Volume" />

                                <Button Classes="control-pill"
                                        Command="{Binding Playback.Preview.ToggleSegmentPaneCommand}"
                                        Padding="8,6" FontSize="11"
                                        ToolTip.Tip="Toggle side panels (S)"
                                        AutomationProperties.Name="Toggle side panes">
                                    <TextBlock Text="☰" FontSize="14"/>
                                </Button>

                                <Button Classes="control-pill"
                                        Command="{Binding Playback.Preview.ToggleFullscreenCommand}"
                                        IsEnabled="{Binding Playback.Preview.IsSourceMediaLoaded}"
                                        Padding="8,6" FontSize="11"
                                        ToolTip.Tip="Toggle fullscreen (F11)"
                                        AutomationProperties.Name="Toggle fullscreen">
                                    <TextBlock Text="⛶" FontSize="12"/>
                                </Button>

                                <Button Classes="control-pill"
                                        Click="OnSettingsClick"
                                        Padding="8,6" FontSize="11"
                                        ToolTip.Tip="Open settings"
                                        AutomationProperties.Name="Settings">
                                    <TextBlock Text="⚙" FontSize="14"/>
                                </Button>

                                <Border Margin="6,0,0,0"
                                        BorderBrush="#3A3010"
                                        BorderThickness="1,0,0,0"
                                        Padding="6,0,0,0"
                                        IsVisible="{x:Static bp:BuildInfo.IsDevBuild}">
                                    <StackPanel Orientation="Horizontal" Spacing="2">
                                        <Button Classes="dev-pill"
                                                x:Name="DevLogButtonCompact"
                                                Content="📋 Dev Log"
                                                Padding="6,5" FontSize="12"
                                                ToolTip.Tip="Open in-app dev log viewer" />
                                        <Button Classes="dev-pill"
                                                x:Name="FreshStartButtonCompact"
                                                Content="🔄 Fresh Start"
                                                Padding="6,5" FontSize="12"
                                                ToolTip.Tip="Cancel pipeline, wipe session temp files, reset UI" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <Border Grid.Column="1" Classes="glass-rack" Padding="6,4"
                                    VerticalAlignment="Center" HorizontalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <Button Classes="control-pill"
                                            Command="{Binding Playback.Preview.SkipBackwardCommand}"
                                            IsEnabled="{Binding Playback.Preview.HasSegments}"
                                            Padding="10,6" FontSize="12"
                                            ToolTip.Tip="Skip to previous segment"
                                            AutomationProperties.Name="Skip to previous segment">
                                        <TextBlock Text="|◀" FontSize="12"/>
                                    </Button>
                                    <Button Classes="control-pill"
                                            Command="{Binding Playback.Preview.RewindCommand}"
                                            IsEnabled="{Binding Playback.Preview.IsSourceMediaLoaded}"
                                            Padding="10,6" FontSize="12"
                                            ToolTip.Tip="Rewind 10 seconds"
                                            AutomationProperties.Name="Rewind 10 seconds">
                                        <TextBlock Text="◀◀" FontSize="12"/>
                                    </Button>
                                    <Button Command="{Binding Playback.Preview.PlayPauseSourceCommand}"
                                            IsEnabled="{Binding Playback.Preview.IsSourceMediaLoaded}"
                                            Width="46" Height="46" Padding="0" Margin="4,0"
                                            CornerRadius="23" Background="{DynamicResource AccentBrush}"
                                            ToolTip.Tip="Play / Pause (Space)"
                                            AutomationProperties.Name="Play or pause">
                                        <Button.Styles>
                                            <Style Selector="Button:pointerover /template/ ContentPresenter">
                                                <Setter Property="Background" Value="{DynamicResource AccentSecondaryBrush}" />
                                            </Style>
                                        </Button.Styles>
                                        <TextBlock Text="{Binding Playback.Preview.PlayPauseSourceLabel}"
                                                   FontSize="{DynamicResource FontSizeTitle}"
                                                   FontWeight="Medium"
                                                   Foreground="White"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Button>
                                    <Button Classes="control-pill"
                                            Command="{Binding Playback.Preview.FastForwardCommand}"
                                            IsEnabled="{Binding Playback.Preview.IsSourceMediaLoaded}"
                                            Padding="10,6" FontSize="12"
                                            ToolTip.Tip="Fast forward 10 seconds"
                                            AutomationProperties.Name="Fast forward 10 seconds">
                                        <TextBlock Text="▶▶" FontSize="12"/>
                                    </Button>
                                    <Button Classes="control-pill"
                                            Command="{Binding Playback.Preview.SkipForwardCommand}"
                                            IsEnabled="{Binding Playback.Preview.HasSegments}"
                                            Padding="10,6" FontSize="12"
                                            ToolTip.Tip="Skip to next segment"
                                            AutomationProperties.Name="Skip to next segment">
                                        <TextBlock Text="▶|" FontSize="12"/>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </Border>

        </Grid>

    </Grid>
    </Grid>

</Window>
