<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Babel.Player.ViewModels"
        xmlns:v="using:Babel.Player.Views"
        xmlns:bp="using:Babel.Player"
        xmlns:models="using:Babel.Player.Models"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="700"
        x:Class="Babel.Player.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/Icons/app.ico"
        Width="1280" Height="700"
        MinWidth="960" MinHeight="520"
        WindowDecorations="None"
        ExtendClientAreaToDecorationsHint="True"
        Background="{DynamicResource WindowBackgroundBrush}">
    <Window.Styles>
        <Style Selector="Border.left-pane">
            <Setter Property="Width" Value="260" />
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="Border.left-pane.collapsed">
            <Setter Property="Width" Value="0" />
            <Setter Property="Opacity" Value="0" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <Style Selector="Border.right-pane">
            <Setter Property="Width" Value="280" />
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="Border.right-pane.collapsed">
            <Setter Property="Width" Value="0" />
            <Setter Property="Opacity" Value="0" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <Style Selector="Border.top-chrome">
            <Setter Property="Height" Value="40" />
            <Setter Property="Opacity" Value="1" />
            <Setter Property="ClipToBounds" Value="True" />
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <TranslateTransform Y="0" />
                </Setter.Value>
            </Setter>
        </Style>
        <Style Selector="Border.top-chrome.fullscreen-hidden">
            <Setter Property="Height" Value="0" />
            <Setter Property="Opacity" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="TranslateTransform.Y" Value="-8" />
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,*" ColumnDefinitions="Auto,*,Auto" PointerMoved="OnWindowSurfacePointerMoved">
        <Border Grid.Row="0"
                Classes="top-chrome"
                Classes.fullscreen-hidden="{Binding Playback.Preview.IsFullscreen}"
                Grid.ColumnSpan="3"
                Background="{DynamicResource SurfaceSubtleBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="10,0,0,0"
                PointerPressed="OnTitleBarPointerPressed">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                <TextBlock Grid.Column="0"
                           Text="Babel Player"
                           Foreground="{DynamicResource PrimaryTextBrush}"
                           FontSize="13"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center" />
                <!-- Win11-style: zero gap, square targets, flush to the right window edge (no right padding on chrome Border). -->
                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            Spacing="0"
                            VerticalAlignment="Stretch"
                            HorizontalAlignment="Right"
                            UseLayoutRounding="True">
                    <Button Classes="chrome-button"
                            Width="40"
                            Height="40"
                            Background="{DynamicResource ButtonBackgroundBrush}"
                            Foreground="{DynamicResource PrimaryTextBrush}"
                            Click="OnMinimizeWindowClick"
                            AutomationProperties.Name="Minimize window">
                        <Viewbox Width="11" Height="11">
                            <Canvas Width="24" Height="24">
                                <Border Canvas.Left="5"
                                        Canvas.Top="11"
                                        Width="14"
                                        Height="2"
                                        Background="{DynamicResource PrimaryTextBrush}"
                                        CornerRadius="1" />
                            </Canvas>
                        </Viewbox>
                    </Button>
                    <Button Classes="chrome-button"
                            Width="40"
                            Height="40"
                            Background="{DynamicResource ButtonBackgroundBrush}"
                            Foreground="{DynamicResource PrimaryTextBrush}"
                            Click="OnToggleMaximizeWindowClick"
                            AutomationProperties.Name="Maximize or restore window">
                        <Grid Width="24" Height="24">
                            <Viewbox x:Name="ChromeMaximizeIcon"
                                     Width="11"
                                     Height="11"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center">
                                <Canvas Width="24" Height="24">
                                    <Rectangle Canvas.Left="6"
                                               Canvas.Top="6"
                                               Width="12"
                                               Height="12"
                                               Stroke="{DynamicResource PrimaryTextBrush}"
                                               StrokeThickness="1.5"
                                               Fill="Transparent" />
                                </Canvas>
                            </Viewbox>
                            <Viewbox x:Name="ChromeRestoreIcon"
                                     Width="11"
                                     Height="11"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"
                                     IsVisible="False">
                                <Canvas Width="24" Height="24">
                                    <Rectangle Canvas.Left="9"
                                               Canvas.Top="5"
                                               Width="9"
                                               Height="9"
                                               Stroke="{DynamicResource PrimaryTextBrush}"
                                               StrokeThickness="1.5"
                                               Fill="Transparent" />
                                    <Rectangle Canvas.Left="5"
                                               Canvas.Top="9"
                                               Width="9"
                                               Height="9"
                                               Stroke="{DynamicResource PrimaryTextBrush}"
                                               StrokeThickness="1.5"
                                               Fill="Transparent" />
                                </Canvas>
                            </Viewbox>
                        </Grid>
                    </Button>
                    <Button Classes="chrome-button chrome-close"
                            Width="40"
                            Height="40"
                            Background="{DynamicResource DestructiveBrush}"
                            Foreground="{DynamicResource PrimaryTextBrush}"
                            Click="OnCloseWindowClick"
                            AutomationProperties.Name="Close window">
                        <Viewbox Width="11" Height="11">
                            <Canvas Width="24" Height="24">
                                <Path Stroke="{DynamicResource PrimaryTextBrush}"
                                      StrokeThickness="1.5"
                                      StrokeLineCap="Round"
                                      Stretch="None"
                                      Data="M 7,7 L 17,17 M 17,7 L 7,17" />
                            </Canvas>
                        </Viewbox>
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Close"
                                          Click="OnCloseWindowClick" />
                                <MenuItem Header="Force Close"
                                          Click="OnForceCloseWindowClick" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══════════════════════════════════════════════════
             LEFT PANEL: Pipeline
             ═══════════════════════════════════════════════════ -->
<Border Grid.Row="1" Grid.Column="0" Background="{DynamicResource PanelBackgroundBrush}"
        Classes="left-pane"
        Classes.collapsed="{Binding !Playback.Preview.IsSegmentPaneVisible}"
        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0"
        >
    <Border.Resources>
        <!-- Shadow the Application ThemeDictionary for all panel descendants.
             These values apply in both Light and Dark mode — the panel is always dark. -->
        <SolidColorBrush x:Key="PrimaryTextBrush"        Color="#E0DEFF" />
        <SolidColorBrush x:Key="StatusTextBrush"         Color="#8A88A8" />
        <SolidColorBrush x:Key="ControlBackgroundBrush"  Color="#1E1E2E" />
        <SolidColorBrush x:Key="ButtonBackgroundBrush"   Color="#2A2A3A" />
        <SolidColorBrush x:Key="BorderBrush"        Color="#2E2E44" />
        <SolidColorBrush x:Key="ProgressBackgroundBrush" Color="#2A2A3A" />
    </Border.Resources>
            <Grid RowDefinitions="Auto,*,Auto">

                <!-- Header -->
<Border Grid.Row="0" Padding="16,14,16,12"
        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
<TextBlock Grid.Column="0" Text="Pipeline" FontSize="15" FontWeight="SemiBold"
                                    Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center" />
<Button Grid.Column="1"
                                 Padding="8,4" FontSize="11"
                                 Background="{DynamicResource ButtonBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"
                                 CornerRadius="4"
                                 Command="{Binding Playback.Pipeline.ClearPipelineCommand}"
                                 ToolTip.Tip="Clear pipeline and start fresh">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Text="🗑" FontSize="10" />
                                <TextBlock Text="Clear" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <!-- Scrollable body with sticky footer overlay -->
                <Grid Grid.Row="1">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="16,16,16,0" Spacing="20">

                        <!-- TARGET LANGUAGE -->
                        <StackPanel Spacing="10">
                            <TextBlock Text="TARGET LANGUAGE" FontSize="10"
                                       Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="SemiBold" />
                            <StackPanel Spacing="5">
                                <TextBlock Text="Output (dub / subs)" FontSize="12" Foreground="{DynamicResource PrimaryTextBrush}" />
                                <ComboBox ItemsSource="{Binding Playback.TargetLanguageOptions}"
                                          SelectedItem="{Binding Playback.SelectedTargetLanguageOption, Mode=TwoWay}"
                                          HorizontalAlignment="Stretch" FontSize="12"
                                          Background="{DynamicResource ControlBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"
                                          BorderBrush="{DynamicResource BorderBrush}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding DisplayName}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>
                        </StackPanel>

                        <!-- TRANSCRIPTION -->
                        <StackPanel Spacing="10">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                <TextBlock Grid.Column="0" Text="TRANSCRIPTION" FontSize="10"
                                           Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="SemiBold"
                                           VerticalAlignment="Center" />
                                <Button Grid.Column="1"
                                        Command="{Binding Playback.Pipeline.RefreshTranscriptionCommand}"
                                        IsEnabled="{Binding Playback.Pipeline.CanRefreshTranscription}"
                                        Background="Transparent" Padding="6,2"
                                        Foreground="{DynamicResource StatusTextBrush}"
                                        ToolTip.Tip="Re-run transcription (choose this stage only or include downstream)">
                                    <TextBlock Text="↻" FontSize="16" />
                                    <Button.Styles>
                                        <Style Selector="Button:pointerover /template/ ContentPresenter">
                                            <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}" />
                                            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
                                        </Style>
                                    </Button.Styles>
                                </Button>
                            </Grid>

                             <StackPanel Spacing="5">
                                 <TextBlock Text="Compute" FontSize="12" Foreground="{DynamicResource PrimaryTextBrush}" />
<ComboBox ItemsSource="{Binding Playback.InferenceRuntimeOptions}"
                                           SelectedItem="{Binding Playback.TranscriptionRuntime, Mode=TwoWay}"
                                            HorizontalAlignment="Stretch" FontSize="12"
                                           Background="{DynamicResource ControlBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"
                                           BorderBrush="{DynamicResource BorderBrush}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Converter={StaticResource ComputeProfileDisplayConverter}}"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>

                             <StackPanel Spacing="5">
                                 <TextBlock Text="Provider" FontSize="12" Foreground="{DynamicResource PrimaryTextBrush}" />
                                 <ComboBox ItemsSource="{Binding Playback.TranscriptionProviders}"
                                           SelectedItem="{Binding Playback.TranscriptionProvider, Mode=TwoWay}"
                                           HorizontalAlignment="Stretch" FontSize="12"
                                           Background="{DynamicResource ControlBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"
                                           BorderBrush="{DynamicResource BorderBrush}" />
                            </StackPanel>

<StackPanel Spacing="5">
                                 <TextBlock Text="Model" FontSize="12" Foreground="{DynamicResource PrimaryTextBrush}" />
<ComboBox ItemsSource="{Binding Playback.AvailableTranscriptionModels}"
                                            SelectedItem="{Binding Playback.SelectedTranscriptionModel, Mode=TwoWay}"
                                           HorizontalAlignment="Stretch" FontSize="12"
                                           Background="{DynamicResource ControlBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"
                                           BorderBrush="{DynamicResource BorderBrush}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <TextBlock Text="{Binding ModelId}"/>
                                                 <TextBlock Text="⬇ Needs Download" Foreground="{DynamicResource StatusTextBrush}" IsVisible="{Binding IsDownloadVisible, FallbackValue=False}" FontSize="10" VerticalAlignment="Center"/>
                                                 <TextBlock Text="✓ Ready" Foreground="{DynamicResource StatusTextBrush}" IsVisible="{Binding IsReadyVisible, FallbackValue=False}" FontSize="10" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Spacing="5">
                                <TextBlock Text="Spoken language (ASR hint)" FontSize="12" Foreground="{DynamicResource PrimaryTextBrush}" />
                                <ComboBox ItemsSource="{Binding Playback.SpokenLanguageOptions}"
                                          SelectedItem="{Binding Playback.SelectedSpokenLanguageOption, Mode=TwoWay}"
                                          HorizontalAlignment="Stretch" FontSize="12"
                                          Background="{DynamicResource ControlBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"
                                          BorderBrush="{DynamicResource BorderBrush}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding DisplayName}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>

                            <TextBlock Text="{Binding Playback.TranscriptionKeyStatus}"
                                        FontSize="11" Foreground="{DynamicResource StatusTextBrush}"
                                        IsVisible="{Binding Playback.TranscriptionKeyStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                        TextWrapping="Wrap" />
                        </StackPanel>

                        <!-- DIARIZATION / SPEAKERS -->
                        <StackPanel Spacing="10">
                            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,10,0,0">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                    <TextBlock Grid.Column="0" Text="DIARIZATION / SPEAKERS" FontSize="10"
                                               Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="SemiBold"
                                               VerticalAlignment="Center" />
                                    <Button Grid.Column="1"
                                            Command="{Binding Playback.Pipeline.RefreshDiarizationCommand}"
                                            IsEnabled="{Binding Playback.Pipeline.CanRefreshDiarization}"
                                            Background="Transparent" Padding="6,2"
                                            Foreground="{DynamicResource StatusTextBrush}"
                                            ToolTip.Tip="Re-run speaker mapping (choose this stage only or include downstream)">
                                        <TextBlock Text="↻" FontSize="16" />
                                        <Button.Styles>
                                            <Style Selector="Button:pointerover /template/ ContentPresenter">
                                                <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}" />
                                                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
                                            </Style>
                                        </Button.Styles>
                                    </Button>
                                </Grid>
                            </Border>

                            <StackPanel Spacing="5">
                                <TextBlock Text="Diarization Provider" FontSize="12" Foreground="{DynamicResource PrimaryTextBrush}" />
                                <ComboBox ItemsSource="{Binding Playback.SpeakerRouting.DiarizationProviderOptions}"
                                          SelectedItem="{Binding Playback.SpeakerRouting.DiarizationProvider, Mode=TwoWay}"
                                          HorizontalAlignment="Stretch" FontSize="12"
                                          Background="{DynamicResource ControlBackgroundBrush}"
                                          Foreground="{DynamicResource PrimaryTextBrush}"
                                          BorderBrush="{DynamicResource BorderBrush}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Converter={StaticResource DiarizationProviderDisplayConverter}}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>

                            <!-- Status -->
                            <TextBlock Text="{Binding Playback.SpeakerRouting.AutoSpeakerDetectionStatus}"
                                       FontSize="11"
                                       Foreground="{DynamicResource StatusTextBrush}"
                                       IsVisible="{Binding Playback.SpeakerRouting.HasAutoSpeakerDetectionStatus}"
                                       TextWrapping="Wrap" />

                            <!-- Per-speaker voice / reference clip assignment -->
                            <StackPanel Spacing="5">

                                <!-- Hint shown when no speaker IDs have been detected yet -->
                                <TextBlock Text="Transcribe with a diarization provider selected to assign speaker IDs."
                                           FontSize="11" Foreground="{DynamicResource StatusTextBrush}" TextWrapping="Wrap"
                                           IsVisible="{Binding Playback.SpeakerRouting.IsMultiSpeakerNoSpeakersYet}" />

                                <TextBlock Text="Speaker assignments are managed in the speaker setup wizard."
                                           FontSize="11"
                                           Foreground="{DynamicResource StatusTextBrush}"
                                           TextWrapping="Wrap" />

                               <Button IsEnabled="{Binding Playback.SpeakerRouting.CanOpenSpeakerSetupWizard}"
                                       HorizontalAlignment="Stretch"
                                       Padding="0,7" FontSize="12"
                                       Background="{DynamicResource ButtonBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"
                                       CornerRadius="4"
                                       Click="OnReviewSpeakerReferencesClick"
                                       ToolTip.Tip="Opens the speaker setup wizard: per-speaker voice and (for Qwen) reference clips. Finish in the wizard saves changes."
                                       Content="Speaker setup wizard…" />

                           </StackPanel>

                       </StackPanel>

                        <!-- TRANSLATION -->
                        <StackPanel Spacing="10">
                            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,10,0,0">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                    <TextBlock Grid.Column="0" Text="TRANSLATION" FontSize="10"
                                               Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="SemiBold"
                                               VerticalAlignment="Center" />
                                    <Button Grid.Column="1"
                                            Command="{Binding Playback.Pipeline.RefreshTranslationCommand}"
                                            IsEnabled="{Binding Playback.Pipeline.CanRefreshTranslation}"
                                            Background="Transparent" Padding="6,2"
                                            Foreground="{DynamicResource StatusTextBrush}"
                                            ToolTip.Tip="Re-run translation (choose this stage only or include dub)">
                                        <TextBlock Text="↻" FontSize="16" />
                                        <Button.Styles>
                                            <Style Selector="Button:pointerover /template/ ContentPresenter">
                                                <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}" />
                                                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
                                            </Style>
                                        </Button.Styles>
                                    </Button>
                                </Grid>
                            </Border>

                            <StackPanel Spacing="5">
                                <TextBlock Text="Compute" FontSize="12" Foreground="{DynamicResource PrimaryTextBrush}" />
                                <ComboBox ItemsSource="{Binding Playback.InferenceRuntimeOptions}"
                                          SelectedItem="{Binding Playback.TranslationRuntime, Mode=TwoWay}"
                                          HorizontalAlignment="Stretch" FontSize="12"
                                          Background="{DynamicResource ControlBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"
                                          BorderBrush="{DynamicResource BorderBrush}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Converter={StaticResource ComputeProfileDisplayConverter}}"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Spacing="5">
                                <TextBlock Text="Provider" FontSize="12" Foreground="{DynamicResource PrimaryTextBrush}" />
                                <ComboBox ItemsSource="{Binding Playback.TranslationProviders}"
                                          SelectedItem="{Binding Playback.TranslationProvider, Mode=TwoWay}"
                                          HorizontalAlignment="Stretch" FontSize="12"
                                          Background="{DynamicResource ControlBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"
                                          BorderBrush="{DynamicResource BorderBrush}" />
                            </StackPanel>

                            <StackPanel Spacing="5">
                                <TextBlock Text="Model" FontSize="12" Foreground="{DynamicResource PrimaryTextBrush}" />
                                <ComboBox ItemsSource="{Binding Playback.AvailableTranslationModels}"
                                          SelectedItem="{Binding Playback.SelectedTranslationModel, Mode=TwoWay}"
                                          HorizontalAlignment="Stretch" FontSize="12"
                                          Background="{DynamicResource ControlBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"
                                          BorderBrush="{DynamicResource BorderBrush}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <TextBlock Text="{Binding ModelId}"/>
                                                <TextBlock Text="⬇ Needs Download" Foreground="{DynamicResource StatusTextBrush}" IsVisible="{Binding IsDownloadVisible, FallbackValue=False}" FontSize="10" VerticalAlignment="Center"/>
                                                <TextBlock Text="✓ Ready" Foreground="{DynamicResource StatusTextBrush}" IsVisible="{Binding IsReadyVisible, FallbackValue=False}" FontSize="10" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>
                        </StackPanel>

                        <!-- DUB -->
                        <StackPanel Spacing="10">
                            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,10,0,0">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                    <TextBlock Grid.Column="0" Text="DUB" FontSize="10"
                                               Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="SemiBold"
                                               VerticalAlignment="Center" />
                                    <Button Grid.Column="1"
                                            Command="{Binding Playback.Pipeline.RefreshDubCommand}"
                                            IsEnabled="{Binding Playback.Pipeline.CanRefreshDub}"
                                            Background="Transparent" Padding="6,2"
                                            Foreground="{DynamicResource StatusTextBrush}"
                                            ToolTip.Tip="Re-generate dub audio from the current translation">
                                        <TextBlock Text="↻" FontSize="16" />
                                        <Button.Styles>
                                            <Style Selector="Button:pointerover /template/ ContentPresenter">
                                                <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}" />
                                                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
                                            </Style>
                                        </Button.Styles>
                                    </Button>
                                </Grid>
                            </Border>

                            <StackPanel Spacing="5">
                                <TextBlock Text="Compute" FontSize="12" Foreground="{DynamicResource PrimaryTextBrush}" />
                                <ComboBox ItemsSource="{Binding Playback.InferenceRuntimeOptions}"
                                          SelectedItem="{Binding Playback.TtsRuntime, Mode=TwoWay}"
                                          HorizontalAlignment="Stretch" FontSize="12"
                                          Background="{DynamicResource ControlBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"
                                          BorderBrush="{DynamicResource BorderBrush}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Converter={StaticResource ComputeProfileDisplayConverter}}"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Spacing="5">
                                <TextBlock Text="Provider" FontSize="12" Foreground="{DynamicResource PrimaryTextBrush}" />
                                <ComboBox ItemsSource="{Binding Playback.TtsProviders}"
                                          SelectedItem="{Binding Playback.TtsProvider, Mode=TwoWay}"
                                          HorizontalAlignment="Stretch" FontSize="12"
                                          Background="{DynamicResource ControlBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"
                                          BorderBrush="{DynamicResource BorderBrush}" />
                            </StackPanel>

                            <StackPanel Spacing="6" IsVisible="{Binding Playback.ShowTtsAssignmentModeSwitch}">
                                <TextBlock Text="Voice assignment" FontSize="12" Foreground="{DynamicResource PrimaryTextBrush}" />
                                <CheckBox Content="Assign per speaker in Speaker Reference Wizard (fallback voice below)"
                                          IsChecked="{Binding Playback.TtsVoiceUsePerSpeakerWizard, Mode=TwoWay}"
                                          FontSize="12" />
                                <TextBlock Text="Use one voice for every speaker, or turn on the option above and set a fallback plus per-speaker voices in the wizard."
                                           FontSize="11" Opacity="0.75" TextWrapping="Wrap"
                                           IsVisible="{Binding Playback.ShowPerSpeakerVoiceHint}" />
                            </StackPanel>

                            <StackPanel Spacing="5">
                                <TextBlock FontSize="12" Foreground="{DynamicResource PrimaryTextBrush}"
                                           Text="{Binding Playback.TtsVoiceComboHeaderText}" />
                                <ComboBox ItemsSource="{Binding Playback.AvailableTtsOptions}"
                                          SelectedItem="{Binding Playback.SelectedTtsOption, Mode=TwoWay}"
                                          HorizontalAlignment="Stretch" FontSize="12"
                                          Background="{DynamicResource ControlBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"
                                          BorderBrush="{DynamicResource BorderBrush}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <TextBlock Text="{Binding ModelId}"/>
                                                <TextBlock Text="⬇ Needs Download" Foreground="{DynamicResource StatusTextBrush}" IsVisible="{Binding IsDownloadVisible, FallbackValue=False}" FontSize="10" VerticalAlignment="Center"/>
                                                <TextBlock Text="✓ Ready" Foreground="{DynamicResource StatusTextBrush}" IsVisible="{Binding IsReadyVisible, FallbackValue=False}" FontSize="10" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>

                            <TextBlock Text="{Binding Playback.TtsKeyStatus}"
                                       FontSize="11" Foreground="{DynamicResource StatusTextBrush}"
                                       IsVisible="{Binding Playback.TtsKeyStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                       TextWrapping="Wrap" />
                        </StackPanel>

                         <!-- API KEYS -->
                         <StackPanel Spacing="8">
                             <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,10,0,0">
                                 <TextBlock Text="API KEYS" FontSize="10"
                                            Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="SemiBold" />
                             </Border>

                             <TextBlock Text="Configure credentials for the providers selected above."
                                        FontSize="11"
                                        Foreground="{DynamicResource PrimaryTextBrush}"
                                        TextWrapping="Wrap" />

                             <Button HorizontalAlignment="Stretch"
                                     HorizontalContentAlignment="Left"
                                     Padding="10,8"
                                     FontSize="12"
                                     Background="{DynamicResource ControlBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"
                                     BorderBrush="{DynamicResource BorderBrush}"
                                     CornerRadius="4"
                                     Click="OnApiKeysClick">
                                 <StackPanel Orientation="Horizontal" Spacing="5">
                                     <TextBlock Text="🔑" VerticalAlignment="Center" />
                                     <TextBlock Text="Manage API Keys" VerticalAlignment="Center" />
                                 </StackPanel>
                             </Button>
                        </StackPanel>

                         <!-- LANGUAGE ROUTING -->
                         <StackPanel Spacing="10">
                             <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,10,0,0">
                                 <TextBlock Text="LANGUAGE ROUTING" FontSize="10"
                                            Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="SemiBold" />
                             </Border>

                             <Grid ColumnDefinitions="*,Auto">
                                 <TextBlock Grid.Column="0" Text="Source Audio" FontSize="12"
                                            Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center" />
                                 <Border Grid.Column="1" Background="{DynamicResource ControlBackgroundBrush}" CornerRadius="4"
                                         Padding="8,4">
                                     <TextBlock Text="{Binding Coordinator.CurrentSession.SourceLanguage, TargetNullValue='—'}"
                                                FontSize="12" Foreground="{DynamicResource PrimaryTextBrush}" />
                                 </Border>
                             </Grid>

                             <Grid ColumnDefinitions="*,Auto">
                                 <TextBlock Grid.Column="0" Text="Target Sub/Dub" FontSize="12"
                                            Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center" />
                                 <Border Grid.Column="1" Background="{DynamicResource ControlBackgroundBrush}" CornerRadius="4"
                                         Padding="8,4">
                                     <TextBlock Text="{Binding Coordinator.CurrentSession.TargetLanguage, TargetNullValue='—'}"
                                                FontSize="12" Foreground="{DynamicResource PrimaryTextBrush}" />
                                 </Border>
                             </Grid>
                        </StackPanel>

                        <!-- ACTIVE CONFIGURATION -->
                        <StackPanel Spacing="8">
                            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,10,0,0">
                                <TextBlock Text="ACTIVE CONFIG" FontSize="10"
                                            Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="SemiBold" />
                            </Border>

                            <Grid ColumnDefinitions="56,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="4">
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="ASR"
                                           FontSize="11" Foreground="{DynamicResource PrimaryTextBrush}" />
                                <TextBlock Grid.Row="0" Grid.Column="1"
                                           Text="{Binding Playback.ActiveTranscriptionConfigLine}"
                                           FontSize="11" Foreground="{DynamicResource PrimaryTextBrush}" TextWrapping="Wrap" />

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="CPU"
                                           FontSize="11" Foreground="{DynamicResource PrimaryTextBrush}" />
                                <TextBlock Grid.Row="1" Grid.Column="1"
                                           Text="{Binding Playback.ActiveCpuTuningLine}"
                                           FontSize="11" Foreground="{DynamicResource PrimaryTextBrush}" TextWrapping="Wrap" />

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="GPU"
                                           FontSize="11" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Top" />
                                <TextBlock Grid.Row="2" Grid.Column="1"
                                           Text="{Binding Playback.HwGpuLine}"
                                           FontSize="11" Foreground="{DynamicResource StatusTextBrush}" TextWrapping="Wrap" />

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="NMT"
                                           FontSize="11" Foreground="{DynamicResource PrimaryTextBrush}" />
                                <TextBlock Grid.Row="3" Grid.Column="1"
                                           Text="{Binding Playback.ActiveTranslationConfigLine}"
                                           FontSize="11" Foreground="{DynamicResource PrimaryTextBrush}" TextWrapping="Wrap" />

                                <TextBlock Grid.Row="4" Grid.Column="0" Text="TTS"
                                           FontSize="11" Foreground="{DynamicResource PrimaryTextBrush}" />
                                <TextBlock Grid.Row="4" Grid.Column="1"
                                           Text="{Binding Playback.HwNpuLine}"
                                           FontSize="11" Foreground="{DynamicResource StatusTextBrush}" TextWrapping="Wrap" />

                                <TextBlock Grid.Row="5" Grid.Column="0" Text="RAM"
                                           FontSize="11" Foreground="{DynamicResource PrimaryTextBrush}" />
                                <TextBlock Grid.Row="5" Grid.Column="1"
                                           Text="{Binding Playback.HwRamLine}"
                                           FontSize="11" Foreground="{DynamicResource StatusTextBrush}" TextWrapping="Wrap" />
                            </Grid>
                        </StackPanel>

                        <!-- PROVIDER DIAGNOSTICS -->
                        <StackPanel Spacing="8">
                            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,10,0,0">
                                <TextBlock Text="PROVIDER DIAGNOSTICS" FontSize="10"
                                            Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="SemiBold" />
                            </Border>

                            <ItemsControl ItemsSource="{Binding Playback.ProviderHealthSnapshots}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ProviderHealthSnapshot">
                                        <Border Padding="10,8"
                                                Background="{DynamicResource ControlBackgroundBrush}"
                                                BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="6"
                                                Margin="0,0,0,6">
                                            <StackPanel Spacing="4">
                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                    <TextBlock Grid.Column="0"
                                                               Text="{Binding Section}"
                                                               FontSize="12"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource PrimaryTextBrush}" />
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding StatusLine}"
                                                               FontSize="11"
                                                               Foreground="{DynamicResource StatusTextBrush}"
                                                               HorizontalAlignment="Right" />
                                                </Grid>

                                                <TextBlock Text="{Binding SelectionLabel}"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                                           TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding Detail}"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource StatusTextBrush}"
                                                           TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding HostState}"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource StatusTextBrush}"
                                                           TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding MetricsText}"
                                                           FontSize="10"
                                                           Foreground="{DynamicResource StatusTextBrush}"
                                                           TextWrapping="Wrap"
                                                           IsVisible="{Binding MetricsText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <TextBlock Text="{Binding CheckedAtText}"
                                                               FontSize="10"
                                                               Foreground="{DynamicResource StatusTextBrush}" />
                                                    <TextBlock Text="stale"
                                                               FontSize="10"
                                                               Foreground="{DynamicResource StatusTextBrush}"
                                                               IsVisible="{Binding IsStale}" />
                                                </StackPanel>

                                                <ItemsControl ItemsSource="{Binding History}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding}"
                                                                       FontSize="10"
                                                                       Foreground="{DynamicResource StatusTextBrush}"
                                                                       TextWrapping="Wrap" />
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <Border Height="260"
                                Background="Transparent"
                                IsHitTestVisible="False" />
                        </StackPanel>
                    </ScrollViewer>

                    <Border VerticalAlignment="Bottom"
                            Background="{DynamicResource PanelBackgroundBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="0,1,0,0"
                            Padding="16,14,16,16">
                        <StackPanel Spacing="10">
                            <StackPanel Spacing="6"
                                       IsVisible="{Binding Playback.Pipeline.ShowPipelineStatusChrome}">
                                <TextBlock Text="{Binding Playback.Pipeline.PipelineStageDetail}"
                                           FontSize="11"
                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="{Binding Playback.Pipeline.PipelineProgressStatusLine}"
                                           FontSize="10"
                                           Foreground="{DynamicResource StatusTextBrush}"
                                           TextWrapping="Wrap" />
                                <ProgressBar Minimum="0"
                                             Maximum="1"
                                             Value="{Binding Playback.Pipeline.PipelineProgressPercent}"
                                             IsIndeterminate="{Binding Playback.Pipeline.IsPipelineProgressIndeterminate}"
                                             Height="8"
                                             Foreground="{DynamicResource AccentSecondaryBrush}"
                                             Background="{DynamicResource ProgressBackgroundBrush}"
                                             HorizontalAlignment="Stretch"
                                             Margin="0,2,0,0"
                                             AutomationProperties.Name="Pipeline progress" />
                            </StackPanel>

                            <Grid>
                                <Button HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Center"
                                        VerticalContentAlignment="Center"
                                        Padding="0,10"
                                        FontSize="13"
                                        FontWeight="SemiBold"
                                        Foreground="White"
                                        CornerRadius="8"
                                        Command="{Binding Playback.Pipeline.RunPipelineCommand}"
                                        IsEnabled="{Binding Playback.Pipeline.CanRunPipeline}"
                                        IsVisible="{Binding !Playback.IsBusy}">
                                    <Button.Content>
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="▶" VerticalAlignment="Center" />
                                            <TextBlock Text="Run Pipeline" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button.Content>
                                    <Button.Styles>
                                        <Style Selector="Button">
                                            <Setter Property="Background">
                                                <Setter.Value>
                                                    <LinearGradientBrush StartPoint="0%,50%" EndPoint="100%,50%">
                                                        <GradientStop Color="{DynamicResource AccentColor}" Offset="0" />
                                                        <GradientStop Color="{DynamicResource AccentSecondaryColor}" Offset="1" />
                                                    </LinearGradientBrush>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                        <Style Selector="Button:pointerover /template/ ContentPresenter">
                                            <Setter Property="Background">
                                                <Setter.Value>
                                                    <LinearGradientBrush StartPoint="0%,50%" EndPoint="100%,50%">
                                                        <GradientStop Color="#5B52F0" Offset="0" />
                                                        <GradientStop Color="#8B4DF8" Offset="1" />
                                                    </LinearGradientBrush>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                        <Style Selector="Button:pressed /template/ ContentPresenter">
                                            <Setter Property="Background">
                                                <Setter.Value>
                                                    <LinearGradientBrush StartPoint="0%,50%" EndPoint="100%,50%">
                                                        <GradientStop Color="#3D35C8" Offset="0" />
                                                        <GradientStop Color="#6A2FCC" Offset="1" />
                                                    </LinearGradientBrush>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </Button.Styles>
                                </Button>

                                <Button HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Center"
                                        VerticalContentAlignment="Center"
                                        Padding="0,10"
                                        FontSize="13"
                                        FontWeight="SemiBold"
                                        Background="{DynamicResource DestructiveBrush}"
                                        Foreground="White"
                                        CornerRadius="8"
                                        Command="{Binding Playback.Pipeline.CancelPipelineCommand}"
                                        IsVisible="{Binding Playback.IsBusy}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="⏹" VerticalAlignment="Center" />
                                        <TextBlock Text="Cancel Pipeline" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <TextBlock Grid.Column="0"
                                           Text="{Binding Playback.StatusText}"
                                           FontSize="11"
                                           Foreground="{DynamicResource StatusTextBrush}"
                                           HorizontalAlignment="Center"
                                           TextWrapping="Wrap"
                                           MaxHeight="52" />

                                <Button Grid.Column="1"
                                        Command="{Binding Playback.ShowStatusErrorDetailsCommand}"
                                        IsVisible="{Binding Playback.HasErrorDetails}"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Bottom"
                                        Padding="6,2"
                                        MinWidth="24"
                                        FontSize="12"
                                        Background="{DynamicResource ButtonBackgroundBrush}"
                                        Foreground="{DynamicResource PrimaryTextBrush}"
                                        CornerRadius="4"
                                        ToolTip.Tip="Expand error details">
                                    <TextBlock Text="↗" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>

            </Grid>
        </Border>

        <!-- ═══════════════════════════════════════════════════
             CENTER PANEL: Video player
             ═══════════════════════════════════════════════════ -->
        <Grid Grid.Row="1" Grid.Column="1" RowDefinitions="Auto,*,Auto,Auto"
              Background="{DynamicResource WindowBackgroundBrush}">

            <!-- Diagnostics warning bar (hidden when all deps available) -->
            <Border Grid.Row="0" Background="{DynamicResource WarningBackgroundBrush}" Padding="10,5"
                    BorderBrush="{DynamicResource WarningBorderBrush}" BorderThickness="0,0,0,1"
                    IsVisible="{Binding Playback.ShowDiagnosticsWarningBanner}">
                <TextBlock Text="{Binding Playback.DiagnosticsWarningText}"
                                FontSize="11" Foreground="{DynamicResource StatusTextBrush}" />
            </Border>

            <!-- Video surface -->
            <Grid Grid.Row="1">
                <Border Background="Black" Margin="0">
                    <v:MpvVideoView x:Name="VideoView" />
                </Border>
                <Border HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="12"
                        Padding="10,6"
                        Background="{DynamicResource SurfaceRaisedBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        IsVisible="{Binding Playback.HasVsrPlaybackStatus}">
                    <TextBlock Text="{Binding Playback.VsrPlaybackStatusText}"
                               FontSize="11"
                               Foreground="{DynamicResource VideoOverlayTextBrush}"
                               TextWrapping="Wrap" />
                </Border>
                <Panel x:Name="VideoOverlayPanel" Background="Transparent" />

            </Grid>

            <!-- Scrub bar -->
            <Border Grid.Row="2" Padding="12,5"
                    IsVisible="{Binding Playback.Preview.IsControlsVisible}">
                <Grid ColumnDefinitions="40,*,40">
                     <TextBlock Grid.Column="0"
                                Text="{Binding Playback.Preview.SourcePositionFormatted}"
                                FontSize="11" Foreground="{DynamicResource VideoOverlaySubtextBrush}"
                                VerticalAlignment="Center" />
                    <Slider Grid.Column="1"
                            Minimum="0"
                            Maximum="{Binding Playback.Preview.SourceDurationMs}"
                            Value="{Binding Playback.Preview.SourcePositionMs, Mode=TwoWay}"
                            IsEnabled="{Binding Playback.Preview.IsSourceMediaLoaded}"
                            VerticalAlignment="Center" />
                     <TextBlock Grid.Column="2"
                                Text="{Binding Playback.Preview.SourceDurationFormatted}"
                                FontSize="11" Foreground="{DynamicResource VideoOverlaySubtextBrush}"
                                VerticalAlignment="Center" TextAlignment="Right" />
                </Grid>
            </Border>

            <!-- Controls bar -->
            <Border Grid.Row="3" Padding="12,9"
                    IsVisible="{Binding Playback.Preview.IsControlsVisible}">
                <Border.Styles>
                    <!-- Dev toolbar pill style: amber tint so it's visually distinct -->
                    <Style Selector="Button.dev-pill">
                        <Setter Property="Foreground" Value="#D4A017" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="BorderBrush" Value="#3A3010" />
                        <Setter Property="BorderThickness" Value="1" />
                        <Setter Property="CornerRadius" Value="6" />
                    </Style>
                    <Style Selector="Button.dev-pill /template/ ContentPresenter">
                        <Setter Property="Background" Value="Transparent" />
                    </Style>
                    <Style Selector="Button.dev-pill:pointerover /template/ ContentPresenter">
                        <Setter Property="Background" Value="#2A2010" />
                    </Style>
                    <Style Selector="Button.dev-pill:pressed /template/ ContentPresenter">
                        <Setter Property="Background" Value="#38280A" />
                    </Style>
                </Border.Styles>

                <Grid ColumnDefinitions="Auto,*,Auto,*,Auto">

                    <!-- Left: open media + CC + dub mode toggle -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="2"
                                VerticalAlignment="Center">
                        <Button Classes="control-pill"
                                Content="📁"
                                Padding="9,7"
                                FontSize="16"
                                Background="Transparent"
                                Click="OnOpenMediaClick"
                                ToolTip.Tip="Open media"
                                AutomationProperties.Name="Open media" />
                        <Button Content="{Binding Playback.Preview.SubtitleToggleLabel}"
                                Classes="control-pill"
                                Command="{Binding Playback.Preview.ToggleSubtitlesCommand}"
                                IsEnabled="{Binding Playback.Preview.HasSegments}"
                                Padding="6,5" FontSize="14"
                                Background="Transparent"
                                ToolTip.Tip="Toggle subtitles (CC)"
                                AutomationProperties.Name="Toggle subtitles" />
                        <Button Content="{Binding Playback.Preview.DubModeLabel}"
                                Classes="control-pill"
                                Classes.active="{Binding Playback.Preview.IsDubModeOn}"
                                Command="{Binding Playback.Preview.ToggleDubModeCommand}"
                                IsEnabled="{Binding Playback.Preview.HasSegments}"
                                Padding="6,5" FontSize="14"
                                Background="Transparent"
                                ToolTip.Tip="Toggle Dub Mode"
                                AutomationProperties.Name="Toggle Dub Mode" />

                        <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center" Margin="4,0,0,0"
                                    IsVisible="{Binding Playback.Preview.IsDubModeOn}">
                            <TextBlock Text="Duck" FontSize="10" Foreground="#8A88A8" VerticalAlignment="Center" />
                            <Slider x:Name="DuckingSlider"
                                    Width="60"
                                    Orientation="Horizontal"
                                    Minimum="-30"
                                    Maximum="0"
                                    Value="{Binding Playback.Preview.AudioDuckingDb, Mode=TwoWay}"
                                    IsEnabled="{Binding Playback.Preview.IsSourceMediaLoaded}"
                                    VerticalAlignment="Center"
                                    ToolTip.Tip="Audio Ducking (dB)" />
                            <TextBlock Text="{Binding Playback.Preview.AudioDuckingLabel}"
                                       FontSize="10"
                                       Foreground="#8A88A8"
                                       VerticalAlignment="Center"
                                       Width="30" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Center: playback buttons in a unified transport capsule -->
                    <Border Grid.Column="2" Background="{DynamicResource SurfaceSubtleBrush}" CornerRadius="12" Padding="4,3"
                            VerticalAlignment="Center" HorizontalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="1">
                            <Button Classes="control-pill" Content="&#x23EE;&#xFE0E;"
                                    Command="{Binding Playback.Preview.SkipBackwardCommand}"
                                    IsEnabled="{Binding Playback.Preview.HasSegments}"
                                    Padding="8,6" FontSize="15"
                                    ToolTip.Tip="Skip to previous segment"
                                    AutomationProperties.Name="Skip to previous segment" />
                            <Button Classes="control-pill" Content="&#x23EA;&#xFE0E;"
                                    Command="{Binding Playback.Preview.RewindCommand}"
                                    IsEnabled="{Binding Playback.Preview.IsSourceMediaLoaded}"
                                    Padding="8,6" FontSize="15"
                                    ToolTip.Tip="Rewind 10 seconds"
                                    AutomationProperties.Name="Rewind 10 seconds" />
                            <Button Command="{Binding Playback.Preview.PlayPauseSourceCommand}"
                                    IsEnabled="{Binding Playback.Preview.IsSourceMediaLoaded}"
                                    Width="42" Height="42" Padding="0" Margin="3,0"
                                    CornerRadius="21" Background="{DynamicResource ButtonBackgroundBrush}"
                                    ToolTip.Tip="Play / Pause (Space)"
                                    AutomationProperties.Name="Play or pause">
                                <Button.Styles>
                                    <Style Selector="Button:pointerover /template/ ContentPresenter">
                                        <Setter Property="Background" Value="{DynamicResource ButtonHoverBrush}" />
                                    </Style>
                                    <Style Selector="Button:pressed /template/ ContentPresenter">
                                        <Setter Property="Background" Value="#252545" />
                                    </Style>
                                </Button.Styles>
                                <TextBlock Text="{Binding Playback.Preview.PlayPauseSourceLabel}"
                                           FontSize="15"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Button>
                            <Button Classes="control-pill" Content="&#x23E9;&#xFE0E;"
                                    Command="{Binding Playback.Preview.FastForwardCommand}"
                                    IsEnabled="{Binding Playback.Preview.IsSourceMediaLoaded}"
                                    Padding="8,6" FontSize="15"
                                    ToolTip.Tip="Fast forward 10 seconds"
                                    AutomationProperties.Name="Fast forward 10 seconds" />
                            <Button Classes="control-pill" Content="&#x23ED;&#xFE0E;"
                                    Command="{Binding Playback.Preview.SkipForwardCommand}"
                                    IsEnabled="{Binding Playback.Preview.HasSegments}"
                                    Padding="8,6" FontSize="15"
                                    ToolTip.Tip="Skip to next segment"
                                    AutomationProperties.Name="Skip to next segment" />
                        </StackPanel>
                    </Border>

                    <!-- Right: volume + fullscreen + settings [+ dev toolbar] -->
                    <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="2"
                                VerticalAlignment="Center" HorizontalAlignment="Right">
                        <Button Classes="control-pill" x:Name="MuteButton"
                                Content="{Binding Playback.Preview.VolumeIconLabel}"
                                Command="{Binding Playback.Preview.ToggleMuteCommand}"
                                IsEnabled="{Binding Playback.Preview.IsSourceMediaLoaded}"
                                Padding="6,5" FontSize="14"
                                ToolTip.Tip="Mute / Unmute"
                                AutomationProperties.Name="Toggle Mute" />
                        <Slider x:Name="VolumeSlider"
                                Width="80"
                                Orientation="Horizontal"
                                Minimum="0"
                                Maximum="1"
                                Value="{Binding Playback.Preview.SourceVolume, Mode=TwoWay}"
                                IsEnabled="{Binding Playback.Preview.IsSourceMediaLoaded}"
                                VerticalAlignment="Center"
                                Margin="2,0,4,0"
                                ToolTip.Tip="Volume" />

                        <Button Classes="control-pill" Content="&#x25EB;&#xFE0E;"
                                Command="{Binding Playback.Preview.ToggleSegmentPaneCommand}"
                                Padding="8,6" FontSize="14"
                                ToolTip.Tip="Toggle side panes"
                                AutomationProperties.Name="Toggle side panes" />

                        <Button Classes="control-pill" Content="&#x26F6;"
                                Command="{Binding Playback.Preview.ToggleFullscreenCommand}"
                                IsEnabled="{Binding Playback.Preview.IsSourceMediaLoaded}"
                                Padding="6,5" FontSize="14"
                                ToolTip.Tip="Toggle fullscreen"
                                AutomationProperties.Name="Toggle fullscreen" />

                        <Button Classes="control-pill" Content="&#x2699;"
                                Click="OnSettingsClick"
                                Padding="6,5" FontSize="14"
                                ToolTip.Tip="Settings"
                                AutomationProperties.Name="Settings" />

                        <!--
                            ╔══════════════════════════════╗
                            ║  DEV BUILD TOOLBAR           ║
                            ║  Visible only in Dev builds. ║
                            ╚══════════════════════════════╝
                            AXAML has no #if support, so we gate visibility at runtime via
                            the BuildInfo.IsDevBuild static.  The Click handlers in
                            MainWindow.axaml.cs are wrapped in #if BABEL_DEV so they
                            are compiled away in Release — the buttons just won't exist.
                        -->
                        <Border Margin="6,0,0,0"
                                BorderBrush="#3A3010"
                                BorderThickness="1,0,0,0"
                                Padding="6,0,0,0"
                                IsVisible="{x:Static bp:BuildInfo.IsDevBuild}">
                            <StackPanel Orientation="Horizontal" Spacing="2">
                                <Button Classes="dev-pill"
                                        x:Name="DevLogButton"
                                        Content="📋 Dev Log"
                                        Padding="6,5" FontSize="12"
                                        ToolTip.Tip="Open in-app dev log viewer" />
                                <Button Classes="dev-pill"
                                        x:Name="FreshStartButton"
                                        Content="🔄 Fresh Start"
                                        Padding="6,5" FontSize="12"
                                        ToolTip.Tip="Cancel pipeline, wipe session temp files, reset UI" />
                            </StackPanel>
                        </Border>

                    </StackPanel>

                </Grid>
            </Border>

        </Grid>

        <!-- ═══════════════════════════════════════════════════
             RIGHT PANEL: Segments
             ═══════════════════════════════════════════════════ -->
        <Border Grid.Row="1" Grid.Column="2" Background="{DynamicResource PanelBackgroundBrush}"
                Classes="right-pane"
                Classes.collapsed="{Binding !Playback.Preview.IsSegmentPaneVisible}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,0,0"
                >
            <Grid RowDefinitions="Auto,*,Auto">

                <!-- Header -->
                <Border Grid.Row="0" Padding="14,11"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                    <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="6">
                        <TextBlock Grid.Column="0" Text="Segments" FontSize="14"
                                   FontWeight="SemiBold" Foreground="#F0F0F8"
                                   VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" FontSize="11" Foreground="#565672"
                                    VerticalAlignment="Center" Margin="0,0,10,0"
                                    Text="{Binding Playback.Preview.Segments.Count, StringFormat='{}{0} Items'}" />

                        <Button Grid.Column="2"
                                Click="OnExportCaptionsClick"
                                Padding="7,3"
                                FontSize="11"
                                Background="#2A2A3C"
                                Foreground="#C0C0D0"
                                CornerRadius="4"
                                ToolTip.Tip="Export captions as SRT">
                            <TextBlock Text="Export" />
                        </Button>

                        <Button Grid.Column="3"
                                Command="{Binding Playback.Preview.RefreshSegmentsCommand}"
                                Background="Transparent" Padding="6,2"
                                Foreground="#A0A0B0" ToolTip.Tip="Refresh segments data">
                            <TextBlock Text="↻" FontSize="16" />
                            <Button.Styles>
                                <Style Selector="Button:pointerover /template/ ContentPresenter">
                                    <Setter Property="Background" Value="#2A2A3A" />
                                    <Setter Property="Foreground" Value="#F0F0F8" />
                                </Style>
                            </Button.Styles>
                        </Button>

                    </Grid>
                </Border>

                <Panel Grid.Row="1">
                <!-- Segment list -->
                <ListBox Grid.Row="1" x:Name="SegmentList"
                         ItemsSource="{Binding Playback.Preview.Segments}"
                         SelectedItem="{Binding Playback.Preview.SelectedSegment}"
                         Background="Transparent"
                         BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.Styles>
                        <Style Selector="ListBoxItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Background" Value="Transparent" />
                        </Style>
                        <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                            <Setter Property="Background" Value="{DynamicResource SegmentSelectedBrush}" />
                        </Style>
                        <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
                            <Setter Property="Background" Value="{DynamicResource SegmentPointerOverBrush}" />
                        </Style>
                    </ListBox.Styles>
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="models:WorkflowSegmentState">
                            <Border Padding="14,10" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                                <Grid ColumnDefinitions="*,12">

                                    <StackPanel Grid.Column="0" Spacing="3">
                                        <!-- Time range -->
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Border Background="{Binding SpeakerId, Converter={StaticResource SpeakerIdToColorConverter}}"
                                                    CornerRadius="999"
                                                    Padding="7,2"
                                                    VerticalAlignment="Center"
                                                    IsVisible="{Binding SpeakerId, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                                <TextBlock Text="{Binding SpeakerId, Converter={StaticResource SpeakerIdToShortLabelConverter}}"
                                                           FontSize="10"
                                                           FontWeight="SemiBold"
                                                           Foreground="White"
                                                           VerticalAlignment="Center" />
                                            </Border>
                                            <TextBlock FontSize="11"
                                                       Foreground="{DynamicResource StatusTextBrush}"
                                                       VerticalAlignment="Center">
                                                <TextBlock.Text>
                                                    <MultiBinding StringFormat="{}{0:F1}s  —  {1:F1}s">
                                                        <Binding Path="StartSeconds" />
                                                        <Binding Path="EndSeconds" />
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>
                                        </StackPanel>
                                        <!-- Original text -->
                                        <TextBlock Text="{Binding SourceText}"
                                                   FontSize="12" Foreground="{DynamicResource StatusTextBrush}"
                                                   TextWrapping="Wrap" />
                                        <!-- Translated text -->
                                        <TextBlock Text="{Binding TranslatedText}"
                                                   FontSize="13" Foreground="{DynamicResource PrimaryTextBrush}"
                                                   FontWeight="Medium"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>

                                    <!-- Status indicator column -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Top"
                                                Margin="0,4,0,0" Spacing="4">
                                        <!-- Green dot: TTS audio ready -->
                                        <Ellipse Width="8" Height="8"
                                                 Fill="#22C55E"
                                                 IsVisible="{Binding HasTtsAudio}"
                                                 HorizontalAlignment="Center" />
                                        <!-- Orange bar: translation present, no TTS yet -->
                                        <Rectangle Width="4" Height="16"
                                                   Fill="#F59E0B"
                                                   RadiusX="2" RadiusY="2"
                                                   IsVisible="{Binding HasTranslation}"
                                                   HorizontalAlignment="Center" />
                                    </StackPanel>

                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel IsVisible="{Binding !Playback.Preview.HasSegments}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="4">
                    <TextBlock Text="No segments yet" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    <TextBlock Text="Open media and run the pipeline to generate segments."
                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                               HorizontalAlignment="Center" />
                </StackPanel>
                </Panel>

                <!-- Segment inspection panel (row 2) — shown when a segment with TTS audio is selected -->
                <Border Grid.Row="2"
                        IsVisible="{Binding Inspection.IsVisible}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0"
                        Padding="14,10">
                    <StackPanel Spacing="6">

                        <TextBlock Text="Segment timing" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource StatusTextBrush}"/>

                        <TextBlock Text="{Binding Inspection.TimingLabel}"
                                   FontSize="11" Foreground="{DynamicResource StatusTextBrush}"/>

                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,2,0,0">
                            <StackPanel.Styles>
                                <Style Selector="Button.segmentTimingButton">
                                    <Setter Property="Padding" Value="8,3"/>
                                    <Setter Property="FontSize" Value="11"/>
                                    <Setter Property="CornerRadius" Value="4"/>
                                    <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource StatusTextBrush}"/>
                                </Style>
                            </StackPanel.Styles>
                            <!-- Inherit = clear override -->
                            <Button Classes="segmentTimingButton"
                                    Content="Inherit"
                                    Command="{Binding Inspection.SetTimingOverrideCommand}"
                                    CommandParameter="{x:Null}"
                                    ToolTip.Tip="Use session default timing mode"/>
                            <Button Classes="segmentTimingButton"
                                    Content="Stretch"
                                    Command="{Binding Inspection.SetTimingOverrideCommand}"
                                    CommandParameter="{x:Static models:SegmentTimingMode.Stretch}"
                                    ToolTip.Tip="Time-stretch TTS to fit the segment window"/>
                            <Button Classes="segmentTimingButton"
                                    Content="Pause"
                                    Command="{Binding Inspection.SetTimingOverrideCommand}"
                                    CommandParameter="{x:Static models:SegmentTimingMode.Pause}"
                                    ToolTip.Tip="Pause source video while TTS plays, then resume"/>
                        </StackPanel>

                        <TextBlock Text="{Binding Inspection.TimingOverrideLabel}"
                                   FontSize="10" Foreground="{DynamicResource StatusTextBrush}"
                                   Opacity="0.7"/>

                    </StackPanel>
                </Border>

            </Grid>
        </Border>

    </Grid>

</Window>
