<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Configurations>Debug;Release;Dev</Configurations>
    <ApplicationIcon>Assets\Icons\app.ico</ApplicationIcon>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <AssemblyName>BabelPlayer</AssemblyName>
    <RootNamespace>Babel.Player</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TieredPGO>true</TieredPGO>
    <!-- Fallback for local dev builds; overridden by -p:BuildDate=... in the release workflow -->
    <BuildDate Condition="'$(BuildDate)' == ''">0000-00-00</BuildDate>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <DefineConstants>DEBUG;TRACE</DefineConstants>
    <Optimize>false</Optimize>
    <DebugType>portable</DebugType>
    <DebugSymbols>true</DebugSymbols>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <DefineConstants>DEBUG;TRACE</DefineConstants>
    <Optimize>false</Optimize>
    <DebugType>portable</DebugType>
    <DebugSymbols>true</DebugSymbols>
  </PropertyGroup>

  <!-- ═══════════════════════════════════════════════════════════════
       Dev configuration — build with: dotnet run -c Dev
       Defines BABEL_DEV, disables optimisations, keeps full debug info.
       ═══════════════════════════════════════════════════════════════ -->
  <PropertyGroup Condition="'$(Configuration)' == 'Dev'">
    <DefineConstants>DEBUG;TRACE;BABEL_DEV</DefineConstants>
    <Optimize>false</Optimize>
    <DebugType>portable</DebugType>
    <DebugSymbols>true</DebugSymbols>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DefineConstants>TRACE</DefineConstants>
    <Optimize>true</Optimize>
    <DebugType>portable</DebugType>
    <DebugSymbols>true</DebugSymbols>
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <Optimize>true</Optimize>
    <DebugType>portable</DebugType>
    <DebugSymbols>true</DebugSymbols>
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
  </PropertyGroup>

  <ItemGroup>
    <Folder Include="Models\" />
    <AvaloniaResource Include="Assets\**" />
    <AvaloniaResource Include="Styles\**" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="BabelPlayer\**" />
    <Compile Remove="BabelPlayer.Tests\**" />
    <EmbeddedResource Remove="BabelPlayer\**" />
    <None Remove="BabelPlayer\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.0.1" />
    <PackageReference Include="Avalonia.Desktop" Version="12.0.1" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.0.1" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.0.1" />
    <PackageReference Include="System.Reactive" Version="6.1.0" />
    <!-- Override Avalonia.FreeDesktop's vulnerable transitive D-Bus dependency. -->
    <PackageReference Include="Tmds.DBus.Protocol" Version="0.92.0" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.0-beta3" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.5" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>BabelPlayer.Tests</_Parameter1>
    </AssemblyAttribute>
    <!-- Bake the build date into the assembly so BuildInfo.cs can read it at runtime -->
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>BuildDate</_Parameter1>
      <_Parameter2>$(BuildDate)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

<ItemGroup Condition="Exists('tools\$(BabelWinNativeSubdir)\ffmpeg.exe')">
  <None Include="tools\$(BabelWinNativeSubdir)\ffmpeg.exe">
    <Link>tools\$(BabelWinNativeSubdir)\ffmpeg.exe</Link>
    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
  </None>
</ItemGroup>

  <!-- Staged after optional FetchWinNativeDepsIfNeeded (Directory.Build.targets) so a single build picks up freshly downloaded files. Uses $(BabelWinNativeSubdir) (win-x64 vs win-arm64) from Directory.Build.targets. -->
  <Target Name="IncludeBabelWinNativeArtifacts" BeforeTargets="AssignTargetPaths" AfterTargets="FetchWinNativeDepsIfNeeded" Condition="'$(OS)' == 'Windows_NT'">
    <ItemGroup Condition="Exists('$(MSBuildProjectDirectory)\native\$(BabelWinNativeSubdir)\libmpv-2.dll')">
      <None Include="$(MSBuildProjectDirectory)\native\$(BabelWinNativeSubdir)\libmpv-2.dll">
        <Link>native\$(BabelWinNativeSubdir)\libmpv-2.dll</Link>
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </None>
    </ItemGroup>
    <ItemGroup Condition="Exists('$(MSBuildProjectDirectory)\tools\$(BabelWinNativeSubdir)\uv.exe')">
      <None Include="$(MSBuildProjectDirectory)\tools\$(BabelWinNativeSubdir)\uv.exe">
        <Link>tools\$(BabelWinNativeSubdir)\uv.exe</Link>
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </None>
    </ItemGroup>
  </Target>

  <Target Name="StripReleaseSymbolsFromPublish"
          AfterTargets="ComputeResolvedFilesToPublishList"
          Condition="'$(Configuration)' == 'Release'">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
                             Condition="'%(ResolvedFileToPublish.Extension)' == '.pdb'" />
    </ItemGroup>
  </Target>

  <Target Name="DeletePublishedReleaseSymbols"
          AfterTargets="CopyFilesToPublishDirectory"
          Condition="'$(Configuration)' == 'Release'">
    <ItemGroup>
      <_PublishedReleaseSymbols Include="$(PublishDir)**\*.pdb" />
    </ItemGroup>
    <Delete Files="@(_PublishedReleaseSymbols)" />
  </Target>

<ItemGroup>
  <None Include="docker-compose.yml">
    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
  </None>
  <None Include="inference\**\*" Exclude="inference\__pycache__\**;inference\*.pyc">
    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
  </None>
</ItemGroup>

  <Target Name="DeletePublishedReleaseSymbols" AfterTargets="CopyFilesToPublishDirectory" Condition="'$(Configuration)' == 'Release' and '$(PublishDir)' != ''">
    <ItemGroup>
      <ReleasePublishSymbols Include="$(PublishDir)**\*.pdb" />
    </ItemGroup>
    <Delete Files="@(ReleasePublishSymbols)" TreatErrorsAsWarnings="true" />
  </Target>
</Project>
