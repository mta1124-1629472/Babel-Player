<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <!--
      dotnet-libraries is a public Azure Artifacts feed providing nightly builds
      of dotnet/* packages. Required because Microsoft.ML.Tokenizers 3.x has not
      shipped as a stable NuGet.org release. Once a stable 3.x appears on
      nuget.org, remove this feed and re-pin. Same source TrackDub uses.
    -->
    <add key="dotnet-libraries" value="https://pkgs.dev.azure.com/dnceng/public/_packaging/dotnet-libraries/nuget/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
