{
  "name": "Babel Player Linux Agent",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "postCreateCommand": "dotnet --info && python3 --version",
  "postStartCommand": "if [ \"${RUN_FULL_DEVCONTAINER_VERIFY:-0}\" = \"1\" ]; then bash scripts/verify-linux-agent.sh; fi",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-dotnettools.csharp",
        "ms-python.python"
      ]
    }
  }
}
